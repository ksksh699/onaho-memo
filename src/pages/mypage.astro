              </div>
            </div>
            <div class="profile-details-body">
              ${currentBio ? `<p class="profile-bio">${currentBio}</p>` : `<p class="badge-empty">自己紹介はまだ設定されていません。</p>`}
              ${linksHtml}
              <p class="profile-visibility">公開設定: <strong>${currentIsPublic ? '公開中' : '非公開'}</strong></p>
              <button id="edit-profile-details-btn" class="best-one-clear-btn">プロフィールを編集する</button>
            </div>
          </div>
        `;
      }

      function profileDetailsEditHtml() {
        const snsRows = editingSnsLinks.map((l, i) => snsRowHtml(l, i)).join('');

        return `
          <div class="profile-details-edit">
            <label class="profile-edit-label">アイコン画像(トプ画)</label>
            ${currentAvatarUrl ? `<img class="profile-details-preview" src="${currentAvatarUrl}" alt="現在のアイコン" />` : ''}
            <input type="file" id="profile-avatar-input" accept="image/*" />

            <label class="profile-edit-label">ヘッダー画像(壁紙)</label>
            ${currentHeaderUrl ? `<img class="profile-details-preview profile-details-preview-header" src="${currentHeaderUrl}" alt="現在のヘッダー" />` : ''}
            <input type="file" id="profile-header-input" accept="image/*" />

            <label class="profile-edit-label">自己紹介</label>
            <textarea id="profile-bio-input" class="nickname-input" maxlength="300" rows="4" placeholder="自己紹介を書きましょう">${currentBio ?? ''}</textarea>

            <label class="profile-edit-label">SNS・ブログリンク</label>
            <div id="profile-sns-list">${snsRows}</div>
            <button type="button" id="profile-sns-add-btn" class="best-one-clear-btn">+ リンクを追加</button>

            <label class="profile-edit-label">
              <input type="checkbox" id="profile-public-input" ${currentIsPublic ? 'checked' : ''} />
              プロフィールを公開する(オフにすると公開ページが完全に非表示になります)
            </label>

            <div class="profile-details-actions">
              <button id="save-profile-details-btn" class="btn-primary">保存する</button>
              <button id="cancel-profile-details-btn" class="best-one-clear-btn">キャンセル</button>
            </div>
            <p id="profile-details-status" class="nickname-status"></p>
          </div>
        `;
      }

      function renderProfileDetailsSection() {
        if (!profileDetailsEditing) {
          profileDetailsContainer.innerHTML = profileDetailsSectionHtml();
          return;
        }
        editingSnsLinks = currentSnsLinks.length
          ? currentSnsLinks.map((l) => ({ ...l }))
          : [{ label: '', url: '' }];
        profileDetailsContainer.innerHTML = profileDetailsEditHtml();
      }

      async function uploadProfileImage(file, prefix, userId, compressOptions) {
        const compressedFile = await compressImage(file, compressOptions);
        const ext = compressedFile.name.split('.').pop() || 'jpg';
        const path = `${userId}/${prefix}-${Date.now()}.${ext}`;
        const { error: uploadError } = await supabase.storage
          .from(PROFILE_IMAGE_BUCKET)
          .upload(path, compressedFile, { upsert: true });
        if (uploadError) {
          console.error(uploadError);
          return null;
        }
        const { data } = supabase.storage.from(PROFILE_IMAGE_BUCKET).getPublicUrl(path);
        return data.publicUrl;
      }

      async function saveProfileDetails() {
        const {
          data: { session },
        } = await supabase.auth.getSession();
        if (!session) return;

        const statusEl = document.getElementById('profile-details-status');
        statusEl.textContent = '保存中...';

        const avatarFile = document.getElementById('profile-avatar-input').files[0];
        const headerFile = document.getElementById('profile-header-input').files[0];
        const bio = document.getElementById('profile-bio-input').value.trim();
        const isPublic = document.getElementById('profile-public-input').checked;

        const rows = [...document.querySelectorAll('#profile-sns-list .profile-sns-row')];
        const snsLinks = rows
          .map((row) => ({
            label: row.querySelector('.profile-sns-label').value.trim(),
            url: row.querySelector('.profile-sns-url').value.trim(),
          }))
          .filter((l) => l.url);

        let avatarUrl = currentAvatarUrl;
        if (avatarFile) {
          const uploaded = await uploadProfileImage(avatarFile, 'avatar', session.user.id, {
            maxWidth: 500,
            maxHeight: 500,
            quality: 0.85,
          });
          if (!uploaded) {
            statusEl.textContent = 'アイコン画像のアップロードに失敗しました';
            return;
          }
          avatarUrl = uploaded;
        }

        let headerUrl = currentHeaderUrl;
        if (headerFile) {
          const uploaded = await uploadProfileImage(headerFile, 'header', session.user.id, {
            maxWidth: 1600,
            maxHeight: 800,
            quality: 0.8,
          });
          if (!uploaded) {
            statusEl.textContent = 'ヘッダー画像のアップロードに失敗しました';
            return;
          }
          headerUrl = uploaded;
        }

        const { error } = await supabase
          .from('profiles')
          .update({
            avatar_url: avatarUrl,
            header_url: headerUrl,
            bio: bio || null,
            sns_links: snsLinks,
            is_public: isPublic,
          })
          .eq('id', session.user.id);

        if (error) {
          console.error(error);
          statusEl.textContent = '保存に失敗しました';
          return;
        }

        currentAvatarUrl = avatarUrl;
        currentHeaderUrl = headerUrl;
        currentBio = bio || null;
        currentSnsLinks = snsLinks;
        currentIsPublic = isPublic;
        profileDetailsEditing = false;
        renderProfileDetailsSection();
      }

      function buildCardMeta(check) {
        const p = check.products;
        if (!p) return null;

        const top3Idx = currentTop3.findIndex((s) => s && s.productId === p.id);
        const isTop3 = check.status === 'used' && top3Idx >= 0;
        const top3Full = currentTop3.filter(Boolean).length >= 3;
        const hasReview = Boolean(check.review_text || check.detail_review_text);
        const isBestReview = hasReview && p.id === currentBestReviewProductId;
        const onSale = isOnSale(check);
        const listPrice = onSale ? Number(p.raw_data.prices.list_price) : null;
        const discountPercent = onSale ? Math.round((1 - p.price / listPrice) * 100) : null;

        let subInfo = '';
        if (check.status === 'used' && check.tier) {
          subInfo += `<span class="mp-tag">${TIER_LABELS[check.tier]}</span>`;
        }
        if (check.rating) {
          subInfo += `<span class="mp-tag">★${check.rating}</span>`;
        }
        if (check.is_public) {
          subInfo += `<span class="mp-tag mp-public">公開中</span>`;
        }
        if (isTop3) {
          subInfo += `<span class="mp-tag mp-best">TOP3: ${top3Idx + 1}位</span>`;
        }
        if (isBestReview) {
          subInfo += `<span class="mp-tag mp-best">ベスト口コミ</span>`;
        }

        let actions = '';
        if (check.status === 'used') {
          if (isTop3) {
            actions += `<button class="top3-set-btn" data-product-id="${p.id}">TOP3(${top3Idx + 1}位)を解除</button>`;
          } else if (top3Full) {
            actions += `<button class="top3-set-btn" data-product-id="${p.id}" disabled>TOP3は3つまでです</button>`;
          } else {
            actions += `<button class="top3-set-btn" data-product-id="${p.id}">TOP3に追加</button>`;
          }
        }
        if (hasReview) {
          actions += `<button class="best-review-set-btn" data-product-id="${p.id}">${isBestReview ? 'ベスト口コミを解除' : 'ベスト口コミに設定'}</button>`;
        }

        return { p, isTop3, onSale, discountPercent, subInfo, actions };
      }

      function productCardHtml(check) {
        const meta = buildCardMeta(check);
        if (!meta) return '';
        const { p, isTop3, onSale, discountPercent, subInfo, actions } = meta;

        return `
          <li class="mp-card ${isTop3 ? 'mp-card-best' : ''}">
            ${onSale ? '<span class="sale-ribbon">SALE</span>' : ''}
            <a href="/products/${p.dmm_content_id}/">
              <img src="${p.image_url}" alt="${p.name}" loading="lazy" />
              <div class="mp-card-body">
                <p class="mp-maker">${p.maker ?? ''}</p>
                <h3>${p.name}</h3>
                <p class="mp-price">
                  ${p.price ? `¥${p.price.toLocaleString()}` : ''}
                  ${onSale ? `<span class="discount-badge-small">${discountPercent}%OFF</span>` : ''}
                </p>
                <div class="mp-tags">${subInfo}</div>
                ${check.memo ? `<p class="mp-memo">${check.memo}</p>` : ''}
              </div>
            </a>
            ${actions ? `<div class="mp-card-actions">${actions}</div>` : ''}
          </li>
        `;
      }

      function productRowHtml(check) {
        const meta = buildCardMeta(check);
        if (!meta) return '';
        const { p, isTop3, onSale, discountPercent, subInfo, actions } = meta;

        return `
          <li class="mp-row ${isTop3 ? 'mp-row-best' : ''}">
            <a href="/products/${p.dmm_content_id}/" class="mp-row-link">
              <img src="${p.image_url}" alt="${p.name}" loading="lazy" />
              <div class="mp-row-body">
                <h3>${p.name}</h3>
                <p class="mp-price">
                  ${p.price ? `¥${p.price.toLocaleString()}` : ''}
                  ${onSale ? `<span class="discount-badge-small">${discountPercent}%OFF</span>` : ''}
                </p>
                <div class="mp-tags">${subInfo}</div>
                ${check.memo ? `<p class="mp-memo">${check.memo}</p>` : ''}
              </div>
            </a>
            ${actions ? `<div class="mp-row-actions">${actions}</div>` : ''}
          </li>
        `;
      }

      function renderProductLists() {
        const grouped = { used: [], interested: [] };
        for (const c of lastChecks) {
          if (grouped[c.status]) grouped[c.status].push(c);
        }

        const usedByTier = { first: [], second: [], retired: [] };
        for (const c of grouped.used) {
          if (c.tier && usedByTier[c.tier]) usedByTier[c.tier].push(c);
        }

        const saleInterestedCount = grouped.interested.filter(isOnSale).length;
        const totalSpent = grouped.used.reduce((sum, c) => sum + (c.products?.price ?? 0), 0);

        let html = `
          <div class="mp-stats">
            <div class="mp-stat"><span class="mp-stat-num">${grouped.used.length}</span><span>使った</span></div>
            <div class="mp-stat"><span class="mp-stat-num">${usedByTier.first.length}</span><span>一軍</span></div>
            <div class="mp-stat"><span class="mp-stat-num">${grouped.interested.length}</span><span>気になる</span></div>
            <div class="mp-stat"><span class="mp-stat-num">${saleInterestedCount}</span><span>気になるでセール中</span></div>
            <div class="mp-stat mp-stat-wide"><span class="mp-stat-num">¥${totalSpent.toLocaleString()}</span><span>使った商品の合計金額</span></div>
          </div>
          <div class="mp-view-toggle">
            <button type="button" class="mp-view-btn ${currentViewMode === 'grid' ? 'active' : ''}" data-view="grid">▦ グリッド表示</button>
            <button type="button" class="mp-view-btn ${currentViewMode === 'list' ? 'active' : ''}" data-view="list">☰ リスト表示</button>
          </div>
        `;

        const renderItem = currentViewMode === 'list' ? productRowHtml : productCardHtml;
        const listTag = currentViewMode === 'list' ? 'mp-list' : 'mp-grid';

        for (const status of STATUS_ORDER) {
          const list = grouped[status];
          if (list.length === 0) continue;

          html += `<h2 class="mp-section-title">${STATUS_LABELS[status]}(${list.length})</h2>`;
          html += `<ul class="${listTag}">${list.map(renderItem).join('')}</ul>`;
        }

        content.innerHTML = html;
      }

      async function init() {
        const { data: { session } } = await supabase.auth.getSession();

        if (!session) {
          renderLoggedOut();
          return;
        }

        const profile = await renderProfileSection(session.user.id);
        const hasNickname = Boolean(profile?.nickname);

        currentTop3 = [
          profile?.best_product_id_1
            ? { productId: profile.best_product_id_1, reason: profile.best_product_reason_1 }
            : null,
          profile?.best_product_id_2
            ? { productId: profile.best_product_id_2, reason: profile.best_product_reason_2 }
            : null,
          profile?.best_product_id_3
            ? { productId: profile.best_product_id_3, reason: profile.best_product_reason_3 }
            : null,
        ];
        currentBestReviewProductId = profile?.best_review_product_id ?? null;
        currentOshiMaker = profile?.oshi_maker ?? null;
        currentOshiMakerReason = profile?.oshi_maker_reason ?? null;
        currentAvatarUrl = profile?.avatar_url ?? null;
        currentHeaderUrl = profile?.header_url ?? null;
        currentBio = profile?.bio ?? null;
        currentSnsLinks = Array.isArray(profile?.sns_links) ? profile.sns_links : [];
        currentIsPublic = profile?.is_public ?? true;
        profileDetailsEditing = false;
        renderProfileDetailsSection();

        const { data: checks, error } = await supabase
          .from('checks')
          .select(
            'status, tier, rating, review_title, review_text, detail_review_title, detail_review_text, review_images, retirement_reason, similar_products, memo, is_public, updated_at, products(id, dmm_content_id, name, maker, price, image_url, genre_tags, raw_data)'
          )
          .eq('user_id', session.user.id)
          .order('updated_at', { ascending: false });

        if (error) {
          content.innerHTML = `<p>読み込みに失敗しました: ${error.message}</p>`;
          return;
        }

        lastChecks = checks ?? [];

        top3EditingRank = null;
        renderTop3Section();

        const bestReviewCheck = lastChecks.find((c) => c.products?.id === currentBestReviewProductId) ?? null;
        bestReviewContainer.innerHTML = bestReviewSectionHtml(bestReviewCheck);

        oshiMakerEditing = false;
        renderOshiMakerSection();

        await renderFoldersSection(session.user.id);
        await renderOnakingLinksSection();
        await renderManualProductSection();

        const usedCountForBadge = lastChecks.filter((c) => c.status === 'used').length;
        document.getElementById('badge-section-container').innerHTML = badgeSectionHtml(usedCountForBadge);
        document.getElementById('maker-badge-section-container').innerHTML = makerBadgeSectionHtml(
          lastChecks
        );
        document.getElementById('titles-section-container').innerHTML = titlesSectionHtml(
          lastChecks,
          hasNickname
        );

        if (lastChecks.length === 0) {
          content.innerHTML = `<p class="mp-empty">まだ記録がありません。気になる商品を見つけたら「☰ 記録」から登録してみましょう。</p>`;
          return;
        }

        renderProductLists();
      }

      content.addEventListener('click', (e) => {
        const top3Btn = e.target.closest('.top3-set-btn');
        if (top3Btn && !top3Btn.disabled) {
          e.preventDefault();
          toggleTop3(top3Btn.dataset.productId);
          return;
        }

        const reviewBtn = e.target.closest('.best-review-set-btn');
        if (reviewBtn) {
          e.preventDefault();
          toggleBestReview(reviewBtn.dataset.productId);
          return;
        }

        const viewBtn = e.target.closest('.mp-view-btn');
        if (viewBtn) {
          currentViewMode = viewBtn.dataset.view;
          try {
            localStorage.setItem('onahole_view_mode', currentViewMode);
          } catch (err) {}
          renderProductLists();
        }
      });

      top3Container.addEventListener('click', async (e) => {
        const reasonTextEl = e.target.closest('.top3-reason-text');
        if (reasonTextEl) {
          top3EditingRank = Number(reasonTextEl.dataset.rank);
          renderTop3Section();
          return;
        }

        const saveBtn = e.target.closest('.top3-reason-save-btn');
        if (saveBtn) {
          const rank = Number(saveBtn.dataset.rank);
          const input = top3Container.querySelector(`.top3-reason-input[data-rank="${rank}"]`);
          const value = input ? input.value.trim() : '';
          if (currentTop3[rank - 1]) currentTop3[rank - 1].reason = value || null;
          top3EditingRank = null;
          await saveTop3();
          init();
          return;
        }

        const clearBtn = e.target.closest('.top3-clear-btn');
        if (clearBtn) {
          const rank = Number(clearBtn.dataset.rank);
          currentTop3[rank - 1] = null;
          await saveTop3();
          init();
        }
      });

      bestReviewContainer.addEventListener('click', (e) => {
        const btn = e.target.closest('#clear-best-review-btn');
        if (!btn) return;
        e.preventDefault();
        toggleBestReview(currentBestReviewProductId);
      });

      oshiMakerContainer.addEventListener('click', async (e) => {
        if (e.target.closest('#edit-oshi-maker-btn')) {
          oshiMakerEditing = true;
          await renderOshiMakerSection();
          return;
        }
        if (e.target.closest('#cancel-oshi-maker-btn')) {
          oshiMakerEditing = false;
          renderOshiMakerSection();
          return;
        }
        if (e.target.closest('#save-oshi-maker-btn')) {
          const maker = document.getElementById('oshi-maker-input').value.trim();
          const reason = document.getElementById('oshi-maker-reason-input').value.trim();
          await saveOshiMaker(maker, reason);
        }
      });

      profileDetailsContainer.addEventListener('click', async (e) => {
        if (e.target.closest('#edit-profile-details-btn')) {
          profileDetailsEditing = true;
          renderProfileDetailsSection();
          return;
        }
        if (e.target.closest('#cancel-profile-details-btn')) {
          profileDetailsEditing = false;
          renderProfileDetailsSection();
          return;
        }
        if (e.target.closest('#profile-sns-add-btn')) {
          const rows = [...document.querySelectorAll('#profile-sns-list .profile-sns-row')];
          editingSnsLinks = rows.map((row) => ({
            label: row.querySelector('.profile-sns-label').value,
            url: row.querySelector('.profile-sns-url').value,
          }));
          editingSnsLinks.push({ label: '', url: '' });
          document.getElementById('profile-sns-list').innerHTML = editingSnsLinks
            .map((l, i) => snsRowHtml(l, i))
            .join('');
          return;
        }
        const removeBtn = e.target.closest('.profile-sns-remove-btn');
        if (removeBtn) {
          const rows = [...document.querySelectorAll('#profile-sns-list .profile-sns-row')];
          editingSnsLinks = rows
            .map((row) => ({
              label: row.querySelector('.profile-sns-label').value,
              url: row.querySelector('.profile-sns-url').value,
            }))
            .filter((_, i) => i !== Number(removeBtn.dataset.idx));
          if (editingSnsLinks.length === 0) editingSnsLinks.push({ label: '', url: '' });
          document.getElementById('profile-sns-list').innerHTML = editingSnsLinks
            .map((l, i) => snsRowHtml(l, i))
            .join('');
          return;
        }
        if (e.target.closest('#save-profile-details-btn')) {
          await saveProfileDetails();
        }
      });

      init();
    </script>
  </body>
</html>
