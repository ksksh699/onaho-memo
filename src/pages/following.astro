---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#2b5fad" />
    <title>フォロー・フォロワー | オナホめも</title>
  </head>
  <body>
    <SiteHeader />
    <main class="mypage-main">
      <h1 class="mypage-title">フォロー・フォロワー</h1>

      <div id="following-app">
        <div class="mp-main-tabs" id="following-tabs" role="tablist">
          <button type="button" class="mp-main-tab" data-main-tab="timeline" role="tab">タイムライン</button>
          <button type="button" class="mp-main-tab" data-main-tab="follows" role="tab">フォロー</button>
          <button type="button" class="mp-main-tab" data-main-tab="followers" role="tab">フォロワー</button>
        </div>

        <div class="mp-main-panel" data-main-panel="timeline">
          <p class="mp-empty">
            タイムラインは近日公開予定です。フォロー中のユーザーの「使った」登録やレビュー投稿、マイベストTOP3の変更などが、ここに新着順で表示されるようになります。
          </p>
        </div>

        <div class="mp-main-panel" data-main-panel="follows">
          <div id="follows-content"><p class="mypage-loading">読み込み中...</p></div>
        </div>

        <div class="mp-main-panel" data-main-panel="followers">
          <div id="followers-content"><p class="mypage-loading">読み込み中...</p></div>
        </div>
      </div>
    </main>

    <script>
      import { supabase } from '../lib/supabase.js';

      const TAB_KEY = 'onahole_following_main_tab';
      const TAB_KEYS = ['timeline', 'follows', 'followers'];

      const app = document.getElementById('following-app');
      const tabsNav = document.getElementById('following-tabs');
      const panels = document.querySelectorAll('#following-app .mp-main-panel');

      let currentSession = null;
      let currentTab = 'follows';
      let followersLoaded = false;

      try {
        const saved = localStorage.getItem(TAB_KEY);
        if (TAB_KEYS.includes(saved)) currentTab = saved;
      } catch (e) {}

      function personRowHtml(profile, { isFollowing }) {
        const bio = profile.oshi_maker ? `推し: ${profile.oshi_maker}` : profile.bio || '';
        const avatarHtml = profile.avatar_url
          ? `<img class="people-avatar" src="${profile.avatar_url}" alt="" loading="lazy" />`
          : `<div class="people-avatar people-avatar-empty"></div>`;
        const href = `/users/${encodeURIComponent(profile.nickname)}`;

        return `
          <li class="people-row">
            <a href="${href}" class="people-avatar-link">${avatarHtml}</a>
            <a href="${href}" class="people-info">
              <span class="people-name">${profile.nickname}</span>
              ${bio ? `<span class="people-bio">${bio}</span>` : ''}
            </a>
            <button type="button" class="follow-btn people-action ${isFollowing ? 'following' : ''}" data-user-id="${profile.id}">
              ${isFollowing ? 'フォロー中' : 'フォローする'}
            </button>
          </li>
        `;
      }

      async function loadFollows(session) {
        const container = document.getElementById('follows-content');
        const { data: rows, error } = await supabase
          .from('follows')
          .select('followee_id')
          .eq('follower_id', session.user.id);

        if (error) {
          container.innerHTML = `<p>読み込みに失敗しました: ${error.message}</p>`;
          return;
        }

        const ids = (rows ?? []).map((r) => r.followee_id);
        if (ids.length === 0) {
          container.innerHTML = `
            <p class="mp-empty">まだ誰もフォローしていません。ユーザーの公開プロフィールページの「フォローする」ボタンからフォローできます。</p>
          `;
          return;
        }

        const { data: profiles } = await supabase
          .from('profiles')
          .select('id, nickname, avatar_url, oshi_maker, bio')
          .in('id', ids);

        const html = (profiles ?? []).map((p) => personRowHtml(p, { isFollowing: true })).join('');
        container.innerHTML = `<ul class="people-list">${html}</ul>`;
      }

      async function loadFollowers(session) {
        const container = document.getElementById('followers-content');
        const { data: rows, error } = await supabase
          .from('follows')
          .select('follower_id')
          .eq('followee_id', session.user.id);

        if (error) {
          container.innerHTML = `<p>読み込みに失敗しました: ${error.message}</p>`;
          return;
        }

        const ids = (rows ?? []).map((r) => r.follower_id);
        if (ids.length === 0) {
          container.innerHTML = `<p class="mp-empty">まだフォロワーがいません。</p>`;
          return;
        }

        const [{ data: profiles }, { data: myFollowRows }] = await Promise.all([
          supabase.from('profiles').select('id, nickname, avatar_url, oshi_maker, bio').in('id', ids),
          supabase.from('follows').select('followee_id').eq('follower_id', session.user.id).in('followee_id', ids),
        ]);

        const followingSet = new Set((myFollowRows ?? []).map((r) => r.followee_id));
        const html = (profiles ?? [])
          .map((p) => personRowHtml(p, { isFollowing: followingSet.has(p.id) }))
          .join('');
        container.innerHTML = `<ul class="people-list">${html}</ul>`;
      }

      function applyTab(tab) {
        currentTab = tab;
        tabsNav.querySelectorAll('.mp-main-tab').forEach((btn) => {
          const active = btn.dataset.mainTab === tab;
          btn.classList.toggle('mp-main-tab-active', active);
          btn.setAttribute('aria-selected', active ? 'true' : 'false');
        });
        panels.forEach((panel) => {
          panel.hidden = panel.dataset.mainPanel !== tab;
        });
        try {
          localStorage.setItem(TAB_KEY, tab);
        } catch (e) {}

        if (tab === 'followers' && !followersLoaded && currentSession) {
          followersLoaded = true;
          loadFollowers(currentSession);
        }
      }

      tabsNav.addEventListener('click', (e) => {
        const btn = e.target.closest('.mp-main-tab');
        if (!btn) return;
        applyTab(btn.dataset.mainTab);
      });

      app.addEventListener('click', async (e) => {
        const btn = e.target.closest('.follow-btn');
        if (!btn || !currentSession) return;

        const targetId = btn.dataset.userId;
        const isFollowing = btn.classList.contains('following');
        btn.disabled = true;

        if (isFollowing) {
          await supabase
            .from('follows')
            .delete()
            .eq('follower_id', currentSession.user.id)
            .eq('followee_id', targetId);
        } else {
          await supabase.from('follows').insert({ follower_id: currentSession.user.id, followee_id: targetId });
        }

        const inFollowsTab = btn.closest('[data-main-panel="follows"]');
        if (inFollowsTab) {
          // フォロータブで解除した場合は一覧から消えるので再読み込み
          await loadFollows(currentSession);
        } else {
          const nowFollowing = !isFollowing;
          btn.classList.toggle('following', nowFollowing);
          btn.textContent = nowFollowing ? 'フォロー中' : 'フォローする';
          btn.disabled = false;
        }
      });

      async function init() {
        const {
          data: { session },
        } = await supabase.auth.getSession();

        if (!session) {
          app.innerHTML = `
            <p>フォロー・フォロワーの一覧を見るには、ログインが必要です。</p>
            <a href="/login" class="auth-btn">ログインする</a>
          `;
          return;
        }

        currentSession = session;
        applyTab(currentTab);
        await loadFollows(session);
      }

      init();
    </script>
    <SiteFooter />
  </body>
</html>
