---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#2b5fad" />
    <title>パスワードをお忘れの方 | オナホめも</title>
  </head>
  <body>
    <SiteHeader />
    <main class="login-main">
      <h1>パスワードをお忘れの方</h1>
      <p>登録済みのメールアドレスを入力してください。パスワード再設定用のリンクをお送りします。</p>

      <form id="forgot-form" class="auth-form">
        <label class="profile-edit-label" for="forgot-email">メールアドレス</label>
        <input type="email" id="forgot-email" class="nickname-input" required autocomplete="email" />

        <button type="submit" class="btn-primary">送信する</button>
      </form>
      <p id="forgot-status" class="nickname-status"></p>

      <p class="auth-form-links"><a href="/login">ログインページに戻る</a></p>
    </main>

    <script>
      import { supabase } from '../lib/supabase.js';

      const form = document.getElementById('forgot-form');
      const statusEl = document.getElementById('forgot-status');

      function setStatus(message, isError) {
        statusEl.textContent = message;
        statusEl.classList.toggle('auth-status-error', Boolean(isError));
      }

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        setStatus('送信中...', false);

        const email = document.getElementById('forgot-email').value.trim();

        const { error } = await supabase.auth.resetPasswordForEmail(email, {
          redirectTo: `${window.location.origin}/reset-password`,
        });

        if (error) {
          setStatus('送信に失敗しました。しばらくしてから再度お試しください。', true);
          console.error(error);
          return;
        }

        // 登録有無に関わらず同じメッセージを表示する(メールアドレスの存在確認を防ぐため)
        form.hidden = true;
        setStatus(
          'このメールアドレスが登録済みの場合、パスワード再設定用のメールをお送りしました。',
          false
        );
      });
    </script>
    <SiteFooter />
  </body>
</html>
