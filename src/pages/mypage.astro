---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#2b5fad" />
    <title>マイページ | オナホめも</title>
  </head>
  <body>
    <SiteHeader />
    <main class="mypage-main">
      <div id="profile-details-container"></div>

      <div id="mp-stats-container"></div>

      <div class="mp-main-tabs" id="mp-main-tabs" role="tablist">
        <button type="button" class="mp-main-tab" data-main-tab="all" role="tab">すべて</button>
        <button type="button" class="mp-main-tab" data-main-tab="oshi" role="tab">推しメーカーとマイベスト3</button>
        <button type="button" class="mp-main-tab" data-main-tab="reviews" role="tab">口コミ一覧</button>
        <button type="button" class="mp-main-tab" data-main-tab="badges" role="tab">バッジ・称号</button>
      </div>

      <div class="mp-main-panel" data-main-panel="all">
        <div id="mypage-content">
          <p class="mypage-loading">読み込み中...</p>
        </div>
        <div id="folders-container" style="display:none"></div>
      </div>

      <div class="mp-main-panel" data-main-panel="oshi">
        <div id="oshi-maker-container"></div>
        <div id="top3-container"></div>
      </div>

      <div class="mp-main-panel" data-main-panel="reviews">
        <div id="best-review-container"></div>
        <div id="reviews-list-container"></div>
      </div>

      <div class="mp-main-panel" data-main-panel="badges">
        <div id="rank-hero-container"></div>
        <div class="grid-density-toggle" id="badges-view-toggle">
          <button type="button" class="density-tab" data-badges-view="card" aria-label="カード表示" title="カード表示">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
              <rect x="1" y="1" width="6.5" height="6.5" rx="1" fill="currentColor" />
              <rect x="8.5" y="1" width="6.5" height="6.5" rx="1" fill="currentColor" />
              <rect x="1" y="8.5" width="6.5" height="6.5" rx="1" fill="currentColor" />
              <rect x="8.5" y="8.5" width="6.5" height="6.5" rx="1" fill="currentColor" />
            </svg>
          </button>
          <button type="button" class="density-tab" data-badges-view="grid" aria-label="グリッド表示" title="グリッド表示">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
              <rect x="1" y="1" width="4" height="4" rx="0.8" fill="currentColor" />
              <rect x="6" y="1" width="4" height="4" rx="0.8" fill="currentColor" />
              <rect x="11" y="1" width="4" height="4" rx="0.8" fill="currentColor" />
              <rect x="1" y="6" width="4" height="4" rx="0.8" fill="currentColor" />
              <rect x="6" y="6" width="4" height="4" rx="0.8" fill="currentColor" />
              <rect x="11" y="6" width="4" height="4" rx="0.8" fill="currentColor" />
              <rect x="1" y="11" width="4" height="4" rx="0.8" fill="currentColor" />
              <rect x="6" y="11" width="4" height="4" rx="0.8" fill="currentColor" />
              <rect x="11" y="11" width="4" height="4" rx="0.8" fill="currentColor" />
            </svg>
          </button>
        </div>
        <div class="badges-view-scope" id="badges-view-scope">
          <div id="badge-section-container"></div>
          <div id="titles-section-container"></div>
        </div>
      </div>

      <div id="onaking-links-container"></div>

      <div id="manual-product-container"></div>
    </main>

    <script>
      import { supabase } from '../lib/supabase.js';
      import { compressImage } from '../lib/imageCompress.js';

      const content = document.getElementById('mypage-content');
      const statsContainer = document.getElementById('mp-stats-container');
      const top3Container = document.getElementById('top3-container');
      const bestReviewContainer = document.getElementById('best-review-container');
      const oshiMakerContainer = document.getElementById('oshi-maker-container');
      const foldersContainer = document.getElementById('folders-container');
      const onakingLinksContainer = document.getElementById('onaking-links-container');
      const manualProductContainer = document.getElementById('manual-product-container');
      const profileDetailsContainer = document.getElementById('profile-details-container');
      const reviewsListContainer = document.getElementById('reviews-list-container');
      const mainTabsNav = document.getElementById('mp-main-tabs');
      const mainPanels = document.querySelectorAll('.mp-main-panel');
      const PRODUCT_IMAGE_BUCKET = 'product-images';
      const PROFILE_IMAGE_BUCKET = 'profile-images';
      let manualProducts = [];
      let editingManualProductId = null;

      let currentTop3 = [null, null, null]; // each: { productId, reason } or null
      let currentBestReviewProductId = null;
      let currentOshiMaker = null;
      let currentOshiMakerReason = null;
      let lastChecks = [];
      let top3EditingRank = null;
      let oshiMakerEditing = false;
      let makerOptionsCache = null;
      let currentFolders = [];
      let editingFolderId = null;
      let currentNickname = null;
      let currentFollowingCount = 0;
      let currentAvatarUrl = null;
      let currentHeaderUrl = null;
      let currentBio = null;
      let currentSnsLinks = []; // [{ label, url }]
      let currentIsPublic = true;
      let profileDetailsEditing = false;
      let editingSnsLinks = [];
      let currentViewMode = 'grid';
      try {
        currentViewMode = localStorage.getItem('onahole_view_mode') || 'grid';
      } catch (e) {
        currentViewMode = 'grid';
      }
      let currentStatusTab = 'used';
      try {
        const savedTab = localStorage.getItem('onahole_status_tab');
        if (savedTab === 'used' || savedTab === 'interested' || savedTab === 'folders') currentStatusTab = savedTab;
      } catch (e) {}
      let currentUsedTier = 'all';
      const ADMIN_USER_ID = '278377ee-a457-41bc-ab79-c1be9f4b768e';

      const STATUS_LABELS = {
        interested: '気になる',
        used: '使った',
        folders: 'フォルダ',
      };
      const TIER_LABELS = {
        first: '一軍',
        second: '二軍',
        retired: '引退',
      };
      const STATUS_ORDER = ['used', 'interested'];
      const STATUS_TAB_ORDER = ['interested', 'used', 'folders'];

      const MAIN_TAB_KEYS = ['all', 'oshi', 'reviews', 'badges'];
      let currentMainTab = 'all';
      try {
        const savedMainTab = localStorage.getItem('onahole_main_tab');
        if (MAIN_TAB_KEYS.includes(savedMainTab)) currentMainTab = savedMainTab;
      } catch (e) {}

      function applyMainTab(tab) {
        currentMainTab = tab;
        mainTabsNav.querySelectorAll('.mp-main-tab').forEach((btn) => {
          const active = btn.dataset.mainTab === tab;
          btn.classList.toggle('mp-main-tab-active', active);
          btn.setAttribute('aria-selected', active ? 'true' : 'false');
        });
        mainPanels.forEach((panel) => {
          panel.hidden = panel.dataset.mainPanel !== tab;
        });
        try {
          localStorage.setItem('onahole_main_tab', tab);
        } catch (e) {}
      }

      mainTabsNav.addEventListener('click', (e) => {
        const btn = e.target.closest('.mp-main-tab');
        if (!btn) return;
        applyMainTab(btn.dataset.mainTab);
      });

      applyMainTab(currentMainTab);

      const badgesViewToggle = document.getElementById('badges-view-toggle');
      const badgesViewScope = document.getElementById('badges-view-scope');
      function applyBadgesView(view) {
        badgesViewScope.classList.toggle('badges-dense', view === 'grid');
        badgesViewToggle.querySelectorAll('.density-tab').forEach((btn) => {
          const active = btn.dataset.badgesView === view;
          btn.classList.toggle('density-tab-active', active);
          btn.setAttribute('aria-selected', active ? 'true' : 'false');
        });
        try {
          localStorage.setItem('onahole_badges_view', view);
        } catch (e) {}
      }
      if (badgesViewToggle && badgesViewScope) {
        badgesViewToggle.addEventListener('click', (e) => {
          const btn = e.target.closest('.density-tab');
          if (!btn) return;
          applyBadgesView(btn.dataset.badgesView);
        });
        let savedBadgesView = 'card';
        try {
          savedBadgesView = localStorage.getItem('onahole_badges_view') || 'card';
        } catch (e) {}
        applyBadgesView(savedBadgesView);
      }

      const MONEY_COMPARISON_ITEMS = [
        { name: '缶コーヒー', price: 130, unit: '本' },
        { name: 'ガチャガチャ', price: 300, unit: '回' },
        { name: 'コンビニおにぎり', price: 150, unit: '個' },
        { name: '牛丼(並盛)', price: 480, unit: '杯' },
        { name: 'カフェのコーヒー', price: 500, unit: '杯' },
        { name: '週刊少年マンガ誌', price: 290, unit: '冊' },
        { name: 'ラーメン', price: 900, unit: '杯' },
        { name: '文庫本', price: 700, unit: '冊' },
        { name: '映画館(1回)', price: 2000, unit: '回' },
        { name: '焼肉食べ放題', price: 4000, unit: '回' },
        { name: 'コミック全巻セット(20巻)', price: 12000, unit: 'セット' },
        { name: 'ワイヤレスイヤホン', price: 25000, unit: '個' },
        { name: 'Nintendo Switch 2', price: 49980, unit: '台' },
        { name: '電動アシスト自転車', price: 120000, unit: '台' },
        { name: 'PlayStation 5', price: 79980, unit: '台' },
        { name: 'iPhone 17', price: 139800, unit: '台' },
        { name: 'iPhone 17 Pro', price: 179800, unit: '台' },
        { name: '高性能ゲーミングPC', price: 250000, unit: '台' },
        { name: '大型有機ELテレビ(65インチ)', price: 350000, unit: '台' },
        { name: '海外旅行(1週間)', price: 300000, unit: '回' },
        { name: '国内旅行(3泊4日)', price: 100000, unit: '回' },
        { name: 'ハイエンドノートPC', price: 300000, unit: '台' },
        { name: 'ブランドバッグ', price: 350000, unit: '個' },
        { name: 'ブランド腕時計', price: 400000, unit: '本' },
        { name: '中古の軽自動車', price: 800000, unit: '台' },
        { name: '都内ワンルームの年間家賃', price: 1200000, unit: '年分' },
        { name: 'ハイブランド腕時計', price: 1500000, unit: '本' },
        { name: '新車(コンパクトカー)', price: 2000000, unit: '台' },
        { name: '新車(ミニバン)', price: 3500000, unit: '台' },
        { name: '結婚式の平均費用', price: 3000000, unit: '回分' },
        { name: '新車(高級セダン)', price: 6000000, unit: '台' },
        { name: '中古マンション(郊外)', price: 30000000, unit: '戸' },
      ];

      function moneyComparisonPicks(amount, count = 6) {
        if (!amount) return [];
        // 価格が安い順に並べ、その中から等間隔にcount件選ぶことで、
        // 少額〜高額まで幅広い「解像度」で例えを見せる
        const sorted = MONEY_COMPARISON_ITEMS.map((it) => ({ ...it, ratio: amount / it.price })).sort(
          (a, b) => a.price - b.price
        );
        if (sorted.length <= count) return sorted;
        const picks = [];
        for (let i = 0; i < count; i++) {
          const idx = Math.round((i * (sorted.length - 1)) / (count - 1));
          picks.push(sorted[idx]);
        }
        const seen = new Set();
        return picks.filter((it) => {
          if (seen.has(it.name)) return false;
          seen.add(it.name);
          return true;
        });
      }

      function formatMoneyComparison(it) {
        if (it.ratio >= 1) {
          const count = it.ratio >= 10 ? Math.round(it.ratio) : Math.round(it.ratio * 10) / 10;
          return `${it.name} 約${count.toLocaleString()}${it.unit}分`;
        }
        const percent = Math.max(1, Math.round(it.ratio * 100));
        return `${it.name}の約${percent}%`;
      }

      function moneyComparisonHtml(amount) {
        const picks = moneyComparisonPicks(amount);
        if (picks.length === 0) {
          return `<p class="mp-spend-compare-empty">まだ使った記録がありません。</p>`;
        }
        return `
          <p class="mp-spend-compare-title">その金額で買えたかもしれないもの(目安)</p>
          <ul class="mp-spend-compare-list">
            ${picks.map((it) => `<li>${formatMoneyComparison(it)}</li>`).join('')}
          </ul>
          <p class="mp-spend-compare-note">※価格はあくまで目安です</p>
        `;
      }

      function isOnSale(check) {
        const p = check.products;
        if (!p) return false;
        const listPrice = p.raw_data?.prices?.list_price ? Number(p.raw_data.prices.list_price) : null;
        return Boolean(listPrice && p.price && listPrice > p.price);
      }

      const BADGE_TIERS = [
        { threshold: 100, name: 'レジェンド' },
        { threshold: 50, name: 'マスター' },
        { threshold: 30, name: 'ベテラン' },
        { threshold: 10, name: 'レギュラー' },
        { threshold: 5, name: 'ビギナー' },
        { threshold: 1, name: 'はじめての一本' },
      ];

      function getBadgeInfo(usedCount) {
        const current = BADGE_TIERS.find((t) => usedCount >= t.threshold) ?? null;
        const next = [...BADGE_TIERS].reverse().find((t) => t.threshold > usedCount) ?? null;
        return { current, next };
      }

      function badgeSectionHtml(usedCount, checks) {
        const { current, next } = getBadgeInfo(usedCount);

        const makerCounts = {};
        for (const c of checks) {
          const maker = c.products?.maker;
          if (c.status === 'used' && maker) {
            makerCounts[maker] = (makerCounts[maker] ?? 0) + 1;
          }
        }
        const makerBadges = Object.entries(makerCounts)
          .map(([maker, count]) => ({ maker, count, badge: getMakerBadge(count) }))
          .filter((b) => b.badge)
          .sort((a, b) => b.count - a.count);

        const chips = [];

        if (current) {
          const nextText = next
            ? `次の「${next.name}」まであと${next.threshold - usedCount}本`
            : `使用本数${current.threshold}本以上`;
          chips.push(`
            <div class="badge-chip-card">
              <span class="badge-chip-icon">🏆</span>
              <div class="badge-chip-body">
                <p class="badge-chip-name">${current.name}</p>
                <p class="badge-chip-sub">${nextText}</p>
              </div>
            </div>
          `);
        }

        for (const b of makerBadges) {
          chips.push(`
            <div class="badge-chip-card">
              <span class="badge-chip-icon">🏭</span>
              <div class="badge-chip-body">
                <p class="badge-chip-name">${b.maker}${b.badge.name}</p>
                <p class="badge-chip-sub">同メーカー${b.badge.threshold}本以上使用</p>
              </div>
            </div>
          `);
        }

        const html = `
          <div class="badge-chips-section">
            <h2 class="badge-chips-title">バッジ</h2>
            ${
              chips.length
                ? `<div class="badge-chips-row">${chips.join('')}</div>`
                : `<p class="badge-empty">まだバッジがありません。1本使うと「はじめての一本」バッジがもらえます。</p>`
            }
          </div>
        `;
        return { html, badgeCount: chips.length };
      }

      const MAKER_BADGE_TIERS = [
        { threshold: 10, name: 'コレクター' },
        { threshold: 5, name: 'マニア' },
        { threshold: 3, name: 'ファン' },
        { threshold: 1, name: 'デビュー' },
      ];

      function getMakerBadge(count) {
        return MAKER_BADGE_TIERS.find((t) => count >= t.threshold) ?? null;
      }

      // 称号の判定条件で使う集計ヘルパー
      const countWhere = (checks, pred) => checks.filter(pred).length;
      const titleUsedCount = (checks) => countWhere(checks, (c) => c.status === 'used');
      const titleInterestedCount = (checks) => countWhere(checks, (c) => c.status === 'interested');
      const titleTierCount = (checks, tier) => countWhere(checks, (c) => c.status === 'used' && c.tier === tier);
      const titleRatingCount = (checks, n) => countWhere(checks, (c) => c.rating === n);
      const titleReviewTextCount = (checks) => countWhere(checks, (c) => Boolean(c.review_text));
      const titleDetailReviewCount = (checks) => countWhere(checks, (c) => Boolean(c.detail_review_text));
      const titleReviewImageCount = (checks) =>
        countWhere(checks, (c) => Array.isArray(c.review_images) && c.review_images.length > 0);
      const titleComboReviewCount = (checks) =>
        countWhere(checks, (c) => Boolean(c.review_text) && Boolean(c.detail_review_text));
      const titlePublicCount = (checks) => countWhere(checks, (c) => Boolean(c.is_public));
      const titleSimilarCount = (checks) => countWhere(checks, (c) => Boolean(c.similar_products));
      const titleRetirementReasonCount = (checks) => countWhere(checks, (c) => Boolean(c.retirement_reason));
      const titleMemoCount = (checks) => countWhere(checks, (c) => Boolean(c.memo));
      const titleMakerDiversity = (checks) =>
        new Set(checks.filter((c) => c.status === 'used' && c.products?.maker).map((c) => c.products.maker)).size;
      const titleGenreDiversity = (checks) => {
        const s = new Set();
        for (const c of checks) {
          if (c.status !== 'used') continue;
          for (const g of c.products?.genre_tags ?? []) s.add(g);
        }
        return s.size;
      };
      const titleHasExpensiveUsed = (checks, min) =>
        checks.some((c) => c.status === 'used' && c.products?.price != null && c.products.price >= min);
      const titleHasCheapUsed = (checks, max) =>
        checks.some((c) => c.status === 'used' && c.products?.price != null && c.products.price > 0 && c.products.price < max);
      const titleHasAllTiers = (checks) =>
        ['first', 'second', 'retired'].every((tier) => checks.some((c) => c.status === 'used' && c.tier === tier));
      const totalSpentOfTitles = (checks) =>
        checks.filter((c) => c.status === 'used').reduce((sum, c) => sum + (c.products?.price ?? 0), 0);

      const TITLES = [
        {
          id: 'first_check',
          icon: '🎯',
          name: '一歩目',
          desc: 'はじめてチェックを記録する',
          check: (checks) => checks.length > 0,
        },
        {
          id: 'interested_one',
          icon: '👀',
          name: '気になる屋さん',
          desc: '「気になる」を1件登録する',
          check: (checks) => checks.some((c) => c.status === 'interested'),
        },
        {
          id: 'used_one',
          icon: '✅',
          name: '使用開始',
          desc: '「使った」を1件記録する',
          check: (checks) => checks.some((c) => c.status === 'used'),
        },
        {
          id: 'first_tier',
          icon: '🥇',
          name: '一軍認定',
          desc: '「一軍」を1件選ぶ',
          check: (checks) => checks.some((c) => c.tier === 'first'),
        },
        {
          id: 'retired_one',
          icon: '👋',
          name: '卒業',
          desc: '「引退」を1件記録する',
          check: (checks) => checks.some((c) => c.tier === 'retired'),
        },
        {
          id: 'rating_one',
          icon: '⭐',
          name: '星をつけた',
          desc: '星評価を1件つける',
          check: (checks) => checks.some((c) => c.rating),
        },
        {
          id: 'rating_five',
          icon: '🌟',
          name: '満点評価',
          desc: '★5をつける',
          check: (checks) => checks.some((c) => c.rating === 5),
        },
        {
          id: 'review_one',
          icon: '✍️',
          name: 'ひとことレビュアー',
          desc: 'ひとことレビューを1件書く',
          check: (checks) => checks.some((c) => c.review_text),
        },
        {
          id: 'detail_review_one',
          icon: '📝',
          name: '語り部',
          desc: '詳細レビューを1件書く',
          check: (checks) => checks.some((c) => c.detail_review_text),
        },
        {
          id: 'image_one',
          icon: '📷',
          name: 'カメラマン',
          desc: 'レビュー画像を1件投稿する',
          check: (checks) => checks.some((c) => c.review_images && c.review_images.length > 0),
        },
        {
          id: 'retirement_reason_one',
          icon: '💌',
          name: '正直者',
          desc: '手放した理由を1件書く',
          check: (checks) => checks.some((c) => c.retirement_reason),
        },
        {
          id: 'similar_one',
          icon: '🔍',
          name: '目利き',
          desc: '似てるオナホールを1件記入する',
          check: (checks) => checks.some((c) => c.similar_products),
        },
        {
          id: 'public_one',
          icon: '📢',
          name: '公開派',
          desc: 'レビューを1件公開する',
          check: (checks) => checks.some((c) => c.is_public),
        },
        {
          id: 'memo_one',
          icon: '🗒️',
          name: 'メモ魔',
          desc: 'ひとことメモを1件書く',
          check: (checks) => checks.some((c) => c.memo),
        },
        {
          id: 'genre_explorer',
          icon: '🧭',
          name: 'ジャンル探検家',
          desc: '3種類以上のジャンルの商品を使う',
          check: (checks) => {
            const genres = new Set();
            for (const c of checks) {
              if (c.status !== 'used') continue;
              for (const g of c.products?.genre_tags ?? []) genres.add(g);
            }
            return genres.size >= 3;
          },
        },
        {
          id: 'multi_maker',
          icon: '🏭',
          name: '多メーカー派',
          desc: '3社以上のメーカーの商品を使う',
          check: (checks) => {
            const makers = new Set();
            for (const c of checks) {
              if (c.status === 'used' && c.products?.maker) makers.add(c.products.maker);
            }
            return makers.size >= 3;
          },
        },
        {
          id: 'nickname_set',
          icon: '🪪',
          name: '名乗り',
          desc: 'ニックネームを設定する',
          check: (_checks, ctx) => Boolean(ctx?.hasNickname),
        },

        // 使った本数マイルストーン
