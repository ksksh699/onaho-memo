        if (!session) return;

        if (e.target.closest('#create-folder-btn')) {
          const input = document.getElementById('new-folder-name');
          const name = input.value.trim();
          if (!name) return;
          const maxOrder = currentFolders.reduce((m, f) => Math.max(m, f.sort_order ?? 0), -1);
          const { error } = await supabase
            .from('folders')
            .insert({ user_id: session.user.id, name, sort_order: maxOrder + 1 });
          if (error) console.error(error);
          await renderFoldersSection(session.user.id);
          return;
        }

        const renameBtn = e.target.closest('.folder-rename-btn');
        if (renameBtn) {
          editingFolderId = renameBtn.dataset.folderId;
          foldersContainer.innerHTML = foldersSectionHtml(currentFolders);
          return;
        }

        const cancelBtn = e.target.closest('.folder-rename-cancel-btn');
        if (cancelBtn) {
          editingFolderId = null;
          foldersContainer.innerHTML = foldersSectionHtml(currentFolders);
          return;
        }

        const saveBtn = e.target.closest('.folder-rename-save-btn');
        if (saveBtn) {
          const folderId = saveBtn.dataset.folderId;
          const nameInput = document.getElementById(`folder-name-edit-${folderId}`);
          const name = nameInput ? nameInput.value.trim() : '';
          if (!name) return;
          const { error } = await supabase
            .from('folders')
            .update({ name, updated_at: new Date().toISOString() })
            .eq('id', folderId);
          if (error) console.error(error);
          editingFolderId = null;
          await renderFoldersSection(session.user.id);
          return;
        }

        const deleteBtn = e.target.closest('.folder-delete-btn');
        if (deleteBtn) {
          if (!confirm('このフォルダを削除しますか？中の商品リストも削除されます。')) return;
          const folderId = deleteBtn.dataset.folderId;
          const { error } = await supabase.from('folders').delete().eq('id', folderId);
          if (error) console.error(error);
          await renderFoldersSection(session.user.id);
          return;
        }

        const moveBtn = e.target.closest('.folder-move-btn');
        if (moveBtn && !moveBtn.disabled) {
          const folderId = moveBtn.dataset.folderId;
          const dir = moveBtn.dataset.dir;
          const idx = currentFolders.findIndex((f) => f.id === folderId);
          const swapIdx = dir === 'up' ? idx - 1 : idx + 1;
          if (swapIdx < 0 || swapIdx >= currentFolders.length) return;
          const a = currentFolders[idx];
          const b = currentFolders[swapIdx];
          const { error: e1 } = await supabase
            .from('folders')
            .update({ sort_order: b.sort_order })
            .eq('id', a.id);
          const { error: e2 } = await supabase
            .from('folders')
            .update({ sort_order: a.sort_order })
            .eq('id', b.id);
          if (e1 || e2) console.error(e1 || e2);
          await renderFoldersSection(session.user.id);
          return;
        }

        const removeItemBtn = e.target.closest('.folder-item-remove-btn');
        if (removeItemBtn) {
          const folderItemId = removeItemBtn.dataset.folderItemId;
          const { error } = await supabase.from('folder_items').delete().eq('id', folderItemId);
          if (error) console.error(error);
          await renderFoldersSection(session.user.id);
        }
      });

