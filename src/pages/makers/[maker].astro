---
import { supabase } from '../../lib/supabase.js';
import '../../styles/global.css';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import ProductCards from '../../components/ProductCards.astro';
import ListingPager from '../../components/ListingPager.astro';
import { LISTING_SELECT, parsePage, pageRange, totalPages, setListingCacheHeaders, pageHref } from '../../lib/listing.js';

// メーカー別の商品一覧(2026-09-08)。URL: /makers/{メーカー名}/?page=N
// 「メーカー名 オナホ」「メーカー名 最安値」といった検索の入口にする。
const maker = Astro.params.maker ?? '';
const page = parsePage(Astro.url.searchParams);
const [from, to] = pageRange(page);

const { data: products, count } = await supabase
  .from('v_products_listing')
  .select(LISTING_SELECT, { count: 'exact' })
  .eq('maker', maker)
  .order('release_date', { ascending: false, nullsFirst: false })
  .order('dmm_content_id', { ascending: true })
  .range(from, to);

if (!count) {
  return Astro.redirect('/makers/', 302);
}

setListingCacheHeaders(Astro.response);

const pages = totalPages(count);
const basePath = `/makers/${encodeURIComponent(maker)}/`;
const canonical = `https://onahomemo.com${pageHref(basePath, page)}`;
const rated = (products ?? []).filter((p) => p.site_rating_count > 0).length;
const title = `${maker}のオナホ一覧(${count}件)${page > 1 ? ` ${page}ページ目` : ''} | オナホめも`;
const description = `${maker}のオナホール${count}件の一覧。新着順に、価格・FANZAレビュー・オナホめもユーザーの評価を表示。各商品ページでFANZA・NLS・大魔王など8ショップの価格を比較できます。`;
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#2b5fad" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {page > 1 && <link rel="prev" href={`https://onahomemo.com${pageHref(basePath, page - 1)}`} />}
    {page < pages && <link rel="next" href={`https://onahomemo.com${pageHref(basePath, page + 1)}`} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${maker}のオナホ一覧 | オナホめも`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="オナホめも" />
    <meta property="og:image" content="https://onahomemo.com/ogp.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@onahomemo" />
  </head>
  <body>
    <SiteHeader />
    <main class="listing-page">
      <nav class="breadcrumb" aria-label="パンくず"><a href="/">ホーム</a><span>›</span><a href="/makers/">メーカー一覧</a><span>›</span><span>{maker}</span></nav>
      <h1 class="listing-title">{maker}のオナホ一覧</h1>
      <p class="listing-lead">
        {count.toLocaleString('ja-JP')}件を新着順に表示{page > 1 ? `(${page} / ${pages}ページ)` : ''}。
        {rated > 0 && `このページの${rated}件にはオナホめもユーザーの評価があります。`}
        各商品ページで8ショップの価格を比較できます。
      </p>
      <ProductCards products={products ?? []} />
      <ListingPager basePath={basePath} current={page} total={pages} />
    </main>
    <SiteFooter />
  </body>
</html>
