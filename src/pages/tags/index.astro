---
import { supabase } from '../../lib/supabase.js';
import '../../styles/global.css';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { setListingCacheHeaders, isCampaignTag } from '../../lib/listing.js';

// ジャンル(タグ)一覧ページ(2026-09-08)。タグは FANZA 由来の genre_tags。
// セール系のタグ(超特価祭など)は /sale/ に集約しているので、ここには載せない。
setListingCacheHeaders(Astro.response);

const MIN_COUNT = 3;
const { data: tagRows } = await supabase.rpc('get_genre_tag_stats');
const tags = (tagRows ?? []).filter((t) => t.tag && !isCampaignTag(t.tag) && Number(t.cnt) >= MIN_COUNT);
const pageUrl = 'https://onahomemo.com/tags/';
const description = `オナホールをジャンル・特徴(${tags.slice(0, 5).map((t) => t.tag).join('・')}など${tags.length}種類)から探せる一覧。各ジャンルの商品数・レビュー・8ショップの価格比較を確認できます。`;
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#2b5fad" />
    <title>オナホのジャンル・特徴一覧({tags.length}種類) | オナホめも</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="オナホのジャンル・特徴一覧 | オナホめも" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content="オナホめも" />
    <meta property="og:image" content="https://onahomemo.com/ogp.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@onahomemo" />
  </head>
  <body>
    <SiteHeader />
    <main class="listing-page">
      <nav class="breadcrumb" aria-label="パンくず"><a href="/">ホーム</a><span>›</span><span>ジャンル一覧</span></nav>
      <h1 class="listing-title">オナホのジャンル・特徴一覧</h1>
      <p class="listing-lead">{tags.length}種類。タップすると、そのジャンルの商品一覧(価格比較・レビュー付き)が開きます。セール中の商品は<a href="/sale/">セール一覧</a>へ。</p>
      <ul class="term-list">
        {tags.map((t) => (
          <li>
            <a href={`/tags/${encodeURIComponent(t.tag)}/`} class="term-chip">
              <span class="term-name">{t.tag}</span>
              <span class="term-count">{Number(t.cnt).toLocaleString('ja-JP')}</span>
            </a>
          </li>
        ))}
      </ul>
    </main>
    <SiteFooter />
  </body>
</html>
