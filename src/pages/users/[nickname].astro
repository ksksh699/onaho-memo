---
import { supabase } from '../../lib/supabase.js';
import '../../styles/global.css';

// 商品ページと同様、ビルド時の事前生成(prerender)はせず、リクエストごとに
// その場でSupabaseから該当プロフィールを取得する(SSR)方式にしている。
// (以前はgetStaticPathsでビルド時に全ページ生成していたため、ニックネーム変更や
// 新規登録が次回デプロイまで反映されないというバグがあった)
const { nickname } = Astro.params;
const profileResult = await supabase
  .from('profiles')
  .select(
    'id, nickname, best_product_id_1, best_product_id_2, best_product_id_3, best_product_reason_1, best_product_reason_2, best_product_reason_3, best_review_product_id, oshi_maker, oshi_maker_reason, avatar_url, header_url, bio, sns_links, is_public'
  )
  .eq('nickname', nickname)
  .maybeSingle();
let profile = profileResult.data;

// 非公開プロフィールは、存在しないページと同じ扱いにして完全に非表示にする
if (profile && profile.is_public === false) {
  profile = null;
}

const snsLinks = Array.isArray(profile?.sns_links) ? profile.sns_links.filter((l) => l?.url) : [];

// checksは「そのユーザーのチェック全件」(公開・非公開を問わず)を取得しておき、
// 一覧表示には公開分だけを絞り込んで使う。TOP3・ベストな口コミ・バッジ/称号・
// 統計欄は、ユーザー本人が公開を意図した情報(TOP3選出やベスト口コミ選出、
// 集計としてのバッジ)なので、個々のチェックのis_publicに関わらず全件から計算する。
// (以前はTOP3・ベストな口コミも公開チェックのみから検索していたため、
// 選んだ商品のチェック自体が非公開だと表示から抜け落ちるバグがあった)
let allChecks = [];
if (profile) {
  const { data } = await supabase
    .from('checks')
    .select(
      'status, tier, rating, review_title, review_text, detail_review_title, detail_review_text, review_images, retirement_reason, similar_products, memo, is_public, updated_at, products(id, dmm_content_id, name, maker, price, image_url, genre_tags, raw_data)'
    )
    .eq('user_id', profile.id)
    .order('updated_at', { ascending: false });
  allChecks = data ?? [];
}
const checks = allChecks.filter((c) => c.is_public);

function isOnSale(check) {
  const p = check.products;
  if (!p) return false;
  const listPrice = p.raw_data?.prices?.list_price ? Number(p.raw_data.prices.list_price) : null;
  return Boolean(listPrice && p.price && listPrice > p.price);
}

function escapeHtml(str) {
  if (str == null) return '';
  return String(str).replace(
    /[&<>"']/g,
    (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]
  );
}

const TIER_LABELS_PRE = { first: '一軍', second: '二軍', retired: '引退' };

const groupedAll = { used: [], interested: [] };
for (const c of allChecks) {
  if (groupedAll[c.status]) groupedAll[c.status].push(c);
}
const usedByTierAll = { first: [], second: [], retired: [] };
for (const c of groupedAll.used) {
  if (c.tier && usedByTierAll[c.tier]) usedByTierAll[c.tier].push(c);
}
const totalSpentAll = groupedAll.used.reduce((sum, c) => sum + (c.products?.price ?? 0), 0);

const groupedPublic = { used: [], interested: [] };
for (const c of checks) {
  if (groupedPublic[c.status]) groupedPublic[c.status].push(c);
}
const usedByTierPublic = { first: [], second: [], retired: [] };
for (const c of groupedPublic.used) {
  if (c.tier && usedByTierPublic[c.tier]) usedByTierPublic[c.tier].push(c);
}

const TOP3_IDS = profile
  ? [profile.best_product_id_1, profile.best_product_id_2, profile.best_product_id_3]
  : [null, null, null];
const TOP3_REASONS = profile
  ? [profile.best_product_reason_1, profile.best_product_reason_2, profile.best_product_reason_3]
  : [null, null, null];

const top3 = TOP3_IDS.map((pid, i) => {
  if (!pid) return null;
  const check = allChecks.find((c) => c.products?.id === pid);
  if (!check) return null;
  return { check, reason: TOP3_REASONS[i], rank: i + 1 };
}).filter(Boolean);

const bestReviewCheck = profile
  ? allChecks.find((c) => c.products?.id === profile.best_review_product_id) ?? null
  : null;
const bestReviewIsDetail = Boolean(bestReviewCheck?.detail_review_text);
const bestReviewText = bestReviewCheck
  ? bestReviewCheck.detail_review_text || bestReviewCheck.review_text || ''
  : '';
const bestReviewTitle = bestReviewCheck
  ? bestReviewIsDetail
    ? bestReviewCheck.detail_review_title
    : bestReviewCheck.review_title
  : '';
const bestReviewDateStr = bestReviewCheck?.updated_at
  ? new Date(bestReviewCheck.updated_at).toLocaleDateString('ja-JP')
  : '';

function starString(rating) {
  if (!rating) return '';
  const full = Math.max(0, Math.min(5, Math.round(rating)));
  return '★'.repeat(full) + '☆'.repeat(5 - full);
}

function publicCardMeta(check) {
  const p = check.products;
  if (!p) return null;
  const top3Idx = top3.findIndex((s) => s.check.products?.id === p.id);
  const isTop3 = check.status === 'used' && top3Idx >= 0;
  const hasReview = Boolean(check.review_text || check.detail_review_text);
  const isBestReview = hasReview && p.id === profile?.best_review_product_id;
  let subInfo = '';
  if (check.status === 'used' && check.tier) {
    subInfo += `<span class="mp-tag">${escapeHtml(TIER_LABELS_PRE[check.tier])}</span>`;
  }
  if (check.rating) subInfo += `<span class="mp-tag">★${check.rating}</span>`;
  if (isTop3) subInfo += `<span class="mp-tag mp-best">TOP3: ${top3Idx + 1}位</span>`;
  if (isBestReview) subInfo += `<span class="mp-tag mp-best">ベスト口コミ</span>`;
  return { p, isTop3, subInfo };
}

function publicCardHtml(check) {
  const meta = publicCardMeta(check);
  if (!meta) return '';
  const { p, isTop3, subInfo } = meta;
  const stars = starString(check.rating);
  const starsHtml = stars ? '<p class="mp-mobile-stars">' + stars + '</p>' : '';
  return `
    <li class="mp-card ${isTop3 ? 'mp-card-best' : ''}" data-tier="${check.tier ?? ''}">
      <a href="/products/${p.dmm_content_id}/">
        <img src="${escapeHtml(p.image_url)}" alt="${escapeHtml(p.name)}" loading="lazy" />
        <div class="mp-card-body">
          <p class="mp-maker">${escapeHtml(p.maker ?? '')}</p>
          <h3>${escapeHtml(p.name)}</h3>
          <p class="mp-price">${p.price ? `¥${p.price.toLocaleString()}` : ''}</p>
          <div class="mp-tags">${subInfo}</div>
          ${starsHtml}
        </div>
      </a>
    </li>
  `;
}

function publicRowHtml(check) {
  const meta = publicCardMeta(check);
  if (!meta) return '';
  const { p, isTop3, subInfo } = meta;
  return `
    <li class="mp-row ${isTop3 ? 'mp-row-best' : ''}" data-tier="${check.tier ?? ''}">
      <a href="/products/${p.dmm_content_id}/" class="mp-row-link">
        <img src="${escapeHtml(p.image_url)}" alt="${escapeHtml(p.name)}" loading="lazy" />
        <div class="mp-row-body">
          <h3>${escapeHtml(p.name)}</h3>
          <p class="mp-price">${p.price ? `¥${p.price.toLocaleString()}` : ''}</p>
          <div class="mp-tags">${subInfo}</div>
        </div>
      </a>
    </li>
  `;
}

const interestedCardsHtml = groupedPublic.interested.map(publicCardHtml).join('');
const interestedRowsHtml = groupedPublic.interested.map(publicRowHtml).join('');
const usedCardsHtml = groupedPublic.used.map(publicCardHtml).join('');
const usedRowsHtml = groupedPublic.used.map(publicRowHtml).join('');

let totalUsedCount = 0;
if (profile) {
  const { data: usedCountData } = await supabase.rpc('get_used_count', {
    target_user_id: profile.id,
  });
  totalUsedCount = usedCountData ?? 0;
}

const BADGE_TIERS = [
  { threshold: 100, name: 'レジェンド' },
  { threshold: 50, name: 'マスター' },
  { threshold: 30, name: 'ベテラン' },
  { threshold: 10, name: 'レギュラー' },
  { threshold: 5, name: 'ビギナー' },
  { threshold: 1, name: 'はじめての一本' },
];
const badgeCurrent = BADGE_TIERS.find((t) => totalUsedCount >= t.threshold) ?? null;
const badgeNext = [...BADGE_TIERS].reverse().find((t) => t.threshold > totalUsedCount) ?? null;
const badgeNextText = badgeNext
  ? `次の「${badgeNext.name}」まであと${badgeNext.threshold - totalUsedCount}本`
  : '最高ランクに到達しました';

const MAKER_BADGE_TIERS = [
  { threshold: 10, name: 'コレクター' },
  { threshold: 5, name: 'マニア' },
  { threshold: 3, name: 'ファン' },
  { threshold: 1, name: 'デビュー' },
];

let makerBadges = [];
if (profile) {
  const { data: makerCountsData } = await supabase.rpc('get_used_maker_counts', {
    target_user_id: profile.id,
  });
  makerBadges = (makerCountsData ?? [])
    .map((row) => ({
      maker: row.maker,
      count: row.used_count,
      badge: MAKER_BADGE_TIERS.find((t) => row.used_count >= t.threshold) ?? null,
    }))
    .filter((b) => b.badge)
    .sort((a, b) => b.count - a.count);
}

let publicFolders = [];
if (profile) {
  const { data: foldersData } = await supabase
    .from('folders')
    .select(
      'id, name, sort_order, folder_items(id, product_id, products(id, dmm_content_id, name, maker, image_url))'
    )
    .eq('user_id', profile.id)
    .eq('is_public', true)
    .order('sort_order', { ascending: true });
  publicFolders = foldersData ?? [];
}

let followerCount = 0;
let followingCount = 0;
if (profile) {
  const { count: fc } = await supabase
    .from('follows')
    .select('*', { count: 'exact', head: true })
    .eq('followee_id', profile.id);
  followerCount = fc ?? 0;

  const { count: gc } = await supabase
    .from('follows')
    .select('*', { count: 'exact', head: true })
    .eq('follower_id', profile.id);
  followingCount = gc ?? 0;
}

const STATUS_LABELS = { interested: '気になる', used: '使った', folders: 'フォルダ' };
const TIER_LABELS = TIER_LABELS_PRE;
const STATUS_TAB_ORDER = ['interested', 'used', 'folders'];

const publicReviews = checks.filter((c) => c.review_text || c.detail_review_text);

const badgeChipsList = (() => {
  const chips = [];
  if (badgeCurrent) {
    chips.push(`
      <div class="badge-chip-card">
        <span class="badge-chip-icon">🏆</span>
        <div class="badge-chip-body">
          <p class="badge-chip-name">${escapeHtml(badgeCurrent.name)}</p>
          <p class="badge-chip-sub">${escapeHtml(badgeNextText)}</p>
        </div>
      </div>
    `);
  }
  for (const b of makerBadges) {
    chips.push(`
      <div class="badge-chip-card">
        <span class="badge-chip-icon">🏭</span>
        <div class="badge-chip-body">
          <p class="badge-chip-name">${escapeHtml(b.maker)}${escapeHtml(b.badge.name)}</p>
          <p class="badge-chip-sub">同メーカー${b.badge.threshold}本以上使用</p>
        </div>
      </div>
    `);
  }
  return chips;
})();
const badgeChipsHtml = badgeChipsList.join('');
const badgeCount = badgeChipsList.length;

// 称号の判定条件で使う集計ヘルパー(マイページと同じロジック)
const countWhere = (checks, pred) => checks.filter(pred).length;
const titleUsedCount = (checks) => countWhere(checks, (c) => c.status === 'used');
const titleInterestedCount = (checks) => countWhere(checks, (c) => c.status === 'interested');
const titleTierCount = (checks, tier) => countWhere(checks, (c) => c.status === 'used' && c.tier === tier);
const titleRatingCount = (checks, n) => countWhere(checks, (c) => c.rating === n);
const titleReviewTextCount = (checks) => countWhere(checks, (c) => Boolean(c.review_text));
const titleDetailReviewCount = (checks) => countWhere(checks, (c) => Boolean(c.detail_review_text));
const titleReviewImageCount = (checks) =>
  countWhere(checks, (c) => Array.isArray(c.review_images) && c.review_images.length > 0);
const titleComboReviewCount = (checks) =>
  countWhere(checks, (c) => Boolean(c.review_text) && Boolean(c.detail_review_text));
const titlePublicCount = (checks) => countWhere(checks, (c) => Boolean(c.is_public));
const titleSimilarCount = (checks) => countWhere(checks, (c) => Boolean(c.similar_products));
const titleRetirementReasonCount = (checks) => countWhere(checks, (c) => Boolean(c.retirement_reason));
const titleMemoCount = (checks) => countWhere(checks, (c) => Boolean(c.memo));
const titleMakerDiversity = (checks) =>
  new Set(checks.filter((c) => c.status === 'used' && c.products?.maker).map((c) => c.products.maker)).size;
const titleGenreDiversity = (checks) => {
  const s = new Set();
  for (const c of checks) {
    if (c.status !== 'used') continue;
    for (const g of c.products?.genre_tags ?? []) s.add(g);
  }
  return s.size;
};
const titleHasExpensiveUsed = (checks, min) =>
  checks.some((c) => c.status === 'used' && c.products?.price != null && c.products.price >= min);
const titleHasCheapUsed = (checks, max) =>
  checks.some((c) => c.status === 'used' && c.products?.price != null && c.products.price > 0 && c.products.price < max);
const titleHasAllTiers = (checks) =>
  ['first', 'second', 'retired'].every((tier) => checks.some((c) => c.status === 'used' && c.tier === tier));
const totalSpentOfTitles = (checks) =>
  checks.filter((c) => c.status === 'used').reduce((sum, c) => sum + (c.products?.price ?? 0), 0);
const titleTop3FilledCount = [profile?.best_product_id_1, profile?.best_product_id_2, profile?.best_product_id_3].filter(
  Boolean
).length;

// 称号(実績)。マイページと同じ判定ロジック。公開ページでは「NEW」表示は行わない
// (localStorageで管理する「新着」は本人向けの演出のため、他人のプロフィールでは意味がない)。
// 判定はallChecks(非公開チェックも含む)を対象にしている。バッジ同様「集計としての称号」は
// 個々のチェックの公開設定に関わらずアカウント全体の実績として扱う設計。
const TITLES = [
  { id: 'first_check', icon: '🎯', name: '一歩目', desc: 'はじめてチェックを記録する', check: (cs) => cs.length > 0 },
  { id: 'interested_one', icon: '👀', name: '気になる屋さん', desc: '「気になる」を1件登録する', check: (cs) => cs.some((c) => c.status === 'interested') },
  { id: 'used_one', icon: '✅', name: '使用開始', desc: '「使った」を1件記録する', check: (cs) => cs.some((c) => c.status === 'used') },
  { id: 'first_tier', icon: '🥇', name: '一軍認定', desc: '「一軍」を1件選ぶ', check: (cs) => cs.some((c) => c.tier === 'first') },
  { id: 'retired_one', icon: '👋', name: '卒業', desc: '「引退」を1件記録する', check: (cs) => cs.some((c) => c.tier === 'retired') },
  { id: 'rating_one', icon: '⭐', name: '星をつけた', desc: '星評価を1件つける', check: (cs) => cs.some((c) => c.rating) },
  { id: 'rating_five', icon: '🌟', name: '満点評価', desc: '★5をつける', check: (cs) => cs.some((c) => c.rating === 5) },
  { id: 'review_one', icon: '✍️', name: 'ひとことレビュアー', desc: 'ひとことレビューを1件書く', check: (cs) => cs.some((c) => c.review_text) },
  { id: 'detail_review_one', icon: '📝', name: '語り部', desc: '詳細レビューを1件書く', check: (cs) => cs.some((c) => c.detail_review_text) },
  { id: 'image_one', icon: '📷', name: 'カメラマン', desc: 'レビュー画像を1件投稿する', check: (cs) => cs.some((c) => c.review_images && c.review_images.length > 0) },
  { id: 'retirement_reason_one', icon: '💌', name: '正直者', desc: '手放した理由を1件書く', check: (cs) => cs.some((c) => c.retirement_reason) },
  { id: 'similar_one', icon: '🔍', name: '目利き', desc: '似てるオナホールを1件記入する', check: (cs) => cs.some((c) => c.similar_products) },
  { id: 'public_one', icon: '📢', name: '公開派', desc: 'レビューを1件公開する', check: (cs) => cs.some((c) => c.is_public) },
  { id: 'memo_one', icon: '🗒️', name: 'メモ魔', desc: 'ひとことメモを1件書く', check: (cs) => cs.some((c) => c.memo) },
  {
    id: 'genre_explorer',
    icon: '🧭',
    name: 'ジャンル探検家',
    desc: '3種類以上のジャンルの商品を使う',
    check: (cs) => {
      const genres = new Set();
      for (const c of cs) {
        if (c.status !== 'used') continue;
        for (const g of c.products?.genre_tags ?? []) genres.add(g);
      }
      return genres.size >= 3;
    },
  },
  {
    id: 'multi_maker',
    icon: '🏭',
    name: '多メーカー派',
    desc: '3社以上のメーカーの商品を使う',
    check: (cs) => {
      const makers = new Set();
      for (const c of cs) {
        if (c.status === 'used' && c.products?.maker) makers.add(c.products.maker);
      }
      return makers.size >= 3;
    },
  },
  { id: 'nickname_set', icon: '🪪', name: '名乗り', desc: 'ニックネームを設定する', check: () => true },

  // 使った本数マイルストーン
  { id: 'used_3', icon: '📦', name: '駆け出しコレクター', desc: '使った本数3本達成', check: (cs) => titleUsedCount(cs) >= 3 },
  { id: 'used_7', icon: '📦', name: '成長中', desc: '使った本数7本達成', check: (cs) => titleUsedCount(cs) >= 7 },
  { id: 'used_15', icon: '📦', name: '中堅コレクター', desc: '使った本数15本達成', check: (cs) => titleUsedCount(cs) >= 15 },
  { id: 'used_20', icon: '📦', name: '愛好家', desc: '使った本数20本達成', check: (cs) => titleUsedCount(cs) >= 20 },
  { id: 'used_25', icon: '📦', name: '探求者', desc: '使った本数25本達成', check: (cs) => titleUsedCount(cs) >= 25 },
  { id: 'used_40', icon: '📦', name: '練達の域', desc: '使った本数40本達成', check: (cs) => titleUsedCount(cs) >= 40 },
  { id: 'used_60', icon: '📦', name: '熟練コレクター', desc: '使った本数60本達成', check: (cs) => titleUsedCount(cs) >= 60 },
  { id: 'used_75', icon: '📦', name: '達人', desc: '使った本数75本達成', check: (cs) => titleUsedCount(cs) >= 75 },
  { id: 'used_90', icon: '📦', name: '極める者', desc: '使った本数90本達成', check: (cs) => titleUsedCount(cs) >= 90 },
  { id: 'used_120', icon: '📦', name: '殿堂入り', desc: '使った本数120本達成', check: (cs) => titleUsedCount(cs) >= 120 },

  // 気になる件数マイルストーン
  { id: 'interested_3', icon: '👀', name: '気になるさんいらっしゃい', desc: '気になるを3件登録する', check: (cs) => titleInterestedCount(cs) >= 3 },
  { id: 'interested_5', icon: '👀', name: '目移り中', desc: '気になるを5件登録する', check: (cs) => titleInterestedCount(cs) >= 5 },
  { id: 'interested_10', icon: '👀', name: 'リスト充実', desc: '気になるを10件登録する', check: (cs) => titleInterestedCount(cs) >= 10 },
  { id: 'interested_20', icon: '👀', name: '物色家', desc: '気になるを20件登録する', check: (cs) => titleInterestedCount(cs) >= 20 },
  { id: 'interested_30', icon: '👀', name: 'ウィンドウショッパー', desc: '気になるを30件登録する', check: (cs) => titleInterestedCount(cs) >= 30 },
  { id: 'interested_50', icon: '👀', name: '気になる収集家', desc: '気になるを50件登録する', check: (cs) => titleInterestedCount(cs) >= 50 },
  { id: 'interested_75', icon: '👀', name: '際限なきリスト', desc: '気になるを75件登録する', check: (cs) => titleInterestedCount(cs) >= 75 },
  { id: 'interested_100', icon: '👀', name: '気になるコンプリート', desc: '気になるを100件登録する', check: (cs) => titleInterestedCount(cs) >= 100 },

  // 評価関連
  { id: 'rating_two', icon: '⭐', name: '率直な評価', desc: '★2をつける', check: (cs) => titleRatingCount(cs, 2) >= 1 },
  { id: 'rating_three', icon: '⭐', name: 'バランス評価', desc: '★3をつける', check: (cs) => titleRatingCount(cs, 3) >= 1 },
  { id: 'rating_four', icon: '⭐', name: '高評価派', desc: '★4をつける', check: (cs) => titleRatingCount(cs, 4) >= 1 },
  { id: 'five_star_5', icon: '🌟', name: '満点マイスター', desc: '★5を5回つける', check: (cs) => titleRatingCount(cs, 5) >= 5 },
  { id: 'five_star_10', icon: '🌟', name: '満点コレクター', desc: '★5を10回つける', check: (cs) => titleRatingCount(cs, 5) >= 10 },
  { id: 'one_star_3', icon: '💧', name: '厳しい目', desc: '★1を3回つける', check: (cs) => titleRatingCount(cs, 1) >= 3 },

  // レビュー関連
  { id: 'review_5', icon: '✍️', name: 'レビュアー見習い', desc: 'ひとことレビューを5件書く', check: (cs) => titleReviewTextCount(cs) >= 5 },
  { id: 'review_10', icon: '✍️', name: 'レビュアー', desc: 'ひとことレビューを10件書く', check: (cs) => titleReviewTextCount(cs) >= 10 },
