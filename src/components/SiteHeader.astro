---
// 全ページ共通のナビゲーションバー。ロゴ・主要ページへのリンク・
// ログイン状態表示(authHeader.jsのmountAuthArea)をまとめている。
// スマホ幅では上部のナビ(.site-nav)は隠し、代わりに画面下部に
// 追尾する.site-bottom-navを表示する(global.cssのメディアクエリで切り替え)。
// 下部バーには「ホーム」は含めない(ロゴタップでホームに戻れるため)。
//
// ヘッダー自体はposition: stickyにした上で、スクロール方向に応じて
// 表示/非表示を切り替える(下にスクロール中は隠す、上にスクロールしたり
// 止まったりしたら再表示する)。ホームに戻れなくなる問題への対応。
---

<header class="site-header">
  <a href="/" class="site-logo">オナホめも</a>
  <nav class="site-nav">
    <a href="/">ホーム</a>
    <a href="/#rankings">ランキング</a>
    <a href="/?sale=1">セール中</a>
    <a href="/mypage">マイページ</a>
    <a href="/following">フォロー中</a>
  </nav>
  <div id="site-auth-area" class="site-auth-area"></div>
</header>

<nav class="site-bottom-nav">
  <a href="/#rankings" class="site-bottom-nav-item">
    <svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20V11M12 20V4M20 20v-6" /></svg>
    <span>ランキング</span>
  </a>
  <a href="/?sale=1" class="site-bottom-nav-item">
    <svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.6 13.4 12.6 21.4a2 2 0 0 1-2.8 0l-7.2-7.2a2 2 0 0 1 0-2.8l8-8H18a2 2 0 0 1 2 2v6a2 2 0 0 1-.6 1.4Z" /><circle cx="14.5" cy="7.5" r="1.1" fill="currentColor" stroke="none" /></svg>
    <span>セール中</span>
  </a>
  <a href="/mypage" class="site-bottom-nav-item">
    <svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="3.4" /><path d="M4.7 20c1.4-3.9 4.8-5.4 7.3-5.4s5.9 1.5 7.3 5.4" /></svg>
    <span>マイページ</span>
  </a>
  <a href="/following" class="site-bottom-nav-item">
    <svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8.2" r="2.9" /><path d="M2.6 19.6c1-3.1 3.8-4.7 6.4-4.7s5.4 1.6 6.4 4.7" /><circle cx="17" cy="7.3" r="2.2" /><path d="M15.7 11.7c1.9.3 3.7 1.7 4.5 4.1" /></svg>
    <span>フォロー中</span>
  </a>
</nav>

<script>
  import { mountAuthArea } from '../lib/authHeader.js';

  mountAuthArea(document.getElementById('site-auth-area'));

  const header = document.querySelector('.site-header');
  if (header) {
    let lastY = window.scrollY;
    let ticking = false;
    let idleTimer;
    const SCROLL_THRESHOLD = 8;

    const showHeader = () => header.classList.remove('site-header-hidden');
    const hideHeader = () => header.classList.add('site-header-hidden');

    function handleScroll() {
      const currentY = window.scrollY;
      const diff = currentY - lastY;

      if (currentY <= header.offsetHeight) {
        showHeader();
      } else if (diff > SCROLL_THRESHOLD) {
        hideHeader();
      } else if (diff < -SCROLL_THRESHOLD) {
        showHeader();
      }
      lastY = currentY;

      // スクロールが止まったら常にヘッダーを再表示する
      clearTimeout(idleTimer);
      idleTimer = setTimeout(showHeader, 400);
    }

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          window.requestAnimationFrame(() => {
            handleScroll();
            ticking = false;
          });
          ticking = true;
        }
      },
      { passive: true }
    );
  }
</script>
