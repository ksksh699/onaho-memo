---
import { supabase } from '../../lib/supabase.js';
import '../../styles/global.css';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';

// 商品数が非常に多い(4000件超)ため、ビルド時に全ページを事前生成すると
// デプロイに膨大な時間がかかる。そのため事前生成はせず、リクエストごとに
// その場でSupabaseから該当商品を取得する(SSR)方式にしている。
const { id } = Astro.params;
const { data: product } = await supabase
  .from('products')
  .select('*')
  .eq('dmm_content_id', id)
  .eq('is_onahole', true)
  .maybeSingle();

if (!product) {
  return Astro.redirect('/');
}

const rawData = product.raw_data ?? {};
const directories = rawData.directory ?? [];
const stockLabels = {
  stock: '在庫あり',
  reserve: '予約受付中',
  reserve_end: '予約終了',
  soldout: '販売終了',
  maker_stock: '取り寄せ',
};
const stock = rawData.stock;
const stockLabel = stockLabels[stock] ?? stock;
const imageUrlSmall = rawData.imageURL?.list ?? product.image_url;
// 一覧用サムネイル(90x120程度)は詳細ページで引き伸ばすとぼやけるため、
// DMMの命名規則(...pt.jpg → ...pl.jpg)で高解像度版を推測して優先表示する。
// 存在しない場合はクライアント側のonerrorで元のサムネイルに自動フォールバックする。
const imageUrlLarge = imageUrlSmall ? imageUrlSmall.replace(/pt\.jpg(\?.*)?$/, 'pl.jpg$1') : imageUrlSmall;
const imageUrl = imageUrlLarge;
const listPrice = rawData.prices?.list_price ? Number(rawData.prices.list_price) : null;
const hasDiscount = listPrice && product.price && listPrice > product.price;
const discountPercent = hasDiscount ? Math.round((1 - product.price / listPrice) * 100) : null;

// 以下3つはお互いに依存しない問い合わせなので、Promise.allでまとめて並列実行する
const [publicReviewsResult, ratingResult, onakingLinkResult] = await Promise.all([
  supabase
    .from('checks')
    .select(
      'id, user_id, rating, review_title, review_text, tier, updated_at, item_ratings, detail_review_title, detail_review_text, review_images, retirement_reason, similar_products'
    )
    .eq('product_id', product.id)
    .eq('is_public', true)
    .or(
      'review_text.not.is.null,detail_review_text.not.is.null,rating.not.is.null,item_ratings.not.is.null,review_images.not.is.null,similar_products.not.is.null'
    )
    .order('updated_at', { ascending: false }),
  supabase.rpc('get_product_ratings', { product_ids: [product.id] }),
  supabase
    .from('onaking_links')
    .select('onaking_url')
    .eq('product_id', product.id)
    .maybeSingle(),
]);

const { data: publicReviews } = publicReviewsResult;

// レビューへの「いいね」数(誰が押したかはクライアント側でセッションを見て判定する)
const reviewIds = (publicReviews ?? []).map((r) => r.id);
let reviewLikeCounts = {};
if (reviewIds.length > 0) {
  const { data: likeCountRows } = await supabase.rpc('get_review_like_counts', {
    check_ids: reviewIds,
  });
  for (const row of likeCountRows ?? []) {
    reviewLikeCounts[row.check_id] = row.like_count;
  }
}

// レビューへのコメント(質問・回答用)。公開レビューにのみ紐づく
let commentsByCheckId = {};
if (reviewIds.length > 0) {
  const { data: commentRows } = await supabase
    .from('review_comments')
    .select('id, check_id, user_id, body, created_at')
    .in('check_id', reviewIds)
    .order('created_at', { ascending: true });
  for (const c of commentRows ?? []) {
    if (!commentsByCheckId[c.check_id]) commentsByCheckId[c.check_id] = [];
    commentsByCheckId[c.check_id].push(c);
  }
}

// レビュー投稿者・コメント投稿者のニックネームは、プロフィールを公開設定にしている人の分だけ表示する
// (checksとprofilesの間に外部キー関係がないため、埋め込みselectではなく手動で結合する)
const reviewerIds = (publicReviews ?? []).map((r) => r.user_id);
const commentUserIds = Object.values(commentsByCheckId)
  .flat()
  .map((c) => c.user_id);
const allUserIds = [...new Set([...reviewerIds, ...commentUserIds].filter(Boolean))];
let reviewerNicknames = {};
if (allUserIds.length > 0) {
  const { data: reviewerProfiles } = await supabase
    .from('profiles')
    .select('id, nickname')
    .in('id', allUserIds)
    .eq('is_public', true)
    .not('nickname', 'is', null);
  for (const p of reviewerProfiles ?? []) {
    reviewerNicknames[p.id] = p.nickname;
  }
}

const TIER_LABELS_DISPLAY = { first: '一軍', second: '二軍', retired: '引退' };
const ITEM_LABELS_DISPLAY = {
  overall: '総合評価',
  cost_performance: 'コスパ',
  tightness: '締めつけ',
  pleasure: '気持ちよさ',
  stimulation: '刺激強度',
  fidelity: 'メーカー説明一致度',
  durability: '耐久性',
};
const ratingData = ratingResult.data;
const productRating = ratingData?.[0];

const releaseDateDisplay = product.release_date_text || product.release_date;

const onakingLinkData = onakingLinkResult.data;
const onakingUrl = onakingLinkData?.onaking_url ?? null;

// 他ショップの購入リンク・価格比較。
// 取り扱いの有無にかかわらず、常に8サイト全てを固定の順番で表示する
// (取り扱いがあるサイトだけを出す方式だと、リンクの貼り忘れに気付けないため)。
// 取り扱いがない(該当する{shop}_urlが未登録の)サイトは、そのサイトのトップページへ
// リンクし、価格は「不明」と表示する。
// トップページのURLは可能な限りアフィリエイトリンク化してある(踏んだ時点で成果対象になるように)。
// - FANZA: DMMの「lurlに好きなURLを渡すとaf_id付きでリダイレクトしてくれる」汎用アフィリエイトリンクの仕組みを利用
// - 信長トイズ: e-click(共通ASP)の「urlパラメータに好きな遷移先を渡せる」リダイレクト形式を利用
// - 大魔王・NLS: それぞれ自社の /jump/{id}/ , /access.php?agency_id={id} が、商品を指定しない場合はトップページへ
//   リダイレクトすることを実際に動作確認して採用
// - ぴゅあらば・ホットパワーズ・エムズ(BannerBridge)、M-ZAKKA(afb)は、既存の商品リンクと同様に
//   「トップページ用のリンクを1本、各社の管理画面で新規発行する」以外の方法がない(URLの汎用リダイレクトが
//   効かないことを実際に確認済み)。管理画面から発行してもらい次第、ここをアフィリエイトリンクに差し替える。
const SHOP_DEFS = [
  {
    key: 'fanza',
    name: 'FANZA',
    urlField: 'affiliate_url',
    priceField: 'price',
    topUrl:
      'https://al.fanza.co.jp/?lurl=' +
      encodeURIComponent('https://www.dmm.co.jp/mono/goods/') +
      '&af_id=onakingcom-990&ch=api',
  },
  {
    key: 'pyuarabu',
    name: 'ぴゅあらばショップ',
    urlField: 'pyuarabu_url',
    priceField: 'pyuarabu_price',
    topUrl: 'https://purelovers-shop.com/', // TODO: BannerBridge管理画面でトップページ用リンクを発行後、差し替え
  },
  {
    key: 'nls',
    name: 'NLS',
    urlField: 'nls_url',
    priceField: 'nls_price',
    topUrl: 'https://www.e-nls.com/access.php?agency_id=af952539-mem',
  },
  {
    key: 'daimaoh',
    name: '大魔王',
    urlField: 'daimaoh_url',
    priceField: 'daimaoh_price',
    topUrl: 'https://daimaoh.co.jp/jump/zl361209-ohm/',
  },
  {
    key: 'mzakka',
    name: 'M-ZAKKA',
    urlField: 'mzakka_url',
    priceField: 'mzakka_price',
    topUrl: 'https://mzakka.com/', // TODO: afb管理画面でトップページ用リンクを発行後、差し替え
  },
  {
    key: 'hotpowers',
    name: 'ホットパワーズ',
    urlField: 'hotpowers_url',
    priceField: 'hotpowers_price',
    topUrl: 'https://hotpowers.jp/', // TODO: BannerBridge管理画面でトップページ用リンクを発行後、差し替え
  },
  {
    key: 'nobunagatoys',
    name: '信長トイズ',
    urlField: 'nobunagatoys_url',
    priceField: 'nobunagatoys_price',
    topUrl:
      'https://www.e-click.jp/redirects/direct/33655/4171/?url=' +
      'https%3A//www.nobunaga-toys.com/',
  },
  {
    key: 'ems',
    name: 'エムズ',
    urlField: 'ems_url',
    priceField: 'ems_price',
    topUrl: 'https://www.ms-online.co.jp/', // TODO: BannerBridge管理画面でトップページ用リンクを発行後、差し替え
  },
];

const orderedShopLinks = SHOP_DEFS.map((def) => {
  const hasListing = Boolean(product[def.urlField]);
  return {
    key: def.key,
    name: def.name,
    hasListing,
    price: hasListing ? product[def.priceField] : null,
    url: hasListing ? product[def.urlField] : def.topUrl,
  };
});

// 「最安」バッジは、実際に価格が判明している(取り扱いがある)サイトの中でのみ判定する
const knownPriceLinks = orderedShopLinks.filter((s) => s.hasListing && s.price != null);
const cheapestPrice = knownPriceLinks.reduce((min, s) => (s.price < min ? s.price : min), Infinity);
const showCheapestBadge = knownPriceLinks.length > 1;
const cheapestIndex = showCheapestBadge
  ? orderedShopLinks.findIndex((s) => s.hasListing && s.price === cheapestPrice)
  : -1;

// 最初はFANZAのみ表示し、タップで残り7サイトを開けるようにする
const SHOP_LINKS_VISIBLE = 1;
const visibleShopLinks = orderedShopLinks.slice(0, SHOP_LINKS_VISIBLE);
const moreShopLinks = orderedShopLinks.slice(SHOP_LINKS_VISIBLE);
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#2b5fad" />
    <title>{product.name}</title>
  </head>
  <body>
    <SiteHeader />
    <main class="detail">
      <h1 class="detail-title">{product.name}</h1>
      <div class="detail-grid">
        <img
          src={imageUrl}
          alt={product.name}
          data-fallback={imageUrlSmall}
          onerror="if(this.src!==this.dataset.fallback){this.onerror=null;this.src=this.dataset.fallback;}"
        />
        <div class="detail-info">
          <p class="maker">
            {product.maker ? (
              <a href={`/?maker=${encodeURIComponent(product.maker)}`} class="maker-link">
                {product.maker}
              </a>
            ) : (
              'メーカー不明'
            )}
          </p>
          {product.is_manual && <p class="manual-badge">FANZA未掲載</p>}

          <button
            type="button"
            class="site-rating-link"
            id="site-rating-link"
            aria-label="オナホめも評価を見る。タップすると自分の評価も記録できます"
          >
            <span class="site-rating-label">オナホめも評価</span>
            <span class="site-rating-value">
              {productRating
                ? `${'★'.repeat(Math.round(productRating.avg_rating))}${'☆'.repeat(5 - Math.round(productRating.avg_rating))} ${productRating.avg_rating}点(${productRating.rating_count}件)`
                : 'まだ評価がありません。タップして記録する'}
            </span>
          </button>

          {directories.length > 0 && (
            <ul class="spec-list">
              {directories.map((d) => (
                <li>{d.name}</li>
              ))}
            </ul>
          )}

          {stock && (
            <p class="stock">
              {stockLabel}
            </p>
          )}
          {releaseDateDisplay && <p>発売日: {releaseDateDisplay}</p>}
          {product.dmm_review_average && (
            <p>
              <a href={product.affiliate_url} target="_blank" rel="noopener nofollow" class="fanza-review-link">
                FANZAレビュー: {product.dmm_review_average}点({product.dmm_review_count}件)
              </a>
            </p>
          )}
        </div>
      </div>

      <div class="detail-actions">
          {product.manual_note && <p class="manual-note">{product.manual_note}</p>}

          <div class="shop-links">
              <p class="shop-links-title">購入サイトを比較(価格は税込)</p>
              {hasDiscount && (
                <p class="shop-links-ref-price">
                  参考価格: <span class="shop-links-ref-price-value">¥{listPrice.toLocaleString()}</span>
                </p>
              )}
              <ul class="shop-links-list">
                {visibleShopLinks.map((s, i) => (
                  <li class={`shop-link-item ${i === cheapestIndex ? 'cheapest' : ''}`}>
                    <a href={s.url} target="_blank" rel="noopener nofollow" class="shop-link">
                      <span class="shop-link-name">{s.name}</span>
                      <span class="shop-link-price">
                        {s.hasListing ? (s.price ? `¥${s.price.toLocaleString()}` : '価格情報なし') : '不明'}
                        {s.key === 'fanza' && s.hasListing && hasDiscount && (
                          <span class="discount-badge-small">{discountPercent}%OFF</span>
                        )}
                      </span>
                      {i === cheapestIndex && <span class="shop-link-badge">最安</span>}
                    </a>
                  </li>
                ))}
              </ul>
              {moreShopLinks.length > 0 && (
                <details class="shop-links-more">
                  <summary>他{moreShopLinks.length}サイトを見る</summary>
                  <ul class="shop-links-list">
                    {moreShopLinks.map((s, i) => (
                      <li class={`shop-link-item ${i + visibleShopLinks.length === cheapestIndex ? 'cheapest' : ''}`}>
                        <a href={s.url} target="_blank" rel="noopener nofollow" class="shop-link">
                          <span class="shop-link-name">{s.name}</span>
                          <span class="shop-link-price">
                            {s.hasListing ? (s.price ? `¥${s.price.toLocaleString()}` : '価格情報なし') : '不明'}
                          </span>
                          {i + visibleShopLinks.length === cheapestIndex && (
                            <span class="shop-link-badge">最安</span>
                          )}
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              )}
            </div>

          <div id="check-widget" class="check-widget" data-product-id={product.id}>
            <p class="check-loading">読み込み中...</p>
          </div>

          <div id="folder-add-widget" class="folder-add-widget"></div>
      </div>

      {onakingUrl && (
        <p class="onaking-link-block">
          <a href={onakingUrl} target="_blank" rel="noopener" class="onaking-review-link">
            📖 オナ王でレビュー済み(記事を読む)
          </a>
        </p>
      )}
      <div id="onaking-admin-widget" class="onaking-admin-widget"></div>

      <section class="public-reviews">
        <h2 class="section-title">みんなのレビュー</h2>
        {(!publicReviews || publicReviews.length === 0) && (
          <p class="no-reviews">まだ公開レビューがありません。</p>
        )}
        <ul class="review-list">
          {publicReviews?.map((r) => (
            <li class="review-item">
              <div class="review-item-header">
                {reviewerNicknames[r.user_id] && (
                  <a href={`/users/${encodeURIComponent(reviewerNicknames[r.user_id])}`} class="review-author">
                    {reviewerNicknames[r.user_id]}
                  </a>
                )}
                {r.rating && (
                  <span class="review-stars">{'★'.repeat(r.rating)}{'☆'.repeat(5 - r.rating)}</span>
                )}
                {r.tier && <span class="review-tier">{TIER_LABELS_DISPLAY[r.tier]}</span>}
              </div>
              {r.item_ratings && (
                <div class="review-item-ratings">
                  {Object.entries(ITEM_LABELS_DISPLAY).map(([key, label]) => (
                    r.item_ratings[key] ? (
                      <span class="review-item-rating">
                        {label} {'★'.repeat(r.item_ratings[key])}{'☆'.repeat(5 - r.item_ratings[key])}
                      </span>
                    ) : null
                  ))}
                </div>
              )}
              {r.review_text && (
                <div class="review-body-block">
                  {r.review_title && <p class="review-body-title">{r.review_title}</p>}
                  <p class="review-body">{r.review_text}</p>
                </div>
              )}
              {r.detail_review_text && (
                <div class="review-body-block review-detail-block">
                  {r.detail_review_title && <p class="review-body-title">{r.detail_review_title}</p>}
                  <p class="review-body review-detail-body" set:html={r.detail_review_text} />
                </div>
              )}
              {r.review_images?.length > 0 && (
                <div class="review-images-grid">
                  {r.review_images.map((url) => (
                    <a href={url} target="_blank" rel="noopener">
                      <img src={url} alt="レビュー画像" loading="lazy" />
                    </a>
                  ))}
                </div>
              )}
              {r.tier === 'retired' && r.retirement_reason && (
                <p class="review-retirement">手放した理由: {r.retirement_reason}</p>
              )}
              {r.similar_products && (
                <p class="review-similar">似てるオナホール: {r.similar_products}</p>
              )}
              {r.updated_at && (
                <p class="review-item-date">{new Date(r.updated_at).toLocaleDateString('ja-JP')}</p>
              )}
              <button type="button" class="review-like-btn" data-check-id={r.id}>
                <span class="review-like-icon">♡</span>
                <span class="review-like-count">{reviewLikeCounts[r.id] ?? 0}</span>
              </button>

              <div class="review-comments" data-check-id={r.id} data-review-user-id={r.user_id}>
                {(commentsByCheckId[r.id] ?? []).length > 0 && (
                  <ul class="review-comment-list">
                    {(commentsByCheckId[r.id] ?? []).map((c) => (
                      <li class="review-comment-item" data-comment-id={c.id} data-comment-user-id={c.user_id}>
                        <span class="review-comment-author">{reviewerNicknames[c.user_id] ?? '匿名ユーザー'}</span>
                        <p class="review-comment-body">{c.body}</p>
                        <button type="button" class="review-comment-delete-btn" data-comment-id={c.id} style="display:none;">
                          削除
                        </button>
                      </li>
                    ))}
                  </ul>
                )}
                <div class="review-comment-form">
                  <textarea class="review-comment-input" placeholder="質問や感想を書く" maxlength="300"></textarea>
                  <button type="button" class="review-comment-submit-btn" data-check-id={r.id}>コメントする</button>
                </div>
              </div>
            </li>
          ))}
        </ul>
      </section>
    </main>
    <SiteFooter />
  </body>
  <script>
      import { supabase } from '../../lib/supabase.js';
      import { compressImage } from '../../lib/imageCompress.js';

      const widget = document.getElementById('check-widget');
      const productId = widget.dataset.productId;

      const STATUS_LABELS = {
        interested: '気になる',
        used: '使った',
      };
      const TIER_LABELS = {
        first: '一軍',
        second: '二軍',
        retired: '引退',
      };
      const ITEM_LABELS = {
        overall: '総合評価',
        cost_performance: 'コスパ',
        tightness: '締めつけ',
        pleasure: '気持ちよさ',
        stimulation: '刺激強度',
        fidelity: 'メーカー説明一致度',
        durability: '耐久性',
      };
      const IMAGE_BUCKET = 'review-images';
      const MAX_IMAGES = 4;
      const ADMIN_USER_ID = '278377ee-a457-41bc-ab79-c1be9f4b768e';

      const onakingAdminWidget = document.getElementById('onaking-admin-widget');

      function renderOnakingAdminWidget(currentUrl) {
        if (!onakingAdminWidget) return;
        onakingAdminWidget.innerHTML = `
          <div class="onaking-admin-panel">
            <label class="field-label">オナ王の記事URL(管理用)</label>
            <input type="text" id="onaking-url-input" class="nickname-input" placeholder="https://ona-king.com/..." value="${currentUrl}" />
            <button type="button" id="onaking-url-save-btn" class="best-one-clear-btn">保存</button>
            ${currentUrl ? '<button type="button" id="onaking-url-clear-btn" class="best-one-clear-btn">削除</button>' : ''}
            <p id="onaking-url-status" class="save-status"></p>
          </div>
        `;
      }

      async function initOnakingAdminWidget() {
        if (!onakingAdminWidget) return;

        const { data: { session } } = await supabase.auth.getSession();
        if (!session || session.user.id !== ADMIN_USER_ID) {
          onakingAdminWidget.innerHTML = '';
          return;
        }

        const { data } = await supabase
          .from('onaking_links')
          .select('onaking_url')
          .eq('product_id', productId)
          .maybeSingle();

        renderOnakingAdminWidget(data?.onaking_url ?? '');
      }

      if (onakingAdminWidget) {
        onakingAdminWidget.addEventListener('click', async (e) => {
          const statusEl = document.getElementById('onaking-url-status');

          if (e.target.closest('#onaking-url-save-btn')) {
            const input = document.getElementById('onaking-url-input');
            const url = input.value.trim();
            if (!url) {
              statusEl.textContent = 'URLを入力してください';
              return;
            }
            const { error } = await supabase.from('onaking_links').upsert(
              { product_id: productId, onaking_url: url, updated_at: new Date().toISOString() },
              { onConflict: 'product_id' }
            );
            if (error) {
              console.error(error);
              statusEl.textContent = '保存に失敗しました';
              return;
            }
            statusEl.textContent = '保存しました。反映のためページを再読み込みします...';
            setTimeout(() => location.reload(), 600);
            return;
          }

          if (e.target.closest('#onaking-url-clear-btn')) {
            const { error } = await supabase.from('onaking_links').delete().eq('product_id', productId);
            if (error) {
              console.error(error);
              statusEl.textContent = '削除に失敗しました';
              return;
            }
            statusEl.textContent = '削除しました。反映のためページを再読み込みします...';
            setTimeout(() => location.reload(), 600);
          }
        });
      }

      const folderWidget = document.getElementById('folder-add-widget');
      let userFolders = [];
      let folderMembership = new Set();
      let folderPanelOpen = false;

      function folderAddWidgetHtml() {
        if (!folderPanelOpen) {
          return `<button type="button" id="folder-add-toggle-btn" class="folder-add-toggle-btn">📁 フォルダに追加</button>`;
        }

        const checkboxesHtml = userFolders.length
          ? userFolders
              .map(
                (f) => `
            <label class="folder-checkbox-row">
              <input type="checkbox" class="folder-add-checkbox" data-folder-id="${f.id}" ${folderMembership.has(f.id) ? 'checked' : ''} />
              ${f.name}
            </label>
          `
              )
              .join('')
          : `<p class="badge-empty">まだフォルダがありません。下から新しく作れます。</p>`;

        return `
          <div class="folder-add-panel">
            <p class="field-label">フォルダに追加</p>
            <div class="folder-checkbox-list">${checkboxesHtml}</div>
            <div class="folder-add-new">
              <input type="text" id="new-folder-name-inline" class="nickname-input" maxlength="30" placeholder="新しいフォルダ名" />
              <button type="button" id="create-folder-inline-btn" class="best-one-clear-btn">＋ 作成して追加</button>
            </div>
            <button type="button" id="folder-add-close-btn" class="folder-add-close-btn">閉じる</button>
          </div>
        `;
      }

      function renderFolderWidget() {
        if (!folderWidget) return;
        folderWidget.innerHTML = folderAddWidgetHtml();
      }

      async function loadUserFolders(userId) {
        const { data, error } = await supabase
          .from('folders')
          .select('id, name, sort_order, folder_items(product_id)')
          .eq('user_id', userId)
          .order('sort_order', { ascending: true });

        if (error) {
          console.error(error);
          return [];
        }
        return data ?? [];
      }

      async function initFolderWidget() {
        if (!folderWidget) return;

        const { data: { session } } = await supabase.auth.getSession();
        if (!session) {
          folderWidget.innerHTML = '';
          return;
        }

        userFolders = await loadUserFolders(session.user.id);
        folderMembership = new Set(
          userFolders
            .filter((f) => (f.folder_items ?? []).some((fi) => fi.product_id === productId))
            .map((f) => f.id)
        );
        renderFolderWidget();
      }

      if (folderWidget) {
        folderWidget.addEventListener('click', async (e) => {
          if (e.target.closest('#folder-add-toggle-btn')) {
            folderPanelOpen = true;
            renderFolderWidget();
            return;
          }

          if (e.target.closest('#folder-add-close-btn')) {
            folderPanelOpen = false;
            renderFolderWidget();
            return;
          }

          const createBtn = e.target.closest('#create-folder-inline-btn');
          if (createBtn) {
            const input = document.getElementById('new-folder-name-inline');
            const name = input.value.trim();
            if (!name) return;

            const { data: { session } } = await supabase.auth.getSession();
            if (!session) return;

            const maxOrder = userFolders.reduce((m, f) => Math.max(m, f.sort_order ?? 0), -1);
            const { data: newFolder, error } = await supabase
              .from('folders')
              .insert({ user_id: session.user.id, name, sort_order: maxOrder + 1 })
              .select('id')
              .single();

            if (error || !newFolder) {
              console.error(error);
              return;
            }

            const { error: itemError } = await supabase
              .from('folder_items')
              .insert({ folder_id: newFolder.id, product_id: productId });
            if (itemError) console.error(itemError);

            await initFolderWidget();
            folderPanelOpen = true;
            renderFolderWidget();
          }
        });

        folderWidget.addEventListener('change', async (e) => {
          const checkbox = e.target.closest('.folder-add-checkbox');
          if (!checkbox) return;
          const folderId = checkbox.dataset.folderId;

          if (checkbox.checked) {
            const { error } = await supabase
              .from('folder_items')
              .insert({ folder_id: folderId, product_id: productId });
            if (error) {
              console.error(error);
              checkbox.checked = false;
            } else {
              folderMembership.add(folderId);
            }
          } else {
            const { error } = await supabase
              .from('folder_items')
              .delete()
              .eq('folder_id', folderId)
              .eq('product_id', productId);
            if (error) {
              console.error(error);
              checkbox.checked = true;
            } else {
              folderMembership.delete(folderId);
            }
          }
        });
      }

      function renderLoggedOut() {
        widget.innerHTML = `
          <p class="check-hint">ログインすると、チェックや評価を記録できます。</p>
          <a href="/login" class="auth-btn">ログインする</a>
        `;
      }

      function getStoragePathFromUrl(url) {
        const marker = `/object/public/${IMAGE_BUCKET}/`;
        const idx = url.indexOf(marker);
        return idx === -1 ? null : url.slice(idx + marker.length);
      }

      function renderForm(existing) {
