---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#2b5fad" />
    <title>新規登録 | オナホめも</title>
  </head>
  <body>
    <SiteHeader />
    <main class="login-main">
      <h1>新規登録</h1>
      <p>メールアドレスとパスワードでアカウントを作成します。</p>

      <form id="signup-form" class="auth-form">
        <label class="profile-edit-label" for="signup-email">メールアドレス</label>
        <input type="email" id="signup-email" class="nickname-input" required autocomplete="email" />

        <label class="profile-edit-label" for="signup-password">パスワード</label>
        <input type="password" id="signup-password" class="nickname-input" required autocomplete="new-password" minlength="8" aria-describedby="signup-password-rules" />
        <ul id="signup-password-rules" class="pw-rules" aria-label="パスワードの条件"></ul>

        <label class="profile-edit-label" for="signup-password-confirm">パスワード(確認)</label>
        <input type="password" id="signup-password-confirm" class="nickname-input" required autocomplete="new-password" minlength="8" />

        <button type="submit" class="btn-primary">登録する</button>
      </form>
      <p id="signup-status" class="nickname-status"></p>

      <p class="auth-form-links">すでにアカウントをお持ちの方は <a href="/login">ログイン</a></p>
    </main>

    <script>
      import { supabase } from '../lib/supabase.js';
      import { validatePassword, translateAuthPasswordError, mountPasswordRules } from '../lib/passwordRules.js';

      const form = document.getElementById('signup-form');
      const statusEl = document.getElementById('signup-status');
      const passwordInput = document.getElementById('signup-password');

      // パスワード条件(8文字以上・英字と数字を含む)のチェックリストを入力欄の下に出す
      mountPasswordRules(passwordInput, document.getElementById('signup-password-rules'));

      function setStatus(message, isError) {
        statusEl.textContent = message;
        statusEl.classList.toggle('auth-status-error', Boolean(isError));
      }

      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        const email = document.getElementById('signup-email').value.trim();
        const password = passwordInput.value;
        const passwordConfirm = document.getElementById('signup-password-confirm').value;

        const ruleError = validatePassword(password);
        if (ruleError) {
          setStatus(ruleError, true);
          passwordInput.focus();
          return;
        }

        if (password !== passwordConfirm) {
          setStatus('パスワードが一致しません。', true);
          return;
        }

        setStatus('登録中...', false);

        const { data, error } = await supabase.auth.signUp({
          email,
          password,
          options: { emailRedirectTo: window.location.origin },
        });

        if (error) {
          if (error.message.includes('already registered') || error.message.includes('User already registered')) {
            setStatus('このメールアドレスは既に登録されています。', true);
          } else if (translateAuthPasswordError(error.message)) {
            setStatus(translateAuthPasswordError(error.message), true);
          } else {
            setStatus('登録に失敗しました。しばらくしてから再度お試しください。', true);
            console.error(error);
          }
          return;
        }

        if (data.session) {
          // メール確認が不要な設定の場合、登録と同時にログインされる
          window.location.href = '/';
          return;
        }

        form.hidden = true;
        setStatus(
          '確認メールを送信しました。メール内のリンクをクリックすると登録が完了します。',
          false
        );
      });
    </script>
    <SiteFooter />
  </body>
</html>
