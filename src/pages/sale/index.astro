---
import { supabase } from '../../lib/supabase.js';
import '../../styles/global.css';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import ProductCards from '../../components/ProductCards.astro';
import ListingPager from '../../components/ListingPager.astro';
import ListingToolbar from '../../components/ListingToolbar.astro';
import {
  LISTING_SELECT, parsePage, pageRange, totalPages, setListingCacheHeaders, pageHref, fetchCampaignTags,
  parseListingFilters, applyListingFilters, applyListingSort, fetchListingFilterOptions, hasActiveFilters,
} from '../../lib/listing.js';

// セール中の商品一覧(2026-09-08)。URL: /sale/?page=N
// 条件はトップページの「セール対象のみ」フィルターと同じ(セール系タグが付いている商品)。
// 割引率の高い順に並べる(割引率が同じなら新着順)。
// 絞り込み(2026-09-08): ?q= &maker= &sort= などトップページと同じ条件をクエリで受け取る
const DEFAULT_SORT = 'discount_desc';
const page = parsePage(Astro.url.searchParams);
const [from, to] = pageRange(page);
const filters = parseListingFilters(Astro.url.searchParams, { defaultSort: DEFAULT_SORT });
const [campaignTags, filterOptions] = await Promise.all([fetchCampaignTags(), fetchListingFilterOptions()]);
const filtered = hasActiveFilters(filters) || filters.sort !== DEFAULT_SORT;

let products = [];
let count = 0;
if (campaignTags.length > 0) {
  let query = supabase
    .from('v_products_listing')
    .select(LISTING_SELECT, { count: 'exact' })
    .overlaps('genre_tags', campaignTags);
  query = applyListingFilters(query, { ...filters, sale: false }, { campaignTags });
  query = applyListingSort(query, filters.sort).range(from, to);
  const result = await query;
  products = result.data ?? [];
  count = result.count ?? 0;
}

// 「気になる」に登録した商品がセール中かどうかは、ログイン状態によって内容が変わる
// (=CDNキャッシュされるこのHTMLには含められない)ため、ブラウザ側スクリプトで
// ログイン中のユーザーだけ問い合わせて描画する(下の<script>を参照)。1ページ目にだけ表示する。

// セールは入れ替わりが早いので、他の一覧より短め(5分)にキャッシュ
setListingCacheHeaders(Astro.response);
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=300, stale-while-revalidate=1800');

const pages = totalPages(count);
const basePath = '/sale/';
const canonical = `https://onahomemo.com${pageHref(basePath, page)}`;
const maxDiscount = products[0]?.discount_percent ?? 0;
const title = `セール中のオナホ一覧(${count}件・割引率順)${page > 1 ? ` ${page}ページ目` : ''} | オナホめも`;
const description = `いまセール中のオナホール${count}件を割引率の高い順に表示${maxDiscount ? `(最大${maxDiscount}%OFF)` : ''}。価格・定価・レビューを確認して、各商品ページで8ショップの価格を比較できます。`;
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#2b5fad" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {filtered && <meta name="robots" content="noindex, follow" />}
    {page > 1 && <link rel="prev" href={`https://onahomemo.com${pageHref(basePath, page - 1)}`} />}
    {page < pages && <link rel="next" href={`https://onahomemo.com${pageHref(basePath, page + 1)}`} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content="セール中のオナホ一覧 | オナホめも" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="オナホめも" />
    <meta property="og:image" content="https://onahomemo.com/ogp.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@onahomemo" />
  </head>
  <body>
    <SiteHeader />
    <main class="listing-page">
      <nav class="breadcrumb" aria-label="パンくず"><a href="/">ホーム</a><span>›</span><span>セール中</span></nav>
      <h1 class="listing-title">セール中のオナホ一覧</h1>
      <p class="listing-lead">
        {count > 0
          ? `${count.toLocaleString('ja-JP')}件を割引率の高い順に表示${page > 1 ? `(${page} / ${pages}ページ)` : ''}。価格はFANZAの現在価格です。各商品ページで8ショップの価格を比較できます。`
          : 'いまセール中の商品はありません。'}
      </p>
      {page === 1 && !filtered && (
        <section id="watchlist-sale" class="price-drops" hidden>
          <h2 class="section-title">気になる商品がセール中</h2>
          <p class="listing-lead">あなたが「気になる」に登録した商品のうち、いまセール中のものです。</p>
          <ul id="watchlist-sale-list" class="grid listing-grid"></ul>
        </section>
      )}
      <ListingToolbar filters={filters} options={filterOptions} basePath={basePath} hideSale defaultSort={DEFAULT_SORT} resultCount={filtered ? count : null} />
      {filtered && products.length === 0 && <p class="listing-lead">条件に合う商品がありません。</p>}
      <ProductCards products={products} />
      <ListingPager basePath={basePath} current={page} total={pages} filters={filters} defaultSort={DEFAULT_SORT} />
    </main>
    <SiteFooter />
    <script>
      import { supabase } from '../../lib/supabase.js';
      import { isCampaignTag, isNewArrival, isPreorder } from '../../lib/listing.js';

      // 「気になる」に登録した商品のうち、いまセール中のものを表示する(2026-09-11)。
      // ログイン状態に依存するのでサーバー側では描画できない(CDNキャッシュされるため)。
      // ログインしていない・該当が無い場合は何も表示しない(セクションはhidden始まり)。
      const section = document.getElementById('watchlist-sale');
      const list = document.getElementById('watchlist-sale-list');
      if (section && list) {
        loadWatchlistSale();
      }

      async function loadWatchlistSale() {
        const { data: { session } } = await supabase.auth.getSession();
        if (!session) return;

        const { data: interested } = await supabase
          .from('checks')
          .select('product_id')
          .eq('user_id', session.user.id)
          .eq('status', 'interested');
        const productIds = (interested ?? []).map((r) => r.product_id);
        if (productIds.length === 0) return;

        const { data: products } = await supabase
          .from('v_products_listing')
          .select(
            'id, dmm_content_id, name, maker, price, image_url, release_date, genre_tags, dmm_review_average, dmm_review_count, site_rating_avg, site_rating_count, list_price, discount_percent'
          )
          .in('id', productIds);

        const onSale = (products ?? [])
          .filter((p) => (p.genre_tags ?? []).some((t) => isCampaignTag(t)))
          .sort((a, b) => (b.discount_percent ?? 0) - (a.discount_percent ?? 0));
        if (onSale.length === 0) return;

        list.innerHTML = onSale.map((p) => cardHtml(p)).join('');
        section.hidden = false;
      }

      function cardHtml(p) {
        const hasDiscount = p.discount_percent > 0;
        return `
          <li class="card">
            ${hasDiscount ? '<span class="sale-ribbon">SALE</span>' : ''}
            ${
              isPreorder(p.release_date)
                ? '<span class="new-badge preorder-badge">予約受付中</span>'
                : isNewArrival(p.release_date)
                  ? '<span class="new-badge">NEW</span>'
                  : ''
            }
            <a href="/products/${p.dmm_content_id}/">
              <img src="${p.image_url}" alt="${p.name}" loading="lazy" width="180" height="240" />
              <div class="body">
                <p class="maker">${p.maker ?? 'メーカー不明'}</p>
                <h3>${p.name}</h3>
                <p class="price">
                  ${p.price ? `¥${Number(p.price).toLocaleString('ja-JP')}` : '価格情報なし'}
                  ${hasDiscount ? `<span class="discount-badge-small">${p.discount_percent}%OFF</span>` : ''}
                </p>
                <div class="card-ratings">
                  ${
                    p.dmm_review_average
                      ? `<p class="card-rating dmm"><span class="rating-label">FANZA</span>★${p.dmm_review_average}(${p.dmm_review_count})</p>`
                      : ''
                  }
                  ${
                    p.site_rating_count > 0
                      ? `<p class="card-rating site"><span class="rating-label">オナホめも</span>★${p.site_rating_avg}(${p.site_rating_count})</p>`
                      : ''
                  }
                </div>
              </div>
            </a>
          </li>
        `;
      }
    </script>
  </body>
</html>
