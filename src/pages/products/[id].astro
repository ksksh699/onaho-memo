            <div class="item-ratings" id="item-ratings">
              ${Object.entries(ITEM_LABELS)
                .map(
                  ([key, label]) => `
                <div class="item-rating-row" data-item="${key}">
                  <span class="item-rating-label">${label}</span>
                  <span class="item-rating-stars">
                    ${[1, 2, 3, 4, 5]
                      .map(
                        (n) => `
                      <span class="star item-star ${n <= (itemRatings[key] ?? 0) ? 'filled' : ''}" data-item="${key}" data-rating="${n}">★</span>
                    `
