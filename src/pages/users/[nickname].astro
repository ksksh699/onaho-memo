            <div class="mp-status-panel" data-status-panel="interested">
              {groupedPublic.interested.length === 0 ? (
                <p class="mp-empty-tab">まだ気になるの商品がありません。</p>
              ) : (
                <>
                  <ul class="mp-grid mp-grid-compact" data-view-variant="grid" set:html={interestedCardsHtml} />
                  <ul class="mp-list" data-view-variant="list" hidden set:html={interestedRowsHtml} />
                </>
              )}
            </div>

            <div class="mp-status-panel" data-status-panel="used" hidden>
              {groupedPublic.used.length === 0 ? (
                <p class="mp-empty-tab">まだ使ったの商品がありません。</p>
              ) : (
                <>
                  <div class="mp-tier-tabs" id="profile-tier-tabs">
                    <button type="button" class="mp-tier-tab mp-tier-tab-active" data-tier="all">すべて({groupedPublic.used.length})</button>
                    <button type="button" class="mp-tier-tab" data-tier="first">一軍({usedByTierPublic.first.length})</button>
                    <button type="button" class="mp-tier-tab" data-tier="second">二軍({usedByTierPublic.second.length})</button>
                    <button type="button" class="mp-tier-tab" data-tier="retired">引退({usedByTierPublic.retired.length})</button>
                  </div>
                  <ul class="mp-grid mp-grid-compact" data-view-variant="grid" set:html={usedCardsHtml} />
                  <ul class="mp-list" data-view-variant="list" hidden set:html={usedRowsHtml} />
                  <p class="mp-empty-tab" id="profile-tier-empty" hidden>この絞り込みに該当する商品がありません。</p>
                </>
              )}
            </div>

            <div class="mp-status-panel" data-status-panel="folders" hidden>
              {publicFolders.length === 0 ? (
                <p class="mp-empty-tab">公開されているフォルダがありません。</p>
              ) : (
                <div class="folders-section">
                  <h2 class="folders-title">マイフォルダ</h2>
                  <div class="folder-list">
                    {publicFolders.map((folder) => {
                      const items = (folder.folder_items ?? []).filter((fi) => fi.products);
                      return (
                        <div class="folder-card">
                          <div class="folder-card-head">
                            <h3 class="folder-name">{folder.name}</h3>
                            <span class="folder-count">{items.length}件</span>
                          </div>
                          {items.length === 0 ? (
                            <p class="badge-empty">まだ商品が入っていません。</p>
                          ) : (
                            <ul class="folder-items-grid">
                              {items.map((fi) => (
                                <li class="folder-item-card">
                                  <a href={`/products/${fi.products.dmm_content_id}/`}>
                                    <img src={fi.products.image_url} alt={fi.products.name} loading="lazy" />
                                    <p class="folder-item-name">{fi.products.name}</p>
                                  </a>
                                </li>
                              ))}
                            </ul>
                          )}
                        </div>
                      );
                    })}
                  </div>
                </div>
              )}
            </div>
          </div>

          <div class="mp-main-panel" data-main-panel="oshi" hidden>
            {profile.oshi_maker && (
              <div class="oshi-maker-section">
                <h2 class="oshi-maker-title">推しメーカー</h2>
                <span class="badge-chip oshi-maker-chip">{profile.oshi_maker}</span>
                {profile.oshi_maker_reason && <p class="badge-detail">{profile.oshi_maker_reason}</p>}
              </div>
            )}

            {top3.length > 0 && (
              <div class="top3-section">
                <h2 class="top3-title">マイベストTOP3</h2>
                <div class="top3-grid">
                  {top3.map((slot) => (
                    <div class="top3-slot filled">
                      <span class="top3-rank">{slot.rank}位</span>
                      <a href={`/products/${slot.check.products.dmm_content_id}/`} class="top3-card">
                        <img src={slot.check.products.image_url} alt={slot.check.products.name} loading="lazy" />
                        <div class="top3-card-body">
                          <p class="mp-maker">{slot.check.products.maker ?? ''}</p>
                          <h3>{slot.check.products.name}</h3>
                        </div>
                      </a>
                      {slot.reason && <p class="top3-reason-text">{slot.reason}</p>}
                    </div>
                  ))}
                </div>
              </div>
            )}

            {!profile.oshi_maker && top3.length === 0 && (
              <p class="mp-empty">まだ推しメーカーやマイベスト3が設定されていません。</p>
            )}
          </div>

          <div class="mp-main-panel" data-main-panel="reviews" hidden>
            {bestReviewCheck && bestReviewCheck.products && (
              <div class="best-review-section">
                <h2 class="best-review-title">ベストな口コミ</h2>
                <a href={`/products/${bestReviewCheck.products.dmm_content_id}/`} class="best-review-product">
                  <img src={bestReviewCheck.products.image_url} alt={bestReviewCheck.products.name} loading="lazy" />
                  <div class="best-review-product-body">
                    <p class="mp-maker">{bestReviewCheck.products.maker ?? ''}</p>
                    <h3>{bestReviewCheck.products.name}</h3>
                  </div>
                </a>
                {bestReviewTitle && <p class="best-review-quote-title">{bestReviewTitle}</p>}
                {bestReviewIsDetail ? (
                  <p class="best-review-quote" set:html={bestReviewText} />
                ) : (
                  <p class="best-review-quote">{bestReviewText}</p>
                )}
                {bestReviewDateStr && <p class="review-item-date">{bestReviewDateStr}</p>}
              </div>
            )}

            <div class="reviews-list-section">
              <h2 class="reviews-list-title">口コミ一覧{publicReviews.length > 0 && `(${publicReviews.length}件)`}</h2>
              {publicReviews.length === 0 ? (
                <p class="badge-empty">まだ公開されている口コミがありません。</p>
              ) : (
                <ul class="reviews-list">
                  {publicReviews.map((c) => {
                    const p = c.products;
                    const isDetail = Boolean(c.detail_review_text);
                    const text = c.detail_review_text || c.review_text || '';
                    const title = isDetail ? c.detail_review_title : c.review_title;
                    const isBest = p.id === profile.best_review_product_id;
                    const dateStr = c.updated_at ? new Date(c.updated_at).toLocaleDateString('ja-JP') : '';
                    return (
                      <li class={`review-item ${isBest ? 'review-item-best' : ''}`}>
                        <a href={`/products/${p.dmm_content_id}/`} class="review-item-head">
                          <img src={p.image_url} alt={p.name} loading="lazy" />
                          <div class="review-item-head-body">
                            <p class="mp-maker">{p.maker ?? ''}</p>
                            <h3>{p.name}</h3>
                            <div class="mp-tags">
                              {c.rating && <span class="mp-tag">★{c.rating}</span>}
                              {c.tier && <span class="mp-tag">{TIER_LABELS[c.tier]}</span>}
                              {isBest && <span class="mp-tag mp-best">ベスト口コミ</span>}
                            </div>
                          </div>
                        </a>
                        {title && <p class="review-item-title">{title}</p>}
                        {isDetail ? (
                          <p class="review-item-text" set:html={text} />
                        ) : (
                          <p class="review-item-text">{text}</p>
                        )}
                        {dateStr && <p class="review-item-date">{dateStr}</p>}
                      </li>
                    );
                  })}
                </ul>
              )}
            </div>
          </div>

          <div class="mp-main-panel" data-main-panel="badges" hidden>
            <div class={`rank-hero ${rankTierClass}`}>
              <div class="rank-hero-crest">{rankCrest}</div>
              <div class="rank-hero-body">
                <p class="rank-hero-label">ランク</p>
                <p class="rank-hero-name">{rankName}</p>
                <div class="rank-hero-progress-track">
                  <div class="rank-hero-progress-fill" style={`width:${rankInfo.progressPercent}%`}></div>
                </div>
                <p class="rank-hero-progress-text">{rankProgressText}</p>
                <p class="rank-hero-breakdown">バッジ{badgeCount}個・称号{earnedTitleCount}個(計{totalEarnedForRank}個)</p>
              </div>
            </div>
            <div class="grid-density-toggle" id="profile-badges-view-toggle">
              <button type="button" class="density-tab" data-badges-view="card" aria-label="カード表示" title="カード表示">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                  <rect x="1" y="1" width="6.5" height="6.5" rx="1" fill="currentColor" />
                  <rect x="8.5" y="1" width="6.5" height="6.5" rx="1" fill="currentColor" />
                  <rect x="1" y="8.5" width="6.5" height="6.5" rx="1" fill="currentColor" />
                  <rect x="8.5" y="8.5" width="6.5" height="6.5" rx="1" fill="currentColor" />
                </svg>
              </button>
              <button type="button" class="density-tab" data-badges-view="grid" aria-label="グリッド表示" title="グリッド表示">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                  <rect x="1" y="1" width="4" height="4" rx="0.8" fill="currentColor" />
                  <rect x="6" y="1" width="4" height="4" rx="0.8" fill="currentColor" />
                  <rect x="11" y="1" width="4" height="4" rx="0.8" fill="currentColor" />
                  <rect x="1" y="6" width="4" height="4" rx="0.8" fill="currentColor" />
                  <rect x="6" y="6" width="4" height="4" rx="0.8" fill="currentColor" />
                  <rect x="11" y="6" width="4" height="4" rx="0.8" fill="currentColor" />
                  <rect x="1" y="11" width="4" height="4" rx="0.8" fill="currentColor" />
                  <rect x="6" y="11" width="4" height="4" rx="0.8" fill="currentColor" />
                  <rect x="11" y="11" width="4" height="4" rx="0.8" fill="currentColor" />
                </svg>
              </button>
            </div>
            <div class="badges-view-scope" id="profile-badges-view-scope">
              <div class="badge-chips-section">
                <h2 class="badge-chips-title">バッジ</h2>
                {badgeChipsHtml ? (
                  <div class="badge-chips-row" set:html={badgeChipsHtml} />
                ) : (
                  <p class="badge-empty">まだバッジがありません。1本使うと「はじめての一本」バッジがもらえます。</p>
                )}
              </div>

              <div class="titles-section">
                <h2 class="titles-title">称号(実績)</h2>
                <p class="badge-detail titles-count">称号 {earnedTitleCount}/{TITLES.length}個 獲得</p>
                <div class="title-grid" set:html={titleCardsHtml} />
              </div>
            </div>
          </div>
        </>
      )}
    </main>

    <script>
      import { supabase } from '../../lib/supabase.js';

      let applyMainTab = null;

      const mainTabsNav = document.getElementById('profile-main-tabs');
      if (mainTabsNav) {
        const mainPanels = document.querySelectorAll('.mp-main-panel');
        const MAIN_TAB_KEYS = ['all', 'oshi', 'reviews', 'badges'];
        let currentMainTab = 'all';
        try {
          const saved = localStorage.getItem('onahole_profile_main_tab');
          if (MAIN_TAB_KEYS.includes(saved)) currentMainTab = saved;
        } catch (e) {}

        applyMainTab = (tab) => {
          currentMainTab = tab;
          mainTabsNav.querySelectorAll('.mp-main-tab').forEach((btn) => {
            const active = btn.dataset.mainTab === tab;
            btn.classList.toggle('mp-main-tab-active', active);
            btn.setAttribute('aria-selected', active ? 'true' : 'false');
          });
          mainPanels.forEach((panel) => {
            panel.hidden = panel.dataset.mainPanel !== tab;
          });
          try {
            localStorage.setItem('onahole_profile_main_tab', tab);
          } catch (e) {}
        };

        mainTabsNav.addEventListener('click', (e) => {
          const btn = e.target.closest('.mp-main-tab');
          if (!btn) return;
          applyMainTab(btn.dataset.mainTab);
        });

        applyMainTab(currentMainTab);
      }

      let applyStatusTab = null;
      let applyTierFilter = null;

      const statusTabsNav = document.getElementById('profile-status-tabs');
      if (statusTabsNav) {
        const viewToggle = document.getElementById('profile-view-toggle');
        const statusPanels = document.querySelectorAll('.mp-status-panel');
        const STATUS_KEYS = ['interested', 'used', 'folders'];

        let currentStatus = 'interested';
        try {
          const saved = localStorage.getItem('onahole_profile_status_tab');
          if (STATUS_KEYS.includes(saved)) currentStatus = saved;
        } catch (e) {}

        let currentView = 'grid';
        try {
          const savedView = localStorage.getItem('onahole_profile_view_mode');
          if (savedView === 'grid' || savedView === 'list') currentView = savedView;
        } catch (e) {}

        const tierTabsNav = document.getElementById('profile-tier-tabs');

        applyTierFilter = (tier) => {
          if (!tierTabsNav) return;
          tierTabsNav.querySelectorAll('.mp-tier-tab').forEach((btn) => {
            btn.classList.toggle('mp-tier-tab-active', btn.dataset.tier === tier);
          });
          document.querySelectorAll('.mp-status-panel[data-status-panel="used"] li[data-tier]').forEach((el) => {
            el.hidden = tier !== 'all' && el.dataset.tier !== tier;
          });
          const emptyEl = document.getElementById('profile-tier-empty');
          if (emptyEl) {
            const visibleVariant = document.querySelector(
              '.mp-status-panel[data-status-panel="used"] [data-view-variant]:not([hidden])'
            );
            const hasVisible = visibleVariant
              ? visibleVariant.querySelectorAll('li[data-tier]:not([hidden])').length > 0
              : true;
            emptyEl.hidden = hasVisible;
          }
        };

        if (tierTabsNav) {
          tierTabsNav.addEventListener('click', (e) => {
            const btn = e.target.closest('.mp-tier-tab');
            if (!btn) return;
            applyTierFilter(btn.dataset.tier);
          });
        }

        applyStatusTab = (status) => {
          currentStatus = status;
          statusTabsNav.querySelectorAll('.mp-status-tab').forEach((btn) => {
            btn.classList.toggle('ranking-tab-active', btn.dataset.status === status);
          });
          statusPanels.forEach((panel) => {
            panel.hidden = panel.dataset.statusPanel !== status;
          });
          if (viewToggle) viewToggle.style.display = status === 'folders' ? 'none' : '';
          if (status !== 'used') applyTierFilter('all');
          try {
            localStorage.setItem('onahole_profile_status_tab', status);
          } catch (e) {}
        };

        const applyView = (view) => {
          currentView = view;
          if (viewToggle) {
            viewToggle.querySelectorAll('.mp-view-btn').forEach((btn) => {
              btn.classList.toggle('active', btn.dataset.view === view);
            });
          }
          document.querySelectorAll('[data-view-variant]').forEach((el) => {
            el.hidden = el.dataset.viewVariant !== view;
          });
          try {
            localStorage.setItem('onahole_profile_view_mode', view);
          } catch (e) {}
        };

        statusTabsNav.addEventListener('click', (e) => {
          const btn = e.target.closest('.mp-status-tab');
          if (!btn) return;
          applyStatusTab(btn.dataset.status);
        });

        if (viewToggle) {
          viewToggle.addEventListener('click', (e) => {
            const btn = e.target.closest('.mp-view-btn');
            if (!btn) return;
            applyView(btn.dataset.view);
          });
        }

        applyStatusTab(currentStatus);
        applyView(currentView);
        applyTierFilter('all');
      }

      const statJumpCards = document.querySelectorAll('.mp-stat-jump');
      if (statJumpCards.length) {
        const jumpToStat = (kind) => {
          if (applyMainTab) applyMainTab('all');
          if (kind === 'interested') {
            if (applyStatusTab) applyStatusTab('interested');
          } else if (kind === 'used') {
            if (applyStatusTab) applyStatusTab('used');
            if (applyTierFilter) applyTierFilter('all');
          } else if (kind === 'first' || kind === 'second') {
            if (applyStatusTab) applyStatusTab('used');
            if (applyTierFilter) applyTierFilter(kind);
          }
          const target = document.getElementById('profile-status-tabs') || document.querySelector('.mp-main-panel[data-main-panel="all"]');
          if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        };

        statJumpCards.forEach((card) => {
          card.addEventListener('click', () => jumpToStat(card.dataset.statJump));
          card.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' || e.key === ' ') {
              e.preventDefault();
              jumpToStat(card.dataset.statJump);
            }
          });
        });
      }

      const spendCard = document.getElementById('profile-spend-card');
      const spendCompare = document.getElementById('profile-spend-compare');
      if (spendCard && spendCompare) {
        const toggleSpendCompare = () => {
          const expanded = spendCard.getAttribute('aria-expanded') === 'true';
          spendCard.setAttribute('aria-expanded', expanded ? 'false' : 'true');
          spendCompare.hidden = expanded;
        };
        spendCard.addEventListener('click', toggleSpendCompare);
        spendCard.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            toggleSpendCompare();
          }
        });
      }

      const badgesViewToggle = document.getElementById('profile-badges-view-toggle');
      const badgesViewScope = document.getElementById('profile-badges-view-scope');
      if (badgesViewToggle && badgesViewScope) {
        const applyBadgesView = (view) => {
          badgesViewScope.classList.toggle('badges-dense', view === 'grid');
          badgesViewToggle.querySelectorAll('.density-tab').forEach((btn) => {
            btn.classList.toggle('density-tab-active', btn.dataset.badgesView === view);
          });
          try {
            localStorage.setItem('onahole_profile_badges_view', view);
          } catch (e) {}
        };
        badgesViewToggle.addEventListener('click', (e) => {
          const btn = e.target.closest('.density-tab');
          if (!btn) return;
          applyBadgesView(btn.dataset.badgesView);
        });
        let savedBadgesView = 'card';
        try {
          savedBadgesView = localStorage.getItem('onahole_profile_badges_view') || 'card';
        } catch (e) {}
        applyBadgesView(savedBadgesView);
      }

      async function initFollow() {
        const section = document.getElementById('follow-section');
        if (!section) return;
        const profileId = section.dataset.profileId;

        const {
          data: { session },
        } = await supabase.auth.getSession();

        if (session && session.user.id === profileId) {
          const editBtn = document.getElementById('edit-profile-btn');
          if (editBtn) editBtn.style.display = 'inline-block';
          return;
        }

        if (!session) return;

        const btn = document.getElementById('follow-btn');
        btn.style.display = 'inline-block';

        async function refreshFollowState() {
          const { data: existing } = await supabase
            .from('follows')
            .select('follower_id')
            .eq('follower_id', session.user.id)
            .eq('followee_id', profileId)
            .maybeSingle();
          const following = Boolean(existing);
          btn.textContent = following ? 'フォロー解除' : 'フォローする';
          btn.classList.toggle('following', following);
          return following;
        }

        async function refreshFollowerCount() {
          const { count } = await supabase
            .from('follows')
            .select('*', { count: 'exact', head: true })
            .eq('followee_id', profileId);
          const countEl = document.getElementById('follower-count');
          if (countEl) countEl.textContent = count ?? 0;
        }

        let isFollowing = await refreshFollowState();

        btn.addEventListener('click', async () => {
          btn.disabled = true;
          if (isFollowing) {
            await supabase
              .from('follows')
              .delete()
              .eq('follower_id', session.user.id)
              .eq('followee_id', profileId);
          } else {
            await supabase.from('follows').insert({ follower_id: session.user.id, followee_id: profileId });
          }
          isFollowing = await refreshFollowState();
          await refreshFollowerCount();
          btn.disabled = false;
        });
      }

      initFollow();
    </script>
  </body>
</html>
