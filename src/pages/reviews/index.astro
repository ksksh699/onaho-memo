---
import { supabase } from '../../lib/supabase.js';
import '../../styles/global.css';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import {
  parsePage, filterParams, setListingCacheHeaders, pagerPages,
} from '../../lib/listing.js';
import { reviewDisplayTitle, reviewDisplayExcerpt } from '../../lib/reviewText.js';

// 口コミ一覧ページ(2026-09-23)。URL: /reviews/?sort=&page=&q=&maker=&rating_min=
// 掲示板での要望(ほわわ〜さん、2026-09-23)を受けて追加。
// 構成・見た目はメーカー別/セールの一覧ページ(src/pages/sale/index.astro 等)に合わせる。
// データは checks(口コミ)。トップページの「最新のレビュー」と同じ「公開されている口コミだけ」
// という条件に加えて、本文もタイトルも空で星だけの記録は一覧に出したくないため、
// review_text か detail_review_text のどちらかが入っているものだけに絞る(ratingだけは対象外)。
//
// 絞り込み(2026-09-23追加): 公開直後に じょいさんから「並び替えだけだと絞り切れない」との
// フィードバックを受け、メーカー・商品名キーワード・評価(★n以上)の3つを追加した。
// 発売年・価格帯は「商品」の属性で口コミを探す目的からはやや外れるため、今回は見送り。
const REVIEWS_PAGE_SIZE = 20;
const DEFAULT_SORT = 'new';
const SORT_OPTIONS = [
  { value: 'new', label: '新着順' },
  { value: 'rating', label: '評価が高い順' },
  { value: 'likes', label: 'グッドが多い順' },
];
const SORT_LABELS = Object.fromEntries(SORT_OPTIONS.map((o) => [o.value, o.label]));
const SORT_VALUES = new Set(SORT_OPTIONS.map((o) => o.value));
const RATING_MIN_VALUES = [5, 4, 3, 2, 1];

function cleanReviewText(v, max) {
  return String(v ?? '').replace(/\s+/g, ' ').trim().slice(0, max);
}
function cleanRatingMin(v) {
  const n = Number.parseInt(String(v ?? ''), 10);
  return RATING_MIN_VALUES.includes(n) ? n : '';
}

const page = parsePage(Astro.url.searchParams);
const sortParam = Astro.url.searchParams.get('sort') ?? '';
const sort = SORT_VALUES.has(sortParam) ? sortParam : DEFAULT_SORT;
const filters = {
  sort,
  q: cleanReviewText(Astro.url.searchParams.get('q'), 60),
  maker: cleanReviewText(Astro.url.searchParams.get('maker'), 60),
  ratingMin: cleanRatingMin(Astro.url.searchParams.get('rating_min')),
};
// フォーム自体の絞り込み状態(並び替えは別のチップUIで状態が見えているので、
// こちら(トグルの開閉・「条件をクリア」の表示)には含めない)
const fieldsActive = Boolean(filters.q || filters.maker || filters.ratingMin);
const from = (page - 1) * REVIEWS_PAGE_SIZE;
const to = from + REVIEWS_PAGE_SIZE - 1;

// メーカーでの絞り込みは products.maker、商品名キーワードは products.name への一致なので、
// products を(左結合ではなく)内部結合にして、埋め込みリレーションに対する絞り込みができるようにする
const REVIEW_SELECT =
  'id, user_id, product_id, rating, review_title, review_text, detail_review_title, detail_review_text, updated_at, products!inner(id, dmm_content_id, name, maker, image_url)';

function applyReviewFilters(query) {
  if (filters.maker) query = query.eq('products.maker', filters.maker);
  if (filters.q) query = query.ilike('products.name', `%${filters.q.replace(/[%_\\]/g, '\\$&')}%`);
  if (filters.ratingMin) query = query.gte('rating', filters.ratingMin);
  return query;
}

let reviews = [];
let count = 0;
let reviewLikeCounts = {};

if (sort === 'likes') {
  // Supabase(PostgREST)の.orderでは集計(グッド数)順に並べられないため、
  // 1) 対象の口コミ全件のid・updated_atを取得 → 2) review_likesをJS側で集計 →
  // 3) JSでソートしてページ分のidを決める → 4) 該当ページ分だけ詳細を取得、の2段階にする。
  // 口コミ件数は当面数百件程度なので許容範囲。件数が増えたら集計ビューへの切り替えを検討する(2026-09-23)。
  const { data: allRows } = await applyReviewFilters(
    supabase
      .from('checks')
      .select('id, updated_at, products!inner(maker, name)')
      .eq('is_public', true)
      .or('review_text.not.is.null,detail_review_text.not.is.null')
  );
  const rows = allRows ?? [];
  count = rows.length;

  const allIds = rows.map((r) => r.id);
  const likeCountMap = new Map();
  if (allIds.length > 0) {
    const { data: likeRows } = await supabase.from('review_likes').select('check_id').in('check_id', allIds);
    for (const l of likeRows ?? []) {
      likeCountMap.set(l.check_id, (likeCountMap.get(l.check_id) ?? 0) + 1);
    }
  }

  const sortedIds = rows
    .slice()
    .sort((a, b) => {
      const diff = (likeCountMap.get(b.id) ?? 0) - (likeCountMap.get(a.id) ?? 0);
      if (diff !== 0) return diff;
      return new Date(b.updated_at).getTime() - new Date(a.updated_at).getTime();
    })
    .map((r) => r.id)
    .slice(from, to + 1);

  if (sortedIds.length > 0) {
    const { data: pageRows } = await supabase.from('checks').select(REVIEW_SELECT).in('id', sortedIds);
    const byId = new Map((pageRows ?? []).map((r) => [r.id, r]));
    reviews = sortedIds.map((id) => byId.get(id)).filter(Boolean);
  }
  // このページの分のグッド数は、上で集計済みのlikeCountMapからそのまま拾う(再取得しない)
  reviewLikeCounts = Object.fromEntries(reviews.map((r) => [r.id, likeCountMap.get(r.id) ?? 0]));
} else {
  let query = applyReviewFilters(
    supabase
      .from('checks')
      .select(REVIEW_SELECT, { count: 'exact' })
      .eq('is_public', true)
      .or('review_text.not.is.null,detail_review_text.not.is.null')
  );
  query =
    sort === 'rating'
      ? query.order('rating', { ascending: false, nullsFirst: false }).order('updated_at', { ascending: false })
      : query.order('updated_at', { ascending: false });
  query = query.range(from, to);
  const { data, count: c } = await query;
  reviews = data ?? [];
  count = c ?? 0;

  const ids = reviews.map((r) => r.id);
  if (ids.length > 0) {
    const { data: likeRows } = await supabase.from('review_likes').select('check_id').in('check_id', ids);
    for (const l of likeRows ?? []) {
      reviewLikeCounts[l.check_id] = (reviewLikeCounts[l.check_id] ?? 0) + 1;
    }
  }
}

// 投稿者のニックネーム・アイコンは、プロフィールを公開設定にしている人の分だけ表示する
// (checksとprofilesの間に外部キー関係がないため、埋め込みselectではなく手動で結合する)。
// トップページの latestReviewerNicknames と同じ扱い: 非公開・ニックネーム未設定は「匿名ユーザー」
// (アイコンも出さない)。
const reviewerIds = [...new Set(reviews.map((r) => r.user_id).filter(Boolean))];
let reviewerProfiles = {};
if (reviewerIds.length > 0) {
  const { data: profileRows } = await supabase
    .from('profiles')
    .select('id, nickname, avatar_url')
    .in('id', reviewerIds)
    .eq('is_public', true)
    .not('nickname', 'is', null);
  for (const p of profileRows ?? []) {
    reviewerProfiles[p.id] = { nickname: p.nickname, avatarUrl: p.avatar_url };
  }
}

// メーカー絞り込みの選択肢: 件数は「そのメーカーの商品数」ではなく「口コミ件数」にする
// (2026-09-23、じょいさんの指摘を受けて変更。listing.jsのfetchListingFilterOptions()は
// 商品数ベースなのでここでは使わない)。件数が多いメーカーが並ぶ都合上スキーマ変更はせず、
// maker列だけ全件取得してJS側で集計する(セールページの他ショップ件数集計と同じやり方)。
// 現在選択中の絞り込み(キーワード・評価)には影響されない = 常に口コミ全体での件数
const { data: makerRowsForFilter } = await supabase
  .from('checks')
  .select('products!inner(maker)')
  .eq('is_public', true)
  .or('review_text.not.is.null,detail_review_text.not.is.null');
const makerTally = new Map();
for (const row of makerRowsForFilter ?? []) {
  const maker = row.products?.maker;
  if (!maker) continue;
  makerTally.set(maker, (makerTally.get(maker) ?? 0) + 1);
}
const makers = [...makerTally.entries()]
  .map(([maker, cnt]) => ({ maker, cnt }))
  .sort((a, b) => b.cnt - a.cnt || a.maker.localeCompare(b.maker, 'ja'));

function reviewParams(f) {
  const p = filterParams(f, { defaultSort: DEFAULT_SORT }); // q・maker・sort はここでエンコードされる
  if (f.ratingMin) p.set('rating_min', String(f.ratingMin));
  return p;
}
function reviewPageHref(targetPage) {
  const p = reviewParams(filters);
  if (targetPage > 1) p.set('page', String(targetPage));
  const qs = p.toString();
  return qs ? `${basePath}?${qs}` : basePath;
}
function sortHref(value) {
  // 並び替えを変えても他の絞り込みは維持し、1ページ目に戻す(pageは引き継がない)
  const p = reviewParams({ ...filters, sort: value });
  const qs = p.toString();
  return `/reviews/${qs ? `?${qs}` : ''}`;
}

setListingCacheHeaders(Astro.response);

const pages = Math.max(1, Math.ceil(count / REVIEWS_PAGE_SIZE));
const basePath = '/reviews/';
// canonicalは常に1ページ目・既定ソート・絞り込みなしのURL(/reviews/)にする(仕様書指定)
const canonical = 'https://onahomemo.com/reviews/';
const filtered = sort !== DEFAULT_SORT || page > 1 || fieldsActive;
const sortLabel = SORT_LABELS[sort];
const title = `みんなの口コミ一覧(${count}件・${sortLabel}) | オナホめも`;
const description = `オナホめもに投稿された口コミ${count}件を、新着順・評価が高い順・グッドが多い順で並び替えて一覧表示。メーカー・商品名・評価でも絞り込めます。気になる口コミをタップすると商品ページの該当レビューまで移動できます。`;
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#2b5fad" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {filtered && <meta name="robots" content="noindex, follow" />}
    {page > 1 && <link rel="prev" href={`https://onahomemo.com${reviewPageHref(page - 1)}`} />}
    {page < pages && <link rel="next" href={`https://onahomemo.com${reviewPageHref(page + 1)}`} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content="みんなの口コミ一覧 | オナホめも" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="オナホめも" />
    <meta property="og:image" content="https://onahomemo.com/ogp.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@onahomemo" />
  </head>
  <body>
    <SiteHeader />
    <main class="listing-page">
      <nav class="breadcrumb" aria-label="パンくず"><a href="/">ホーム</a><span>›</span><span>口コミ一覧</span></nav>
      <h1 class="listing-title">みんなの口コミ一覧</h1>
      <p class="listing-lead">
        オナホめもに投稿された口コミを{count.toLocaleString('ja-JP')}件、{sortLabel}で表示しています。
      </p>

      <section class="reviews-sort-section">
        <ul class="other-shop-filter">
          {SORT_OPTIONS.map((o) => (
            <li>
              <a href={sortHref(o.value)} class={sort === o.value ? 'is-active' : ''}>{o.label}</a>
            </li>
          ))}
        </ul>
      </section>

      <form class="toolbar listing-toolbar reviews-filter-form" method="get" action="/reviews/" data-default-sort={DEFAULT_SORT}>
        <input type="hidden" name="sort" value={filters.sort} />
        <div class="listing-toolbar-summary">
          <button type="button" class="listing-toolbar-toggle" aria-expanded={fieldsActive ? 'true' : 'false'}>
            <span>絞り込み</span>
            <span class="listing-toolbar-toggle-icon" aria-hidden="true"></span>
          </button>
          <span class="listing-toolbar-count">{count.toLocaleString('ja-JP')}件</span>
          {fieldsActive && <a href={basePath} class="listing-toolbar-reset">条件をクリア</a>}
        </div>
        <div class="listing-toolbar-fields" hidden={!fieldsActive}>
          <input
            type="search"
            name="q"
            class="search-input"
            placeholder="商品名で検索..."
            value={filters.q}
            maxlength="60"
            autocomplete="off"
          />
          <label>
            メーカー
            <select name="maker">
              <option value="">すべて</option>
              {filters.maker && !makers.some((m) => m.maker === filters.maker) && (
                <option value={filters.maker} selected>{filters.maker}</option>
              )}
              {makers.map((m) => (
                <option value={m.maker} selected={m.maker === filters.maker}>
                  {m.maker} ({Number(m.cnt).toLocaleString('ja-JP')})
                </option>
              ))}
            </select>
          </label>
          <label>
            評価
            <select name="rating_min">
              <option value="">すべて</option>
              {RATING_MIN_VALUES.map((n) => (
                <option value={n} selected={filters.ratingMin === n}>★{n}以上</option>
              ))}
            </select>
          </label>
          <div class="listing-toolbar-actions">
            <button type="submit" class="btn-primary listing-toolbar-submit">絞り込む</button>
          </div>
        </div>
      </form>

      {reviews.length === 0 ? (
        <p class="listing-lead">{filtered ? '条件に合う口コミがありません。' : 'まだ口コミがありません。'}</p>
      ) : (
        <ul class="reviews-index-list">
          {reviews.map((r) => {
            const reviewTitle = reviewDisplayTitle(r);
            const excerpt = reviewDisplayExcerpt(r, 80);
            const profile = reviewerProfiles[r.user_id];
            const nickname = profile?.nickname ?? '匿名ユーザー';
            const avatarUrl = profile?.avatarUrl ?? null;
            const likeCount = reviewLikeCounts[r.id] ?? 0;
            return (
              <li class="reviews-index-card">
                <a href={`/products/${r.products.dmm_content_id}/#review-${r.id}`} class="reviews-index-card-link">
                  <img
                    src={r.products.image_url}
                    alt={r.products.name}
                    loading="lazy"
                    class="reviews-index-card-thumb"
                    width="72"
                    height="96"
                  />
                  <div class="reviews-index-card-body">
                    <p class="reviews-index-card-product">{r.products.name}</p>
                    {r.products.maker && <p class="reviews-index-card-maker">{r.products.maker}</p>}
                    <div class="reviews-index-card-author">
                      {avatarUrl && <img src={avatarUrl} alt="" loading="lazy" class="reviews-index-card-avatar" />}
                      <span class="reviews-index-card-nickname">{nickname}</span>
                    </div>
                    {r.rating && (
                      <p class="reviews-index-card-stars">
                        {'★'.repeat(r.rating)}
                        {'☆'.repeat(5 - r.rating)}
                      </p>
                    )}
                    {reviewTitle && <p class="reviews-index-card-title">{reviewTitle}</p>}
                    {excerpt && <p class="reviews-index-card-excerpt">{excerpt}</p>}
                    <div class="reviews-index-card-meta">
                      <span class="reviews-index-card-likes">
                        <svg
                          class="reaction-icon"
                          width="14"
                          height="14"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.8"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                        ><path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3H14Z" /><path d="M7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3v11Z" /></svg>
                        {likeCount}
                      </span>
                      <span class="reviews-index-card-date">{new Date(r.updated_at).toLocaleDateString('ja-JP')}</span>
                    </div>
                  </div>
                </a>
              </li>
            );
          })}
        </ul>
      )}

      {pages > 1 && (
        <nav class="pager listing-pager" aria-label="ページ送り">
          {page > 1 ? (
            <a class="pager-link" href={reviewPageHref(page - 1)} rel="prev">← 前へ</a>
          ) : (
            <span class="pager-link is-disabled">← 前へ</span>
          )}
          <div class="pager-numbers">
            {pagerPages(page, pages).map((p) =>
              p === null ? (
                <span class="pager-ellipsis">…</span>
              ) : p === page ? (
                <span class="pager-number active" aria-current="page">{p}</span>
              ) : (
                <a class="pager-number" href={reviewPageHref(p)}>{p}</a>
              )
            )}
          </div>
          {page < pages ? (
            <a class="pager-link" href={reviewPageHref(page + 1)} rel="next">次へ →</a>
          ) : (
            <span class="pager-link is-disabled">次へ →</span>
          )}
        </nav>
      )}
    </main>
    <SiteFooter />
    <script>
      // 絞り込みフォームの開閉・自動送信(セール/メーカーページのListingToolbarと同じ挙動、2026-09-23)。
      // このページではListingToolbarコンポーネント自体は使わず(並び替え項目が重複してしまうため)、
      // 同じ見た目のクラスを使って口コミ一覧専用のフォームとして組んでいる。
      document.querySelectorAll('form.reviews-filter-form').forEach((form) => {
        form.querySelectorAll('select').forEach((el) => {
          el.addEventListener('change', () => form.requestSubmit());
        });
        // 空の項目・既定の並び替えは送信しない(URLを短く保つ)
        form.addEventListener('submit', () => {
          form.querySelectorAll('input, select').forEach((el) => {
            if (!el.value) el.disabled = true;
            if (el.name === 'sort' && el.value === form.dataset.defaultSort) el.disabled = true;
          });
        });

        const toggle = form.querySelector('.listing-toolbar-toggle');
        const fields = form.querySelector('.listing-toolbar-fields');
        toggle?.addEventListener('click', () => {
          const willOpen = fields.hidden;
          fields.hidden = !willOpen;
          toggle.setAttribute('aria-expanded', String(willOpen));
        });
      });
    </script>
  </body>
</html>
