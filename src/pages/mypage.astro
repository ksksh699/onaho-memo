      // 発売日は「2010年」のようなあいまいな書き方でも、絞り込み・並び替えで
      // 使えるように、可能な範囲でrelease_date(date型)に変換する。
      // 表示にはユーザーが入力したそのままの文字列(release_date_text)を使う。
      function parseReleaseDate(input) {
        if (!input) return null;
        const trimmed = input.trim();

        let m = trimmed.match(/^(\d{4})-(\d{1,2})-(\d{1,2})$/);
        if (m) return `${m[1]}-${m[2].padStart(2, '0')}-${m[3].padStart(2, '0')}`;

        m = trimmed.match(/^(\d{4})年(\d{1,2})月(\d{1,2})日$/);
        if (m) return `${m[1]}-${m[2].padStart(2, '0')}-${m[3].padStart(2, '0')}`;

        m = trimmed.match(/^(\d{4})-(\d{1,2})$/);
        if (m) return `${m[1]}-${m[2].padStart(2, '0')}-01`;

        m = trimmed.match(/^(\d{4})年(\d{1,2})月$/);
        if (m) return `${m[1]}-${m[2].padStart(2, '0')}-01`;

        m = trimmed.match(/^(\d{4})年?(頃)?$/);
        if (m) return `${m[1]}-01-01`;

        return null;
      }

      manualProductContainer.addEventListener('click', async (e) => {
        const editBtn = e.target.closest('.manual-product-edit-btn');
        if (editBtn) {
          editingManualProductId = editBtn.dataset.id;
          manualProductContainer.innerHTML = manualProductSectionHtml(manualProducts, editingManualProductId);
          return;
        }

        if (e.target.closest('#mp-cancel-btn')) {
          editingManualProductId = null;
          manualProductContainer.innerHTML = manualProductSectionHtml(manualProducts, editingManualProductId);
          return;
        }

        const deleteBtn = e.target.closest('.manual-product-delete-btn');
        if (deleteBtn) {
          if (!confirm('この商品を削除しますか？関連するレビュー等からも参照できなくなります。')) return;
          const id = deleteBtn.dataset.id;
          const { error } = await supabase.from('products').delete().eq('id', id);
          if (error) {
            console.error(error);
            alert('削除に失敗しました');
            return;
          }
          if (editingManualProductId === id) editingManualProductId = null;
          await renderManualProductSection('削除しました');
          return;
        }

        if (!e.target.closest('#mp-submit-btn')) return;

        const statusEl = document.getElementById('mp-status');
        const name = document.getElementById('mp-name').value.trim();
        if (!name) {
          statusEl.textContent = '商品名を入力してください';
          return;
        }

        const { data: { session } } = await supabase.auth.getSession();
        if (!session) return;

        statusEl.textContent = editingManualProductId ? '更新中...' : '追加中...';

        const maker = document.getElementById('mp-maker').value.trim() || null;
        const priceRaw = document.getElementById('mp-price').value;
        const price = priceRaw ? Number(priceRaw) : null;
        const tagsRaw = document.getElementById('mp-tags').value.trim();
        const genreTags = tagsRaw
          ? tagsRaw
              .split(',')
              .map((t) => t.trim())
              .filter(Boolean)
          : null;
        const purchaseUrl = document.getElementById('mp-url').value.trim() || null;
        const releaseInput = document.getElementById('mp-release').value.trim();
        const releaseDateText = releaseInput || null;
        const releaseDate = parseReleaseDate(releaseInput);
        const note = document.getElementById('mp-note').value.trim() || null;
        const imageFile = document.getElementById('mp-image').files[0];

        let imageUrl = editingManualProductId
          ? manualProducts.find((p) => p.id === editingManualProductId)?.image_url ?? null
          : null;

        if (imageFile) {
          const compressedImageFile = await compressImage(imageFile, {
            maxWidth: 1200,
            maxHeight: 1200,
            quality: 0.82,
          });
          const ext = compressedImageFile.name.split('.').pop() || 'jpg';
          const path = `manual/${Date.now()}-${Math.random().toString(36).slice(2, 8)}.${ext}`;
          const { error: uploadError } = await supabase.storage
            .from(PRODUCT_IMAGE_BUCKET)
            .upload(path, compressedImageFile);
          if (uploadError) {
            console.error(uploadError);
            statusEl.textContent = '画像のアップロードに失敗しました';
            return;
          }
          const { data: publicUrlData } = supabase.storage.from(PRODUCT_IMAGE_BUCKET).getPublicUrl(path);
          imageUrl = publicUrlData.publicUrl;
        }

        const payload = {
          name,
          maker,
          price,
          image_url: imageUrl,
          genre_tags: genreTags,
          affiliate_url: purchaseUrl,
          release_date: releaseDate,
          release_date_text: releaseDateText,
          manual_note: note,
        };

        if (editingManualProductId) {
          const { error } = await supabase.from('products').update(payload).eq('id', editingManualProductId);
          if (error) {
            console.error(error);
            statusEl.textContent = '更新に失敗しました';
            return;
          }
          const updatedProduct = manualProducts.find((p) => p.id === editingManualProductId);
          editingManualProductId = null;
          await renderManualProductSection(
            updatedProduct
              ? `更新しました → <a href="/products/${updatedProduct.dmm_content_id}/" target="_blank">商品ページを見る</a>`
              : '更新しました'
          );
        } else {
          const dmmContentId = generateManualContentId();
          const { error } = await supabase.from('products').insert({
            dmm_content_id: dmmContentId,
            is_manual: true,
            is_onahole: true,
            ...payload,
          });
          if (error) {
            console.error(error);
            statusEl.textContent = '追加に失敗しました';
            return;
          }
          await renderManualProductSection(
            `追加しました → <a href="/products/${dmmContentId}/" target="_blank">商品ページを見る</a>`
          );
        }
      });

