---
import '../styles/global.css';
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>マイページ | オナホめも</title>
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="site-logo">オナホめも</a>
    </header>
    <main class="mypage-main">
      <h1 class="mypage-title">マイページ</h1>

      <div id="profile-section" class="profile-section"></div>

      <div id="profile-details-container"></div>

      <div id="top3-container"></div>

      <div id="best-review-container"></div>

      <div id="oshi-maker-container"></div>

      <div id="folders-container"></div>

      <div id="onaking-links-container"></div>

      <div id="manual-product-container"></div>

      <div id="badge-section-container"></div>

      <div id="maker-badge-section-container"></div>

      <div id="titles-section-container"></div>

      <div id="mypage-content">
        <p class="mypage-loading">読み込み中...</p>
      </div>
    </main>

    <script>
      import { supabase } from '../lib/supabase.js';
      import { compressImage } from '../lib/imageCompress.js';

      const content = document.getElementById('mypage-content');
      const profileSection = document.getElementById('profile-section');
      const top3Container = document.getElementById('top3-container');
      const bestReviewContainer = document.getElementById('best-review-container');
      const oshiMakerContainer = document.getElementById('oshi-maker-container');
      const foldersContainer = document.getElementById('folders-container');
      const onakingLinksContainer = document.getElementById('onaking-links-container');
      const manualProductContainer = document.getElementById('manual-product-container');
      const profileDetailsContainer = document.getElementById('profile-details-container');
      const PRODUCT_IMAGE_BUCKET = 'product-images';
      const PROFILE_IMAGE_BUCKET = 'profile-images';
      let manualProducts = [];
      let editingManualProductId = null;

      let currentTop3 = [null, null, null]; // each: { productId, reason } or null
      let currentBestReviewProductId = null;
      let currentOshiMaker = null;
      let currentOshiMakerReason = null;
      let lastChecks = [];
      let top3EditingRank = null;
      let oshiMakerEditing = false;
      let makerOptionsCache = null;
      let currentFolders = [];
      let editingFolderId = null;
      let currentAvatarUrl = null;
      let currentHeaderUrl = null;
      let currentBio = null;
      let currentSnsLinks = []; // [{ label, url }]
      let currentIsPublic = true;
      let profileDetailsEditing = false;
      let editingSnsLinks = [];
      let currentViewMode = 'grid';
      try {
        currentViewMode = localStorage.getItem('onahole_view_mode') || 'grid';
      } catch (e) {
        currentViewMode = 'grid';
      }
      const ADMIN_USER_ID = '278377ee-a457-41bc-ab79-c1be9f4b768e';

      const STATUS_LABELS = {
        interested: '気になる',
        used: '使った',
      };
      const TIER_LABELS = {
        first: '一軍',
        second: '二軍',
        retired: '引退',
      };
      const STATUS_ORDER = ['used', 'interested'];

      function isOnSale(check) {
        const p = check.products;
        if (!p) return false;
        const listPrice = p.raw_data?.prices?.list_price ? Number(p.raw_data.prices.list_price) : null;
        return Boolean(listPrice && p.price && listPrice > p.price);
      }

      const BADGE_TIERS = [
        { threshold: 100, name: 'レジェンド' },
        { threshold: 50, name: 'マスター' },
        { threshold: 30, name: 'ベテラン' },
        { threshold: 10, name: 'レギュラー' },
        { threshold: 5, name: 'ビギナー' },
        { threshold: 1, name: 'はじめての一本' },
      ];

      function getBadgeInfo(usedCount) {
        const current = BADGE_TIERS.find((t) => usedCount >= t.threshold) ?? null;
        const next = [...BADGE_TIERS].reverse().find((t) => t.threshold > usedCount) ?? null;
        return { current, next };
      }

      function badgeSectionHtml(usedCount) {
        const { current, next } = getBadgeInfo(usedCount);

        if (!current) {
          return `
            <div class="badge-section">
              <p class="badge-empty">まだバッジがありません。1本使うと「はじめての一本」バッジがもらえます。</p>
            </div>
          `;
        }

        const nextText = next
          ? `次の「${next.name}」まであと${next.threshold - usedCount}本`
          : '最高ランクに到達しました';

        return `
          <div class="badge-section">
            <span class="badge-chip">${current.name}</span>
            <p class="badge-detail">使った本数: ${usedCount}本 ・ ${nextText}</p>
          </div>
        `;
      }

      const MAKER_BADGE_TIERS = [
        { threshold: 10, name: 'コレクター' },
        { threshold: 5, name: 'マニア' },
        { threshold: 3, name: 'ファン' },
        { threshold: 1, name: 'デビュー' },
      ];

      function getMakerBadge(count) {
        return MAKER_BADGE_TIERS.find((t) => count >= t.threshold) ?? null;
      }

      function makerBadgeSectionHtml(checks) {
        const makerCounts = {};
        for (const c of checks) {
          const maker = c.products?.maker;
          if (c.status === 'used' && maker) {
            makerCounts[maker] = (makerCounts[maker] ?? 0) + 1;
          }
        }

        const badges = Object.entries(makerCounts)
          .map(([maker, count]) => ({ maker, count, badge: getMakerBadge(count) }))
          .filter((b) => b.badge)
          .sort((a, b) => b.count - a.count);

        if (badges.length === 0) return '';

        return `
          <div class="maker-badge-section">
            <h2 class="maker-badge-title">メーカーバッジ</h2>
            <div class="maker-badge-list">
              ${badges
                .map(
                  (b) => `
                <span class="maker-badge-chip">${b.maker} ${b.badge.name}<span class="maker-badge-count">(${b.count}本)</span></span>
              `
                )
                .join('')}
            </div>
          </div>
        `;
      }

      const TITLES = [
        {
          id: 'first_check',
          icon: '🎯',
          name: '一歩目',
          desc: 'はじめてチェックを記録する',
          check: (checks) => checks.length > 0,
        },
        {
          id: 'interested_one',
          icon: '👀',
          name: '気になる屋さん',
          desc: '「気になる」を1件登録する',
          check: (checks) => checks.some((c) => c.status === 'interested'),
        },
        {
          id: 'used_one',
          icon: '✅',
          name: '使用開始',
          desc: '「使った」を1件記録する',
          check: (checks) => checks.some((c) => c.status === 'used'),
        },
        {
          id: 'first_tier',
          icon: '🥇',
          name: '一軍認定',
          desc: '「一軍」を1件選ぶ',
          check: (checks) => checks.some((c) => c.tier === 'first'),
        },
        {
          id: 'retired_one',
          icon: '👋',
          name: '卒業',
          desc: '「引退」を1件記録する',
          check: (checks) => checks.some((c) => c.tier === 'retired'),
        },
        {
          id: 'rating_one',
          icon: '⭐',
          name: '星をつけた',
          desc: '星評価を1件つける',
          check: (checks) => checks.some((c) => c.rating),
        },
        {
          id: 'rating_five',
          icon: '🌟',
          name: '満点評価',
          desc: '★5をつける',
          check: (checks) => checks.some((c) => c.rating === 5),
        },
        {
          id: 'review_one',
          icon: '✍️',
          name: 'ひとことレビュアー',
          desc: 'ひとことレビューを1件書く',
          check: (checks) => checks.some((c) => c.review_text),
        },
        {
          id: 'detail_review_one',
          icon: '📝',
          name: '語り部',
          desc: '詳細レビューを1件書く',
          check: (checks) => checks.some((c) => c.detail_review_text),
        },
        {
          id: 'image_one',
          icon: '📷',
          name: 'カメラマン',
          desc: 'レビュー画像を1件投稿する',
          check: (checks) => checks.some((c) => c.review_images && c.review_images.length > 0),
        },
        {
          id: 'retirement_reason_one',
          icon: '💌',
          name: '正直者',
          desc: '手放した理由を1件書く',
          check: (checks) => checks.some((c) => c.retirement_reason),
        },
        {
          id: 'similar_one',
          icon: '🔍',
          name: '目利き',
          desc: '似てるオナホールを1件記入する',
          check: (checks) => checks.some((c) => c.similar_products),
        },
        {
          id: 'public_one',
          icon: '📢',
          name: '公開派',
          desc: 'レビューを1件公開する',
          check: (checks) => checks.some((c) => c.is_public),
        },
        {
          id: 'memo_one',
          icon: '🗒️',
          name: 'メモ魔',
          desc: 'ひとことメモを1件書く',
          check: (checks) => checks.some((c) => c.memo),
        },
        {
          id: 'genre_explorer',
          icon: '🧭',
          name: 'ジャンル探検家',
          desc: '3種類以上のジャンルの商品を使う',
          check: (checks) => {
            const genres = new Set();
            for (const c of checks) {
              if (c.status !== 'used') continue;
              for (const g of c.products?.genre_tags ?? []) genres.add(g);
            }
            return genres.size >= 3;
          },
        },
        {
          id: 'multi_maker',
          icon: '🏭',
          name: '多メーカー派',
          desc: '3社以上のメーカーの商品を使う',
          check: (checks) => {
            const makers = new Set();
            for (const c of checks) {
              if (c.status === 'used' && c.products?.maker) makers.add(c.products.maker);
            }
            return makers.size >= 3;
          },
        },
        {
          id: 'nickname_set',
          icon: '🪪',
          name: '名乗り',
          desc: 'ニックネームを設定する',
          check: (_checks, hasNickname) => hasNickname,
        },
      ];

      const META_RANK_TIERS = [
        { threshold: 17, name: 'マスター' },
        { threshold: 12, name: 'エキスパート' },
        { threshold: 6, name: 'ミドル' },
        { threshold: 1, name: 'ビギナー' },
      ];

      function titlesSectionHtml(checks, hasNickname) {
        const earnedIds = new Set();
        const cards = TITLES.map((t) => {
          const earned = t.check(checks, hasNickname);
          if (earned) earnedIds.add(t.id);
          return { ...t, earned };
        });

        const earnedCount = earnedIds.size;
        const metaRank = META_RANK_TIERS.find((r) => earnedCount >= r.threshold) ?? null;

        let previouslyEarned = [];
        try {
          previouslyEarned = JSON.parse(localStorage.getItem('onahole_earned_titles') || '[]');
        } catch (e) {
          previouslyEarned = [];
        }
        const newlyEarnedIds = [...earnedIds].filter((id) => !previouslyEarned.includes(id));
        try {
          localStorage.setItem('onahole_earned_titles', JSON.stringify([...earnedIds]));
        } catch (e) {
          // localStorageが使えない環境は無視
        }

        const rankHtml = metaRank
          ? `
            <div class="title-rank-section">
              <span class="badge-chip title-rank-chip">${metaRank.name}</span>
              <p class="badge-detail">称号 ${earnedCount}/${TITLES.length}個 獲得</p>
            </div>
          `
          : `
            <div class="title-rank-section">
              <p class="badge-empty">称号を1つ集めると「ビギナー」ランクがもらえます。</p>
            </div>
          `;

        const cardsHtml = cards
          .map((t) => {
            const isNew = newlyEarnedIds.includes(t.id);
            return `
            <div class="title-card ${t.earned ? 'earned' : 'locked'} ${isNew ? 'title-new' : ''}">
              ${isNew ? '<span class="title-new-badge">NEW</span>' : ''}
              <span class="title-icon">${t.icon}</span>
              <p class="title-name">${t.name}</p>
              <p class="title-desc">${t.desc}</p>
            </div>
          `;
          })
          .join('');

        return `
          <div class="titles-section">
            <h2 class="titles-title">称号(実績)</h2>
            ${rankHtml}
            <div class="title-grid">${cardsHtml}</div>
          </div>
        `;
      }

      function buildTop3Slots() {
        return currentTop3.map((slot) => {
          if (!slot) return null;
          const check = lastChecks.find((c) => c.products?.id === slot.productId);
          if (!check) return null;
          return { check, reason: slot.reason };
        });
      }

      function topThreeSectionHtml(slots, editingRank) {
        const slotsHtml = [0, 1, 2]
          .map((i) => {
            const rank = i + 1;
            const slot = slots[i];

            if (!slot) {
              return `
                <div class="top3-slot empty">
                  <span class="top3-rank">${rank}位</span>
                  <p class="badge-empty">「使った」の商品カードから選べます</p>
                </div>
              `;
            }

            const p = slot.check.products;
            const reasonHtml =
              editingRank === rank
                ? `
                  <div class="top3-reason-area">
                    <input type="text" class="top3-reason-input nickname-input" data-rank="${rank}" maxlength="60" placeholder="選んだ理由(任意)" value="${slot.reason ?? ''}" />
                    <button class="top3-reason-save-btn" data-rank="${rank}">保存</button>
                  </div>
                `
                : `
                  <div class="top3-reason-area">
                    <p class="top3-reason-text" data-rank="${rank}">${slot.reason ? slot.reason : '理由を追加する'}</p>
                  </div>
                `;

            return `
              <div class="top3-slot filled">
                <span class="top3-rank">${rank}位</span>
                <a href="/products/${p.dmm_content_id}/" class="top3-card">
                  <img src="${p.image_url}" alt="${p.name}" loading="lazy" />
                  <div class="top3-card-body">
                    <p class="mp-maker">${p.maker ?? ''}</p>
                    <h3>${p.name}</h3>
                  </div>
                </a>
                ${reasonHtml}
                <button class="top3-clear-btn" data-rank="${rank}">解除</button>
              </div>
            `;
          })
          .join('');

        return `
          <div class="top3-section">
            <h2 class="top3-title">マイベストTOP3</h2>
            <div class="top3-grid">${slotsHtml}</div>
          </div>
        `;
      }

      function renderTop3Section() {
        top3Container.innerHTML = topThreeSectionHtml(buildTop3Slots(), top3EditingRank);
      }

      async function saveTop3() {
        const { data: { session } } = await supabase.auth.getSession();
        if (!session) return;

        const { error } = await supabase
          .from('profiles')
          .update({
            best_product_id_1: currentTop3[0]?.productId ?? null,
            best_product_id_2: currentTop3[1]?.productId ?? null,
            best_product_id_3: currentTop3[2]?.productId ?? null,
            best_product_reason_1: currentTop3[0]?.reason ?? null,
            best_product_reason_2: currentTop3[1]?.reason ?? null,
            best_product_reason_3: currentTop3[2]?.reason ?? null,
          })
          .eq('id', session.user.id);

        if (error) console.error(error);
      }

      async function toggleTop3(productId) {
        const idx = currentTop3.findIndex((s) => s && s.productId === productId);
        if (idx >= 0) {
          currentTop3[idx] = null;
        } else {
          const emptyIdx = currentTop3.findIndex((s) => !s);
          if (emptyIdx === -1) return;
          currentTop3[emptyIdx] = { productId, reason: null };
        }
        await saveTop3();
        init();
      }

      function bestReviewSectionHtml(bestReviewCheck) {
        if (!bestReviewCheck || !bestReviewCheck.products) {
          return `
            <div class="best-review-section">
              <h2 class="best-review-title">ベストな口コミ</h2>
              <p class="badge-empty">まだ選ばれていません。レビューを書いた商品カードの「ベスト口コミに設定」ボタンで選べます。</p>
            </div>
          `;
        }

        const p = bestReviewCheck.products;
        const isDetail = Boolean(bestReviewCheck.detail_review_text);
        const text = bestReviewCheck.detail_review_text || bestReviewCheck.review_text || '';
        const title = isDetail ? bestReviewCheck.detail_review_title : bestReviewCheck.review_title;

        return `
          <div class="best-review-section">
            <h2 class="best-review-title">ベストな口コミ</h2>
            <a href="/products/${p.dmm_content_id}/" class="best-review-product">
              <img src="${p.image_url}" alt="${p.name}" loading="lazy" />
              <div class="best-review-product-body">
                <p class="mp-maker">${p.maker ?? ''}</p>
                <h3>${p.name}</h3>
              </div>
            </a>
            ${title ? `<p class="best-review-quote-title">${title}</p>` : ''}
            <p class="best-review-quote">${text}</p>
            <button id="clear-best-review-btn" class="best-one-clear-btn">解除する</button>
          </div>
        `;
      }

      async function toggleBestReview(productId) {
        const { data: { session } } = await supabase.auth.getSession();
        if (!session) return;

        const newVal = currentBestReviewProductId === productId ? null : productId;

        const { error } = await supabase
          .from('profiles')
          .update({ best_review_product_id: newVal })
          .eq('id', session.user.id);

        if (error) {
          console.error(error);
          return;
        }

        init();
      }

      async function loadMakerOptions() {
        if (makerOptionsCache) return makerOptionsCache;

        // Supabase/PostgRESTの1回あたりの取得上限に引っかからないよう、
        // 全件取得できるまでページ分割して取得する
        const set = new Set();
        const pageSize = 1000;
        let from = 0;
        while (true) {
          const { data, error } = await supabase
            .from('products')
            .select('maker')
            .not('maker', 'is', null)
            .range(from, from + pageSize - 1);

          if (error) {
            console.error(error);
            break;
          }
          for (const r of data ?? []) {
            if (r.maker) set.add(r.maker);
          }
          if (!data || data.length < pageSize) break;
          from += pageSize;
        }

        makerOptionsCache = [...set].sort((a, b) => a.localeCompare(b, 'ja'));
        return makerOptionsCache;
      }

      function oshiMakerDisplayHtml() {
        return `
          <div class="oshi-maker-section">
            <h2 class="oshi-maker-title">推しメーカー</h2>
            ${
              currentOshiMaker
                ? `
                  <span class="badge-chip oshi-maker-chip">${currentOshiMaker}</span>
                  ${currentOshiMakerReason ? `<p class="badge-detail">${currentOshiMakerReason}</p>` : ''}
                `
                : `<p class="badge-empty">まだ設定されていません。</p>`
            }
            <button id="edit-oshi-maker-btn" class="best-one-clear-btn">${currentOshiMaker ? '変更する' : '推しメーカーを選ぶ'}</button>
          </div>
        `;
      }

      function oshiMakerEditHtml(options) {
        return `
          <div class="oshi-maker-section">
            <h2 class="oshi-maker-title">推しメーカー</h2>
            <input type="text" id="oshi-maker-input" class="nickname-input" list="oshi-maker-datalist" maxlength="60" placeholder="メーカー名を入力(候補から選ぶこともできます)" value="${currentOshiMaker ?? ''}" />
            <datalist id="oshi-maker-datalist">
              ${options.map((m) => `<option value="${m}"></option>`).join('')}
            </datalist>
            <input type="text" id="oshi-maker-reason-input" class="nickname-input" maxlength="60" placeholder="理由(任意)" value="${currentOshiMakerReason ?? ''}" />
            <button id="save-oshi-maker-btn" class="btn-primary">保存する</button>
            <button id="cancel-oshi-maker-btn" class="best-one-clear-btn">キャンセル</button>
          </div>
        `;
      }

      async function renderOshiMakerSection() {
        if (!oshiMakerEditing) {
          oshiMakerContainer.innerHTML = oshiMakerDisplayHtml();
          return;
        }
        oshiMakerContainer.innerHTML = `<p class="mypage-loading">読み込み中...</p>`;
        const options = await loadMakerOptions();
        oshiMakerContainer.innerHTML = oshiMakerEditHtml(options);
      }

      async function saveOshiMaker(maker, reason) {
        const { data: { session } } = await supabase.auth.getSession();
        if (!session) return;

        const { error } = await supabase
          .from('profiles')
          .update({ oshi_maker: maker || null, oshi_maker_reason: reason || null })
          .eq('id', session.user.id);

        if (error) {
          console.error(error);
          return;
        }

        init();
      }

      async function loadFolders(userId) {
        const { data, error } = await supabase
          .from('folders')
          .select(
            'id, name, is_public, sort_order, folder_items(id, product_id, products(id, dmm_content_id, name, maker, image_url))'
          )
          .eq('user_id', userId)
          .order('sort_order', { ascending: true });

        if (error) {
          console.error(error);
          return [];
        }
        return data ?? [];
      }

      function folderCardHtml(folder, idx, total) {
        const items = (folder.folder_items ?? []).filter((fi) => fi.products);
        const isEditing = editingFolderId === folder.id;

        return `
          <div class="folder-card" data-folder-id="${folder.id}">
            <div class="folder-card-head">
              ${
                isEditing
                  ? `<input type="text" class="folder-name-input nickname-input" id="folder-name-edit-${folder.id}" value="${folder.name}" maxlength="30" />`
                  : `<h3 class="folder-name">${folder.name}</h3>`
              }
              <span class="folder-count">${items.length}件</span>
            </div>
            <div class="folder-card-actions">
              <button type="button" class="folder-move-btn" data-folder-id="${folder.id}" data-dir="up" ${idx === 0 ? 'disabled' : ''}>↑</button>
              <button type="button" class="folder-move-btn" data-folder-id="${folder.id}" data-dir="down" ${idx === total - 1 ? 'disabled' : ''}>↓</button>
              ${
                isEditing
                  ? `<button type="button" class="folder-rename-save-btn" data-folder-id="${folder.id}">保存</button>
                     <button type="button" class="folder-rename-cancel-btn" data-folder-id="${folder.id}">キャンセル</button>`
                  : `<button type="button" class="folder-rename-btn" data-folder-id="${folder.id}">名前変更</button>`
              }
              <label class="folder-public-toggle">
                <input type="checkbox" class="folder-public-checkbox" data-folder-id="${folder.id}" ${folder.is_public ? 'checked' : ''} />
                公開する
              </label>
              <button type="button" class="folder-delete-btn" data-folder-id="${folder.id}">削除</button>
            </div>
            ${
              items.length === 0
                ? '<p class="badge-empty">まだ商品が入っていません。商品ページの「フォルダに追加」から追加できます。</p>'
                : `<ul class="folder-items-grid">
                    ${items
                      .map(
                        (fi) => `
                      <li class="folder-item-card">
                        <a href="/products/${fi.products.dmm_content_id}/">
                          <img src="${fi.products.image_url}" alt="${fi.products.name}" loading="lazy" />
