---
// 全ページ共通のナビゲーションバー。ロゴ・主要ページへのリンク・
// ログイン状態表示(authHeader.jsのmountAuthArea)をまとめている。
// スマホ幅では上部のナビ(.site-nav)は隠し、代わりに画面下部に
// 追尾する.site-bottom-navを表示する(global.cssのメディアクエリで切り替え)。
// 下部バーには「ホーム」は含めない(ロゴタップでホームに戻れるため)。
//
// ヘッダー自体はposition: stickyにした上で、スクロール方向に応じて
// 表示/非表示を切り替える(下にスクロール中は隠す、上にスクロールしたり
// 止まったりしたら再表示する)。ホームに戻れなくなる問題への対応。
//
// このコンポーネントは全ページに置かれているため、サイト全体の計測もここで行う:
//   1. Googleアナリティクス(GA4): 下の GA_MEASUREMENT_ID に測定ID(G-XXXXXXXXXX)を
//      入れると全ページに計測タグが入る。空文字のままなら何も出力しない。
//   2. 自前アクセス計測: ページ表示とショップリンクのクリックを /api/track に送り、
//      Supabaseの access_logs に記録する(週次のアクセス分析に使う)。
//      詳細は src/pages/api/track.js を参照。
const GA_MEASUREMENT_ID = 'G-NV7NZELSGB';
---

{GA_MEASUREMENT_ID && (
  <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
)}
{GA_MEASUREMENT_ID && (
  <script is:inline define:vars={{ GA_MEASUREMENT_ID }}>
    window.dataLayer = window.dataLayer || [];
    function gtag() {
      dataLayer.push(arguments);
    }
    gtag('js', new Date());
    gtag('config', GA_MEASUREMENT_ID);
  </script>
)}

<header class="site-header">
  <a href="/" class="site-logo">オナホめも</a>
  <nav class="site-nav">
    <a href="/">ホーム</a>
    <a href="/#rankings">ランキング</a>
    <a href="/sale/">セール中</a>
    <a href="/makers/">メーカー</a>
    <a href="/board/">掲示板</a>
    <a href="/mypage" class="js-mypage-link">マイページ</a>
    <a href="/following">フォロー中</a>
  </nav>
  <div class="site-header-right">
    <div id="site-notify-area" class="site-notify-area"></div>
    <div id="site-auth-area" class="site-auth-area"></div>
  </div>
</header>

<nav class="site-bottom-nav">
  <a href="/#rankings" class="site-bottom-nav-item">
    <svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20V11M12 20V4M20 20v-6" /></svg>
    <span>ランキング</span>
  </a>
  <a href="/sale/" class="site-bottom-nav-item">
    <svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.6 13.4 12.6 21.4a2 2 0 0 1-2.8 0l-7.2-7.2a2 2 0 0 1 0-2.8l8-8H18a2 2 0 0 1 2 2v6a2 2 0 0 1-.6 1.4Z" /><circle cx="14.5" cy="7.5" r="1.1" fill="currentColor" stroke="none" /></svg>
    <span>セール中</span>
  </a>
  <a href="/board/" class="site-bottom-nav-item">
    <svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16v12H8l-4 4V4Z" /></svg>
    <span>掲示板</span>
  </a>
  <a href="/mypage" class="site-bottom-nav-item js-mypage-link">
    <svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="3.4" /><path d="M4.7 20c1.4-3.9 4.8-5.4 7.3-5.4s5.9 1.5 7.3 5.4" /></svg>
    <span>マイページ</span>
  </a>
  <a href="/following" class="site-bottom-nav-item">
    <svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8.2" r="2.9" /><path d="M2.6 19.6c1-3.1 3.8-4.7 6.4-4.7s5.4 1.6 6.4 4.7" /><circle cx="17" cy="7.3" r="2.2" /><path d="M15.7 11.7c1.9.3 3.7 1.7 4.5 4.1" /></svg>
    <span>フォロー中</span>
  </a>
</nav>

<script>
  import { mountAuthArea, getMypageHref } from '../lib/authHeader.js';
  import { mountNotifyArea } from '../lib/notifications.js';

  mountAuthArea(document.getElementById('site-auth-area'));
  mountNotifyArea(document.getElementById('site-notify-area'));

  getMypageHref().then((href) => {
    document.querySelectorAll('.js-mypage-link').forEach((el) => {
      el.setAttribute('href', href);
    });
  });

  const header = document.querySelector('.site-header');
  if (header) {
    let lastY = window.scrollY;
    let ticking = false;
    let idleTimer;
    const SCROLL_THRESHOLD = 8;

    const showHeader = () => header.classList.remove('site-header-hidden');
    const hideHeader = () => header.classList.add('site-header-hidden');

    function handleScroll() {
      const currentY = window.scrollY;
      const diff = currentY - lastY;

      if (currentY <= header.offsetHeight) {
        showHeader();
      } else if (diff > SCROLL_THRESHOLD) {
        hideHeader();
      } else if (diff < -SCROLL_THRESHOLD) {
        showHeader();
      }
      lastY = currentY;

      // スクロールが止まったら常にヘッダーを再表示する
      clearTimeout(idleTimer);
      idleTimer = setTimeout(showHeader, 400);
    }

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          window.requestAnimationFrame(() => {
            handleScroll();
            ticking = false;
          });
          ticking = true;
        }
      },
      { passive: true }
    );
  }

  // ---- 自前アクセス計測 ----
  // ページ表示(pageview)と、商品ページのショップリンククリック(shop_click)を /api/track に送る。
  // sendBeaconは「ページを離れる途中でも送信が完了する」仕組みなので、
  // 外部ショップへ遷移するクリックでも取りこぼしにくい。
  // 計測が失敗しても閲覧には一切影響しないよう、全体を try で包んでいる。
  (function trackAccess() {
    try {
      if (navigator.webdriver) return; // 自動操作ブラウザ(テスト等)は除外
      if (localStorage.getItem('om_notrack') === '1') return; // 自分の閲覧を除外したいとき用のスイッチ

      let sid = sessionStorage.getItem('om_sid');
      if (!sid) {
        sid = Math.random().toString(36).slice(2) + Date.now().toString(36);
        sessionStorage.setItem('om_sid', sid);
      }

      // 商品ページでは <main data-track-product="hole1234"> から商品IDを拾う
      const productEl = document.querySelector('[data-track-product]');
      const productId = productEl ? productEl.getAttribute('data-track-product') : null;

      const send = (payload) => {
        const body = JSON.stringify({
          ...payload,
          sid,
          product: productId,
          path: location.pathname + location.search,
          referrer: document.referrer || '',
        });
        if (navigator.sendBeacon) {
          navigator.sendBeacon('/api/track', new Blob([body], { type: 'application/json' }));
        } else {
          fetch('/api/track', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body,
            keepalive: true,
          }).catch(() => {});
        }
      };

      send({ event: 'pageview' });

      document.addEventListener('click', (e) => {
        const link = e.target.closest('a[data-shop]');
        if (!link) return;
        send({
          event: 'shop_click',
          shop: link.getAttribute('data-shop'),
          listing: link.getAttribute('data-listing') === '1',
        });
      });
    } catch (_) {
      /* 計測は失敗しても無視 */
    }
  })();
</script>
