---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#2b5fad" />
    <title>パスワード再設定 | オナホめも</title>
  </head>
  <body>
    <SiteHeader />
    <main class="login-main">
      <h1>パスワード再設定</h1>
      <p>新しいパスワードを入力してください。</p>

      <form id="reset-form" class="auth-form" hidden>
        <label class="profile-edit-label" for="reset-password-input">新しいパスワード(6文字以上)</label>
        <input type="password" id="reset-password-input" class="nickname-input" required autocomplete="new-password" minlength="6" />

        <label class="profile-edit-label" for="reset-password-confirm">新しいパスワード(確認)</label>
        <input type="password" id="reset-password-confirm" class="nickname-input" required autocomplete="new-password" minlength="6" />

        <button type="submit" class="btn-primary">パスワードを変更する</button>
      </form>
      <p id="reset-status" class="nickname-status"></p>
    </main>

    <script>
      import { supabase } from '../lib/supabase.js';

      const form = document.getElementById('reset-form');
      const statusEl = document.getElementById('reset-status');

      function setStatus(message, isError) {
        statusEl.textContent = message;
        statusEl.classList.toggle('auth-status-error', Boolean(isError));
      }

      async function init() {
        // メール内のリンクからアクセスすると、supabase-jsが自動でURL内の
        // トークンを読み取り、一時的な復旧用セッションを確立する
        const { data: { session } } = await supabase.auth.getSession();

        if (session) {
          form.hidden = false;
          setStatus('', false);
          return;
        }

        setStatus(
          'このリンクは無効か、有効期限が切れています。もう一度「パスワードをお忘れの方」からやり直してください。',
          true
        );
      }

      supabase.auth.onAuthStateChange((event) => {
        if (event === 'PASSWORD_RECOVERY') {
          form.hidden = false;
          setStatus('', false);
        }
      });

      init();

      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        const password = document.getElementById('reset-password-input').value;
        const passwordConfirm = document.getElementById('reset-password-confirm').value;

        if (password !== passwordConfirm) {
          setStatus('パスワードが一致しません。', true);
          return;
        }

        setStatus('変更中...', false);

        const { error } = await supabase.auth.updateUser({ password });

        if (error) {
          setStatus('変更に失敗しました。しばらくしてから再度お試しください。', true);
          console.error(error);
          return;
        }

        form.hidden = true;
        setStatus('パスワードを変更しました。', false);
        setTimeout(() => {
          window.location.href = '/';
        }, 1500);
      });
    </script>
    <SiteFooter />
  </body>
</html>
