      function titlesSectionHtml(checks, ctx) {
        const earnedIds = new Set();
        const cards = TITLES.map((t) => {
          const earned = t.check(checks, ctx);
          if (earned) earnedIds.add(t.id);
          return { ...t, earned };
        });

        const earnedCount = earnedIds.size;

        let previouslyEarned = [];
        try {
          previouslyEarned = JSON.parse(localStorage.getItem('onahole_earned_titles') || '[]');
        } catch (e) {
          previouslyEarned = [];
        }
        const newlyEarnedIds = [...earnedIds].filter((id) => !previouslyEarned.includes(id));
        try {
          localStorage.setItem('onahole_earned_titles', JSON.stringify([...earnedIds]));
        } catch (e) {
          // localStorageが使えない環境は無視
        }

        const cardsHtml = cards
          .map((t) => {
            const isNew = newlyEarnedIds.includes(t.id);
            return `
            <div class="title-card ${t.earned ? 'earned' : 'locked'} ${isNew ? 'title-new' : ''}">
              ${isNew ? '<span class="title-new-badge">NEW</span>' : ''}
              <span class="title-icon">${t.icon}</span>
              <p class="title-name">${t.name}</p>
              <p class="title-desc">${t.desc}</p>
            </div>
          `;
          })
          .join('');

        const html = `
          <div class="titles-section">
            <h2 class="titles-title">称号(実績)</h2>
            <p class="badge-detail titles-count">称号 ${earnedCount}/${TITLES.length}個 獲得</p>
            <div class="title-grid">${cardsHtml}</div>
          </div>
        `;
        return { html, earnedCount };
      }

      // バッジ・称号を統合した「ランク」制度。獲得したバッジ(使用本数バッジ+メーカーバッジ)と
      // 称号の合計数でブロンズ〜ゴッドの5段階を判定する
      const RANK_TIERS = [
        { key: 'god', threshold: 90, name: 'ゴッド', emoji: '👑' },
        { key: 'master', threshold: 65, name: 'マスター', emoji: '💎' },
        { key: 'gold', threshold: 40, name: 'ゴールド', emoji: '🥇' },
        { key: 'silver', threshold: 20, name: 'シルバー', emoji: '🥈' },
        { key: 'bronze', threshold: 5, name: 'ブロンズ', emoji: '🥉' },
      ];

      function getRankInfo(totalEarned) {
        const current = RANK_TIERS.find((t) => totalEarned >= t.threshold) ?? null;
        const idx = current ? RANK_TIERS.indexOf(current) : RANK_TIERS.length;
        const next = idx > 0 ? RANK_TIERS[idx - 1] : null;
        const prevThreshold = current ? current.threshold : 0;
        let progressPercent = 100;
        let remaining = 0;
        if (next) {
          const span = next.threshold - prevThreshold;
          progressPercent = Math.max(0, Math.min(100, Math.round(((totalEarned - prevThreshold) / span) * 100)));
          remaining = next.threshold - totalEarned;
        }
        return { current, next, progressPercent, remaining };
      }

      function rankHeroHtml(totalEarned, badgeCount, titleCount) {
        const { current, next, progressPercent, remaining } = getRankInfo(totalEarned);
        const tierClass = current ? `rank-${current.key}` : 'rank-none';
        const crest = current ? current.emoji : '🔰';
        const rankName = current ? current.name : '未認定';
        const progressText = next
          ? `次の「${next.name}」まであと${remaining}個`
          : current
          ? '最高ランクに到達しました'
          : 'バッジや称号を1つ獲得するとランクがつきます';

        return `
          <div class="rank-hero ${tierClass}">
            <div class="rank-hero-crest">${crest}</div>
            <div class="rank-hero-body">
              <p class="rank-hero-label">ランク</p>
              <p class="rank-hero-name">${rankName}</p>
              <div class="rank-hero-progress-track">
                <div class="rank-hero-progress-fill" style="width:${progressPercent}%"></div>
              </div>
              <p class="rank-hero-progress-text">${progressText}</p>
              <p class="rank-hero-breakdown">バッジ${badgeCount}個・称号${titleCount}個(計${totalEarned}個)</p>
            </div>
          </div>
        `;
      }

      function buildTop3Slots() {
        return currentTop3.map((slot) => {
          if (!slot) return null;
          const check = lastChecks.find((c) => c.products?.id === slot.productId);
          if (!check) return null;
          return { check, reason: slot.reason };
        });
      }

      function topThreeSectionHtml(slots, editingRank) {
        const slotsHtml = [0, 1, 2]
          .map((i) => {
            const rank = i + 1;
            const slot = slots[i];

            if (!slot) {
              return `
                <div class="top3-slot empty">
                  <span class="top3-rank">${rank}位</span>
                  <p class="badge-empty">「使った」の商品カードから選べます</p>
                </div>
              `;
            }

            const p = slot.check.products;
            const reasonHtml =
              editingRank === rank
                ? `
                  <div class="top3-reason-area">
                    <input type="text" class="top3-reason-input nickname-input" data-rank="${rank}" maxlength="60" placeholder="選んだ理由(任意)" value="${slot.reason ?? ''}" />
                    <button class="top3-reason-save-btn" data-rank="${rank}">保存</button>
                  </div>
                `
                : `
                  <div class="top3-reason-area">
                    <p class="top3-reason-text" data-rank="${rank}">${slot.reason ? slot.reason : '理由を追加する'}</p>
                  </div>
                `;

            return `
              <div class="top3-slot filled">
                <span class="top3-rank">${rank}位</span>
                <a href="/products/${p.dmm_content_id}/" class="top3-card">
                  <img src="${p.image_url}" alt="${p.name}" loading="lazy" />
                  <div class="top3-card-body">
                    <p class="mp-maker">${p.maker ?? ''}</p>
                    <h3>${p.name}</h3>
                  </div>
                </a>
                ${reasonHtml}
                <button class="top3-clear-btn" data-rank="${rank}">解除</button>
              </div>
            `;
          })
          .join('');

        return `
          <div class="top3-section">
            <h2 class="top3-title">マイベストTOP3</h2>
            <div class="top3-grid">${slotsHtml}</div>
          </div>
        `;
      }

      function renderTop3Section() {
        top3Container.innerHTML = topThreeSectionHtml(buildTop3Slots(), top3EditingRank);
      }

      async function saveTop3() {
        const { data: { session } } = await supabase.auth.getSession();
        if (!session) return;

        const { error } = await supabase
          .from('profiles')
          .update({
            best_product_id_1: currentTop3[0]?.productId ?? null,
            best_product_id_2: currentTop3[1]?.productId ?? null,
            best_product_id_3: currentTop3[2]?.productId ?? null,
            best_product_reason_1: currentTop3[0]?.reason ?? null,
            best_product_reason_2: currentTop3[1]?.reason ?? null,
            best_product_reason_3: currentTop3[2]?.reason ?? null,
          })
          .eq('id', session.user.id);

        if (error) console.error(error);
      }

      async function toggleTop3(productId) {
        const idx = currentTop3.findIndex((s) => s && s.productId === productId);
        if (idx >= 0) {
          currentTop3[idx] = null;
        } else {
          const emptyIdx = currentTop3.findIndex((s) => !s);
          if (emptyIdx === -1) return;
          currentTop3[emptyIdx] = { productId, reason: null };
        }
        await saveTop3();
        init();
      }

      function bestReviewSectionHtml(bestReviewCheck) {
        if (!bestReviewCheck || !bestReviewCheck.products) {
          return `
            <div class="best-review-section">
              <h2 class="best-review-title">ベストな口コミ</h2>
              <p class="badge-empty">まだ選ばれていません。レビューを書いた商品カードの「ベスト口コミに設定」ボタンで選べます。</p>
            </div>
          `;
        }

        const p = bestReviewCheck.products;
        const isDetail = Boolean(bestReviewCheck.detail_review_text);
        const text = bestReviewCheck.detail_review_text || bestReviewCheck.review_text || '';
        const title = isDetail ? bestReviewCheck.detail_review_title : bestReviewCheck.review_title;
        const dateStr = bestReviewCheck.updated_at
          ? new Date(bestReviewCheck.updated_at).toLocaleDateString('ja-JP')
          : '';

        return `
          <div class="best-review-section">
            <h2 class="best-review-title">ベストな口コミ</h2>
            <a href="/products/${p.dmm_content_id}/" class="best-review-product">
              <img src="${p.image_url}" alt="${p.name}" loading="lazy" />
              <div class="best-review-product-body">
                <p class="mp-maker">${p.maker ?? ''}</p>
                <h3>${p.name}</h3>
              </div>
            </a>
            ${title ? `<p class="best-review-quote-title">${title}</p>` : ''}
            <p class="best-review-quote">${text}</p>
            ${dateStr ? `<p class="review-item-date">${dateStr}</p>` : ''}
            <button id="clear-best-review-btn" class="best-one-clear-btn">解除する</button>
          </div>
