      async function resolveProductByNameFragment(fragment) {
        const { data, error } = await supabase
          .from('products')
          .select('id, name')
          .ilike('name', `%${fragment}%`)
          .limit(5);

        if (error) return { status: 'error' };
        if (!data || data.length === 0) return { status: 'not_found' };
        if (data.length > 1) return { status: 'ambiguous', candidates: data };
        return { status: 'ok', product: data[0] };
      }

      onakingLinksContainer.addEventListener('click', async (e) => {
        if (!e.target.closest('#onaking-links-submit-btn')) return;

        const textarea = document.getElementById('onaking-links-input');
        const lines = textarea.value
          .split('\n')
          .map((l) => l.trim())
          .filter(Boolean);
        if (lines.length === 0) return;

        let successCount = 0;
        const notFound = [];
        const ambiguous = [];
        const invalid = [];

        for (const line of lines) {
          const commaIdx = line.indexOf(',');
          if (commaIdx === -1) {
            invalid.push(line);
            continue;
          }
          const nameFragment = line.slice(0, commaIdx).trim();
          const onakingUrlValue = line.slice(commaIdx + 1).trim();
          if (!nameFragment || !onakingUrlValue) {
            invalid.push(line);
            continue;
          }

          const result = await resolveProductByNameFragment(nameFragment);

          if (result.status === 'not_found' || result.status === 'error') {
            notFound.push(nameFragment);
            continue;
          }
          if (result.status === 'ambiguous') {
            ambiguous.push(`${nameFragment}(${result.candidates.length}件ヒット)`);
            continue;
          }

          const { error: upsertError } = await supabase.from('onaking_links').upsert(
            {
              product_id: result.product.id,
              onaking_url: onakingUrlValue,
              updated_at: new Date().toISOString(),
            },
            { onConflict: 'product_id' }
          );

          if (upsertError) {
            console.error(upsertError);
            notFound.push(nameFragment);
            continue;
          }

          successCount++;
        }

        let message = `${successCount}件登録しました。`;
        if (notFound.length > 0) message += ` 商品が見つからなかった: ${notFound.join(', ')}`;
        if (ambiguous.length > 0)
          message += ` 複数の商品にヒットして特定できなかった(もう少し詳しい名前で試すか、商品ページから個別に登録してください): ${ambiguous.join(', ')}`;
        if (invalid.length > 0) message += ` 形式が不正な行が${invalid.length}件ありました。`;

        await renderOnakingLinksSection(message);
      });

