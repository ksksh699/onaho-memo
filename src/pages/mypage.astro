      function buildCardMeta(check) {
        const p = check.products;
        if (!p) return null;

        const top3Idx = currentTop3.findIndex((s) => s && s.productId === p.id);
        const isTop3 = check.status === 'used' && top3Idx >= 0;
        const top3Full = currentTop3.filter(Boolean).length >= 3;
        const hasReview = Boolean(check.review_text || check.detail_review_text);
        const isBestReview = hasReview && p.id === currentBestReviewProductId;
        const onSale = isOnSale(check);
        const listPrice = onSale ? Number(p.raw_data.prices.list_price) : null;
        const discountPercent = onSale ? Math.round((1 - p.price / listPrice) * 100) : null;

        let subInfo = '';
        if (check.status === 'used' && check.tier) {
          subInfo += `<span class="mp-tag">${TIER_LABELS[check.tier]}</span>`;
        }
        if (check.rating) {
          subInfo += `<span class="mp-tag">★${check.rating}</span>`;
        }
        if (check.is_public) {
          subInfo += `<span class="mp-tag mp-public">公開中</span>`;
        }
        if (isTop3) {
          subInfo += `<span class="mp-tag mp-best">TOP3: ${top3Idx + 1}位</span>`;
        }
        if (isBestReview) {
          subInfo += `<span class="mp-tag mp-best">ベスト口コミ</span>`;
        }

        let actions = '';
        if (check.status === 'used') {
          if (isTop3) {
            actions += `<button class="top3-set-btn" data-product-id="${p.id}">TOP3(${top3Idx + 1}位)を解除</button>`;
          } else if (top3Full) {
            actions += `<button class="top3-set-btn" data-product-id="${p.id}" disabled>TOP3は3つまでです</button>`;
          } else {
            actions += `<button class="top3-set-btn" data-product-id="${p.id}">TOP3に追加</button>`;
          }
        }
        if (hasReview) {
          actions += `<button class="best-review-set-btn" data-product-id="${p.id}">${isBestReview ? 'ベスト口コミを解除' : 'ベスト口コミに設定'}</button>`;
        }

        return { p, isTop3, onSale, discountPercent, subInfo, actions };
      }

      function productCardHtml(check) {
