      async function loadMakerOptions() {
        if (makerOptionsCache) return makerOptionsCache;

        // Supabase/PostgRESTの1回あたりの取得上限に引っかからないよう、
        // 全件取得できるまでページ分割して取得する
        const set = new Set();
        const pageSize = 1000;
        let from = 0;
        while (true) {
          const { data, error } = await supabase
            .from('products')
            .select('maker')
            .not('maker', 'is', null)
            .range(from, from + pageSize - 1);

          if (error) {
            console.error(error);
            break;
          }
          for (const r of data ?? []) {
            if (r.maker) set.add(r.maker);
          }
          if (!data || data.length < pageSize) break;
          from += pageSize;
        }

        makerOptionsCache = [...set].sort((a, b) => a.localeCompare(b, 'ja'));
        return makerOptionsCache;
      }

