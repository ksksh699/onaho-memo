      function renderProductLists() {
        const grouped = { used: [], interested: [] };
        for (const c of lastChecks) {
          if (grouped[c.status]) grouped[c.status].push(c);
        }

        const usedByTier = { first: [], second: [], retired: [] };
        for (const c of grouped.used) {
          if (c.tier && usedByTier[c.tier]) usedByTier[c.tier].push(c);
        }

        const totalSpent = grouped.used.reduce((sum, c) => sum + (c.products?.price ?? 0), 0);

        statsContainer.innerHTML = `
          <div class="mp-stats">
            <div class="mp-stat-card mp-stat-jump" data-stat-jump="used" role="button" tabindex="0"><span class="mp-stat-num">${grouped.used.length}</span><span class="mp-stat-label">使った本数</span></div>
            <div class="mp-stat-card mp-stat-jump" data-stat-jump="interested" role="button" tabindex="0"><span class="mp-stat-num">${grouped.interested.length}</span><span class="mp-stat-label">気になる</span></div>
            <div class="mp-stat-card mp-stat-jump" data-stat-jump="first" role="button" tabindex="0"><span class="mp-stat-num">${usedByTier.first.length}</span><span class="mp-stat-label">一軍</span></div>
            <div class="mp-stat-card mp-stat-jump" data-stat-jump="second" role="button" tabindex="0"><span class="mp-stat-num">${usedByTier.second.length}</span><span class="mp-stat-label">二軍</span></div>
            <div class="mp-stat-card mp-stat-card-wide mp-spend-card" id="mp-spend-card" role="button" tabindex="0" aria-expanded="false">
              <span class="mp-stat-num">¥${totalSpent.toLocaleString()}</span>
              <span class="mp-stat-label">合計使用金額(タップで換算)</span>
            </div>
          </div>
          <div class="mp-spend-compare" id="mp-spend-compare" hidden></div>
        `;

        function jumpToStat(kind) {
          applyMainTab('all');
          if (kind === 'interested') {
            currentStatusTab = 'interested';
            currentUsedTier = 'all';
          } else if (kind === 'used') {
            currentStatusTab = 'used';
            currentUsedTier = 'all';
          } else if (kind === 'first' || kind === 'second') {
            currentStatusTab = 'used';
            currentUsedTier = kind;
          }
          try {
            localStorage.setItem('onahole_status_tab', currentStatusTab);
          } catch (e) {}
          renderProductLists();
          content.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        statsContainer.querySelectorAll('.mp-stat-jump').forEach((card) => {
          card.addEventListener('click', () => jumpToStat(card.dataset.statJump));
          card.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' || e.key === ' ') {
              e.preventDefault();
              jumpToStat(card.dataset.statJump);
            }
          });
        });

        const spendCard = document.getElementById('mp-spend-card');
        const spendCompare = document.getElementById('mp-spend-compare');
        if (spendCard && spendCompare) {
          const toggleSpendCompare = () => {
            const expanded = spendCard.getAttribute('aria-expanded') === 'true';
            if (expanded) {
              spendCard.setAttribute('aria-expanded', 'false');
              spendCompare.hidden = true;
              return;
            }
            spendCompare.innerHTML = moneyComparisonHtml(totalSpent);
            spendCompare.hidden = false;
            spendCard.setAttribute('aria-expanded', 'true');
          };
          spendCard.addEventListener('click', toggleSpendCompare);
          spendCard.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' || e.key === ' ') {
              e.preventDefault();
              toggleSpendCompare();
            }
          });
        }

        if (!STATUS_LABELS[currentStatusTab]) currentStatusTab = 'used';

        const isFoldersTab = currentStatusTab === 'folders';
        const isUsedTab = currentStatusTab === 'used';

        const tabsHtml = `
          <div class="mp-tabs-row">
            <div class="ranking-tabs mp-status-tabs">
              ${STATUS_TAB_ORDER.map(
                (status) => `
                <button type="button" class="ranking-tab mp-status-tab ${currentStatusTab === status ? 'ranking-tab-active' : ''}" data-status="${status}">${STATUS_LABELS[status]}${status === 'folders' ? '' : `(${grouped[status].length})`}</button>
              `
              ).join('')}
            </div>
            ${
              isFoldersTab
                ? ''
                : `<div class="mp-view-toggle">
              <button type="button" class="mp-view-btn ${currentViewMode === 'grid' ? 'active' : ''}" data-view="grid" title="グリッド表示" aria-label="グリッド表示">▦</button>
              <button type="button" class="mp-view-btn ${currentViewMode === 'list' ? 'active' : ''}" data-view="list" title="リスト表示" aria-label="リスト表示">☰</button>
            </div>`
            }
          </div>
          ${
            isUsedTab
              ? `<div class="mp-tier-tabs">
              <button type="button" class="mp-tier-tab ${currentUsedTier === 'all' ? 'mp-tier-tab-active' : ''}" data-tier="all">すべて(${grouped.used.length})</button>
              <button type="button" class="mp-tier-tab ${currentUsedTier === 'first' ? 'mp-tier-tab-active' : ''}" data-tier="first">一軍(${usedByTier.first.length})</button>
              <button type="button" class="mp-tier-tab ${currentUsedTier === 'second' ? 'mp-tier-tab-active' : ''}" data-tier="second">二軍(${usedByTier.second.length})</button>
              <button type="button" class="mp-tier-tab ${currentUsedTier === 'retired' ? 'mp-tier-tab-active' : ''}" data-tier="retired">引退(${usedByTier.retired.length})</button>
            </div>`
              : ''
          }
        `;

        if (isFoldersTab) {
          content.innerHTML = tabsHtml;
          foldersContainer.style.display = '';
          return;
        }
        foldersContainer.style.display = 'none';

        const renderItem = currentViewMode === 'list' ? productRowHtml : productCardHtml;
        const listTag = currentViewMode === 'list' ? 'mp-list' : 'mp-grid';
        const activeList =
          isUsedTab && currentUsedTier !== 'all' ? usedByTier[currentUsedTier] ?? [] : grouped[currentStatusTab] ?? [];

        const emptyLabel = isUsedTab && currentUsedTier !== 'all' ? TIER_LABELS[currentUsedTier] : STATUS_LABELS[currentStatusTab];
        const listHtml = activeList.length
          ? `<ul class="${listTag}">${activeList.map(renderItem).join('')}</ul>`
          : `<p class="mp-empty-tab">まだ${emptyLabel}の商品がありません。</p>`;

        content.innerHTML = tabsHtml + listHtml;
      }

      async function init() {
        const { data: { session } } = await supabase.auth.getSession();

        if (!session) {
          renderLoggedOut();
          return;
        }

        const profile = await fetchProfile(session.user.id);
        const hasNickname = Boolean(profile?.nickname);

        currentTop3 = [
          profile?.best_product_id_1
            ? { productId: profile.best_product_id_1, reason: profile.best_product_reason_1 }
            : null,
          profile?.best_product_id_2
            ? { productId: profile.best_product_id_2, reason: profile.best_product_reason_2 }
            : null,
          profile?.best_product_id_3
            ? { productId: profile.best_product_id_3, reason: profile.best_product_reason_3 }
            : null,
        ];
        currentBestReviewProductId = profile?.best_review_product_id ?? null;
        currentOshiMaker = profile?.oshi_maker ?? null;
        currentOshiMakerReason = profile?.oshi_maker_reason ?? null;
        currentNickname = profile?.nickname ?? null;
        currentAvatarUrl = profile?.avatar_url ?? null;
        currentHeaderUrl = profile?.header_url ?? null;
        currentBio = profile?.bio ?? null;
        currentSnsLinks = Array.isArray(profile?.sns_links) ? profile.sns_links : [];
        currentIsPublic = profile?.is_public ?? true;
        profileDetailsEditing = false;

        if (hasNickname) {
          const { count: followingCount } = await supabase
            .from('follows')
            .select('*', { count: 'exact', head: true })
            .eq('follower_id', session.user.id);
          currentFollowingCount = followingCount ?? 0;
          renderProfileHeaderSection();
        } else {
          showNicknameForm(session.user.id, '');
        }

        const { data: checks, error } = await supabase
          .from('checks')
          .select(
            'status, tier, rating, review_title, review_text, detail_review_title, detail_review_text, review_images, retirement_reason, similar_products, memo, is_public, updated_at, products(id, dmm_content_id, name, maker, price, image_url, genre_tags, raw_data)'
          )
          .eq('user_id', session.user.id)
          .order('updated_at', { ascending: false });

        if (error) {
          content.innerHTML = `<p>読み込みに失敗しました: ${error.message}</p>`;
          return;
        }

        lastChecks = checks ?? [];

        top3EditingRank = null;
        renderTop3Section();

        const bestReviewCheck = lastChecks.find((c) => c.products?.id === currentBestReviewProductId) ?? null;
        bestReviewContainer.innerHTML = bestReviewSectionHtml(bestReviewCheck);
        reviewsListContainer.innerHTML = reviewsListSectionHtml(lastChecks);

        oshiMakerEditing = false;
        renderOshiMakerSection();

        await renderFoldersSection(session.user.id);
        await renderOnakingLinksSection();
        await renderManualProductSection();

        const usedCountForBadge = lastChecks.filter((c) => c.status === 'used').length;
        const badgeResult = badgeSectionHtml(usedCountForBadge, lastChecks);
        const titlesCtx = {
          hasNickname,
          avatarUrl: currentAvatarUrl,
          headerUrl: currentHeaderUrl,
          bio: currentBio,
          snsLinks: currentSnsLinks,
          isPublicProfile: currentIsPublic,
          top3: currentTop3,
          oshiMaker: currentOshiMaker,
          oshiMakerReason: currentOshiMakerReason,
          bestReviewProductId: currentBestReviewProductId,
          folders: currentFolders,
        };
        const titlesResult = titlesSectionHtml(lastChecks, titlesCtx);
        document.getElementById('badge-section-container').innerHTML = badgeResult.html;
        document.getElementById('titles-section-container').innerHTML = titlesResult.html;
        document.getElementById('rank-hero-container').innerHTML = rankHeroHtml(
          badgeResult.badgeCount + titlesResult.earnedCount,
          badgeResult.badgeCount,
          titlesResult.earnedCount
        );

        if (lastChecks.length === 0) {
          statsContainer.innerHTML = '';
          content.innerHTML = `<p class="mp-empty">まだ記録がありません。気になる商品を見つけたら「☰ 記録」から登録してみましょう。</p>`;
          return;
        }

        renderProductLists();
      }

      content.addEventListener('click', (e) => {
        const top3Btn = e.target.closest('.top3-set-btn');
        if (top3Btn && !top3Btn.disabled) {
          e.preventDefault();
          toggleTop3(top3Btn.dataset.productId);
          return;
        }

        const reviewBtn = e.target.closest('.best-review-set-btn');
        if (reviewBtn) {
          e.preventDefault();
          toggleBestReview(reviewBtn.dataset.productId);
          return;
        }

        const viewBtn = e.target.closest('.mp-view-btn');
        if (viewBtn) {
          currentViewMode = viewBtn.dataset.view;
          try {
            localStorage.setItem('onahole_view_mode', currentViewMode);
          } catch (err) {}
          renderProductLists();
          return;
        }

        const statusTabBtn = e.target.closest('.mp-status-tab');
        if (statusTabBtn) {
          currentStatusTab = statusTabBtn.dataset.status;
          currentUsedTier = 'all';
          try {
            localStorage.setItem('onahole_status_tab', currentStatusTab);
          } catch (err) {}
          renderProductLists();
          return;
        }

        const tierTabBtn = e.target.closest('.mp-tier-tab');
        if (tierTabBtn) {
          currentUsedTier = tierTabBtn.dataset.tier;
          renderProductLists();
        }
      });

      top3Container.addEventListener('click', async (e) => {
        const reasonTextEl = e.target.closest('.top3-reason-text');
        if (reasonTextEl) {
          top3EditingRank = Number(reasonTextEl.dataset.rank);
          renderTop3Section();
          return;
        }

        const saveBtn = e.target.closest('.top3-reason-save-btn');
        if (saveBtn) {
          const rank = Number(saveBtn.dataset.rank);
          const input = top3Container.querySelector(`.top3-reason-input[data-rank="${rank}"]`);
          const value = input ? input.value.trim() : '';
          if (currentTop3[rank - 1]) currentTop3[rank - 1].reason = value || null;
          top3EditingRank = null;
          await saveTop3();
          init();
          return;
        }

        const clearBtn = e.target.closest('.top3-clear-btn');
        if (clearBtn) {
          const rank = Number(clearBtn.dataset.rank);
          currentTop3[rank - 1] = null;
          await saveTop3();
          init();
        }
      });

      bestReviewContainer.addEventListener('click', (e) => {
        const btn = e.target.closest('#clear-best-review-btn');
        if (!btn) return;
        e.preventDefault();
        toggleBestReview(currentBestReviewProductId);
      });

      oshiMakerContainer.addEventListener('click', async (e) => {
        if (e.target.closest('#edit-oshi-maker-btn')) {
          oshiMakerEditing = true;
          await renderOshiMakerSection();
          return;
        }
        if (e.target.closest('#cancel-oshi-maker-btn')) {
          oshiMakerEditing = false;
          renderOshiMakerSection();
          return;
        }
        if (e.target.closest('#save-oshi-maker-btn')) {
          const maker = document.getElementById('oshi-maker-input').value.trim();
          const reason = document.getElementById('oshi-maker-reason-input').value.trim();
          await saveOshiMaker(maker, reason);
        }
      });

      profileDetailsContainer.addEventListener('click', async (e) => {
        if (e.target.closest('#edit-profile-details-btn')) {
          profileDetailsEditing = true;
          renderProfileHeaderSection();
          return;
        }
        if (e.target.closest('#toggle-profile-public-btn')) {
          await toggleProfilePublic();
          return;
        }
        if (e.target.closest('#cancel-profile-details-btn')) {
          profileDetailsEditing = false;
          renderProfileHeaderSection();
          return;
        }
        if (e.target.closest('#profile-sns-add-btn')) {
          const rows = [...document.querySelectorAll('#profile-sns-list .profile-sns-row')];
          editingSnsLinks = rows.map((row) => ({
            label: row.querySelector('.profile-sns-label').value,
            url: row.querySelector('.profile-sns-url').value,
          }));
          editingSnsLinks.push({ label: '', url: '' });
          document.getElementById('profile-sns-list').innerHTML = editingSnsLinks
            .map((l, i) => snsRowHtml(l, i))
            .join('');
          return;
        }
        const removeBtn = e.target.closest('.profile-sns-remove-btn');
        if (removeBtn) {
          const rows = [...document.querySelectorAll('#profile-sns-list .profile-sns-row')];
          editingSnsLinks = rows
            .map((row) => ({
              label: row.querySelector('.profile-sns-label').value,
              url: row.querySelector('.profile-sns-url').value,
            }))
            .filter((_, i) => i !== Number(removeBtn.dataset.idx));
          if (editingSnsLinks.length === 0) editingSnsLinks.push({ label: '', url: '' });
          document.getElementById('profile-sns-list').innerHTML = editingSnsLinks
            .map((l, i) => snsRowHtml(l, i))
            .join('');
          return;
        }
        if (e.target.closest('#save-profile-details-btn')) {
          await saveProfileDetails();
        }
      });

      init();
    </script>
    <SiteFooter />
  </body>
</html>
